{
  "name": "opencode-mobile-web-host",
  "description": "Static web build host for the OpenCode mobile WebView shell (vendor closure of upstream packages/app).",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "vendor:sync": "bash scripts/vendor-sync.sh",
    "verify:closure": "bash scripts/verify-closure.sh",
    "verify:patches": "python3 scripts/mobile-patches.py",
    "patches:refresh": "python3 scripts/mobile-patches.py --refresh",
    "build:web": "bun run --cwd vendor/upstream/packages/app build",
    "copy:web-dist": "bash scripts/copy-web-dist.sh"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "vendor/upstream/packages/*"
    ],
    "catalog": {
      "@effect/opentelemetry": "4.0.1",
      "@effect/platform-node": "4.0.1",
      "@effect/platform-node-shared": "4.0.1",
      "@effect/sql-sqlite-bun": "4.0.1",
      "@npmcli/arborist": "9.4.0",
      "@types/bun": "1.4.3",
      "@types/cross-spawn": "6.0.6",
      "@octokit/rest": "22.0.0",
      "@hono/standard-validator": "0.2.0",
      "@hono/zod-validator": "0.4.2",
      "@opentui/core": "0.6.8",
      "@opentui/keymap": "0.6.8",
      "@opentui/solid": "0.6.8",
      "@tanstack/solid-virtual": "3.13.37",
      "@standard-schema/spec": "1.1.0",
      "ulid": "3.0.1",
      "@kobalte/core": "0.13.13",
      "@corvu/drawer": "0.2.4",
      "@types/luxon": "3.7.1",
      "@types/node": "24.12.2",
      "@types/semver": "7.7.1",
      "@tsconfig/node22": "22.0.2",
      "@tsconfig/bun": "1.0.9",
      "@cloudflare/workers-types": "4.20251008.0",
      "@pierre/diffs": "1.6.1",
      "@pierre/highlights": "0.2.0",
      "@solid-primitives/event-listener": "2.4.6",
      "@solid-primitives/media": "2.3.6",
      "@solid-primitives/resize-observer": "2.2.0",
      "@solid-primitives/storage": "4.4.0",
      "@tailwindcss/vite": "4.1.11",
      "diff": "8.0.4",
      "dompurify": "3.4.14",
      "drizzle-kit": "1.0.0-rc.5-ab785fc",
      "drizzle-orm": "1.0.0-rc.5-169397b",
      "effect": "4.0.1",
      "fast-check": "4.9.0",
      "ai": "6.0.168",
      "cross-spawn": "7.0.6",
      "hono": "4.10.7",
      "hono-openapi": "1.1.2",
      "fuzzysort": "3.1.0",
      "get-east-asian-width": "1.6.0",
      "luxon": "3.6.1",
      "marked": "18.0.11",
      "marked-shiki": "1.2.1",
      "remend": "1.3.1",
      "@playwright/test": "1.60.0",
      "semver": "7.7.4",
      "typescript": "npm:@typescript/typescript6@6.0.2",
      "@typescript/native": "npm:typescript@7.1.0-beta",
      "zod": "4.1.8",
      "remeda": "2.26.0",
      "sst": "4.13.1",
      "shiki": "4.4.3",
