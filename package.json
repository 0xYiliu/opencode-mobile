  "overrides": {
    "@opentui/core": "catalog:",
    "@opentui/keymap": "catalog:",
    "@opentui/solid": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "bun-types": "1.4.4",
    "effect": "catalog:",
    "open": "11.0.4",
    "solid-js": "catalog:"
