diff --git a/packages/session-ui/src/message/relative-time.test.ts b/packages/session-ui/src/message/relative-time.test.ts
new file mode 100644
index 0000000..856eef3
--- /dev/null
+++ b/packages/session-ui/src/message/relative-time.test.ts
@@ -0,0 +1,18 @@
+import { expect, test } from "bun:test"
+import { relativeTime } from "./relative-time"
+
+const created = 1_735_689_600_000
+
+const minute = 60_000
+
+test("rounds down to the largest whole unit under a week", () => {
+  expect(relativeTime(created, created + 59_999)).toEqual({ unit: "now" })
+  expect(relativeTime(created, created + 2 * minute + 59_999)).toEqual({ unit: "minute", count: 2 })
+  expect(relativeTime(created, created + 90 * minute)).toEqual({ unit: "hour", count: 1 })
+  expect(relativeTime(created, created + 3 * 24 * 60 * minute)).toEqual({ unit: "day", count: 3 })
+})
+
+test("falls back to the date after a week and treats clock skew as now", () => {
+  expect(relativeTime(created, created + 7 * 24 * 60 * minute)).toEqual({ unit: "date" })
+  expect(relativeTime(created, created - minute)).toEqual({ unit: "now" })
+})
diff --git a/packages/session-ui/src/message/relative-time.ts b/packages/session-ui/src/message/relative-time.ts
new file mode 100644
index 0000000..c72f2ab
--- /dev/null
+++ b/packages/session-ui/src/message/relative-time.ts
@@ -0,0 +1,45 @@
+import { createSignal, onCleanup } from "solid-js"
+
+const MINUTE = 60_000
+
+const HOUR = 60 * MINUTE
+
+const DAY = 24 * HOUR
+
+export function relativeTime(created: number, now: number) {
+  const elapsed = Math.max(0, now - created)
+
+  if (elapsed < MINUTE) return { unit: "now" } as const
+
+  if (elapsed < HOUR) return { unit: "minute", count: Math.floor(elapsed / MINUTE) } as const
+
+  if (elapsed < DAY) return { unit: "hour", count: Math.floor(elapsed / HOUR) } as const
+
+  if (elapsed < 7 * DAY) return { unit: "day", count: Math.floor(elapsed / DAY) } as const
+
+  return { unit: "date" } as const
+}
+
+const [now, setNow] = createSignal(Date.now())
+
+let subscribers = 0
+
+let timer: ReturnType<typeof setInterval> | undefined
+
+// One shared clock for every relative timestamp on screen; it only ticks while one is mounted.
+export function useNow() {
+  subscribers++
+
+  if (subscribers === 1) {
+    setNow(Date.now())
+    timer = setInterval(() => setNow(Date.now()), 30_000)
+  }
+
+  onCleanup(() => {
+    subscribers--
+
+    if (subscribers === 0) clearInterval(timer)
+  })
+
+  return now
+}
