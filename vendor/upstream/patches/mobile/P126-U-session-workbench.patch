+    type: "assistant",
+    agent: "build",
+    model: { id: "model", providerID: "provider" },
+    metadata: { parentID },
+    content: [{ type: "text", text: "answer" }],
+    time: { created, completed: created + 1 },
+  }) satisfies SessionMessageInfo
+
+const sent: UserRunMember = {
+  kind: "sent",
+  agent: "build",
+  model: { id: "model", providerID: "provider" },
+  text: true,
+  attachments: false,
+}
+
+function runs(
+  messages: SessionMessageInfo[],
+  members: Record<string, Partial<UserRunMember>> = {},
+  preset?: (typeof timelinePresets)[number]["id"],
+) {
+  const pending = new Set(Object.keys(members).filter((id) => members[id]?.kind === "pending"))
+  const detail = timelinePresets.find((item) => item.id === preset)?.value
+
+  const rows = Timeline.constructSessionMessageRows(
+    messages,
+    true,
+    { type: "busy" },
+    pending,
+    false,
+    false,
+    undefined,
+    detail,
+  ).rows
+
+  return Object.fromEntries(userMessageRuns(rows, messages, (id) => ({ ...sent, ...members[id] })))
+}
+
+const alone = { above: false, below: false }
+
+describe("userMessageRuns", () => {
+  test("joins consecutive sent messages into one run", () => {
+    expect(runs([user("msg_1", 1), user("msg_2", 2), user("msg_3", 3)])).toEqual({
+      msg_1: { above: false, below: true },
+      msg_2: { above: true, below: true },
+      msg_3: { above: true, below: false },
+    })
+  })
+
+  test("assistant output between two messages ends the run", () => {
+    expect(runs([user("msg_1", 1), assistant("msg_2", "msg_1", 2), user("msg_3", 3), user("msg_4", 4)])).toEqual({
+      msg_1: alone,
+      msg_3: { above: false, below: true },
+      msg_4: { above: true, below: false },
+    })
+  })
+
+  test("waiting steers group together but never with a sent message", () => {
+    expect(
+      runs([user("msg_1", 1), user("msg_2", 2), user("msg_3", 3), user("msg_4", 4)], {
+        msg_3: { kind: "pending" },
+        msg_4: { kind: "pending" },
+      }),
+    ).toEqual({
+      msg_1: { above: false, below: true },
+      msg_2: { above: true, below: false },
+      msg_3: { above: false, below: true },
+      msg_4: { above: true, below: false },
+    })
+  })
+
+  test("a run of steers stays one run as it delivers", () => {
+    const steers = [user("msg_1", 1), assistant("msg_2", "msg_1", 2), user("msg_3", 3), user("msg_4", 4)]
+
+    const delivered = { msg_1: alone, msg_3: { above: false, below: true }, msg_4: { above: true, below: false } }
+
+    expect(runs(steers, { msg_3: { kind: "pending" }, msg_4: { kind: "pending" } })).toEqual(delivered)
+    expect(runs(steers)).toEqual(delivered)
+  })
+
+  test("a steer delivered ahead of the rest leaves the run", () => {
+    expect(
+      runs([user("msg_1", 1), assistant("msg_2", "msg_1", 2), user("msg_3", 3), user("msg_4", 4), user("msg_5", 5)], {
+        msg_4: { kind: "pending" },
+        msg_5: { kind: "pending" },
+      }),
+    ).toEqual({
+      msg_1: alone,
+      msg_3: alone,
+      msg_4: { above: false, below: true },
+      msg_5: { above: true, below: false },
+    })
+  })
+
+  test("a different agent or model ends the run, since the run names one", () => {
+    expect(
+      runs([user("msg_1", 1), user("msg_2", 2), user("msg_3", 3)], {
+        msg_2: { agent: "plan" },
+        msg_3: { agent: "plan", model: { id: "model", providerID: "provider", variant: "high" } },
+      }),
+    ).toEqual({ msg_1: alone, msg_2: alone, msg_3: alone })
+  })
+
+  test("a switch or compaction ends the run even when the timeline hides its notice", () => {
+    const messages = [
+      user("msg_1", 1),
+      { id: "msg_2", type: "model-switched", model: { id: "model", providerID: "provider" }, time: { created: 2 } },
+      user("msg_3", 3),
+    ] satisfies SessionMessageInfo[]
+
+    expect(runs(messages, {}, "quiet")).toEqual({ msg_1: alone, msg_3: alone })
+  })
+
+  test("only text bubbles join; attachments keep their own gap and the text above keeps its meta line", () => {
+    expect(
+      runs([user("msg_1", 1), user("msg_2", 2), user("msg_3", 3), user("msg_4", 4)], {
+        msg_2: { text: false, attachments: true },
+        msg_4: { attachments: true },
+      }),
+    ).toEqual({ msg_1: alone, msg_2: alone, msg_3: alone, msg_4: alone })
+  })
+
+  test("a lone message stands alone", () => {
+    expect(runs([user("msg_1", 1), assistant("msg_2", "msg_1", 2)])).toEqual({ msg_1: alone })
+  })
+})
diff --git a/packages/session-ui/src/timeline/user-runs.ts b/packages/session-ui/src/timeline/user-runs.ts
new file mode 100644
index 0000000..a7608ba
--- /dev/null
+++ b/packages/session-ui/src/timeline/user-runs.ts
@@ -0,0 +1,87 @@
+import type { SessionMessageAssistant, SessionMessageInfo } from "@opencode/client/promise"
+import { Predicate } from "effect"
+import type { TimelineRow } from "./timeline-row"
+
+/** A user message's place in a run of consecutive user messages: joined to the one above, below, or both. */
+export type UserRun = { above: boolean; below: boolean }
+
+/** What a user message brings to a run: its delivery, the agent and model its meta line names, and its surfaces. */
+export type UserRunMember = {
+  kind: "sent" | "pending"
+  agent: string
+  model: SessionMessageAssistant["model"]
+  /** It has a text bubble, the surface that carries a run's meta line. */
+  text: boolean
+  /** Attachments sit above its bubble. */
+  attachments: boolean
+}
+
+/** Layout moves in a run settle on Kit's calm spring: .4 s, bounce 0. */
+export const userRunSpring = { omega: (2 * Math.PI) / 0.4, zeta: 1 }
+
+/**
+ * Like the iOS app's grouped corners, consecutive user messages with nothing but turn gaps between them read as
+ * one block under a single meta line. Text bubbles with the same agent and model join, and steers waiting for
+ * delivery group the same way, but never with a sent message. An agent, model, location or compaction boundary
+ * between them ends the run even when the timeline hides its notice.
+ */
+export function userMessageRuns(
+  rows: readonly TimelineRow.TimelineRow[],
+  messages: readonly SessionMessageInfo[],
+  member: (messageID: string) => UserRunMember | undefined,
+) {
+  const segments = boundarySegments(messages)
+  const members = rows.filter((row) => !Predicate.isTagged(row, "TurnGap"))
+
+  const joins = (above: TimelineRow.TimelineRow | undefined, below: TimelineRow.TimelineRow | undefined) => {
+    if (!Predicate.isTagged(above, "UserMessage") || !Predicate.isTagged(below, "UserMessage")) return false
+    const upper = member(above.userMessageID)
+    const lower = member(below.userMessageID)
+
+    return (
+      !!upper &&
+      !!lower &&
+      upper.kind === lower.kind &&
+      upper.text &&
+      lower.text &&
+      !lower.attachments &&
+      upper.agent === lower.agent &&
+      upper.model.providerID === lower.model.providerID &&
+      upper.model.id === lower.model.id &&
+      upper.model.variant === lower.model.variant &&
+      segments.get(above.userMessageID) === segments.get(below.userMessageID)
+    )
+  }
+
+  return new Map(
+    members.flatMap((row, index) =>
+      Predicate.isTagged(row, "UserMessage")
+        ? [
+            [
+              row.userMessageID,
+              { above: joins(members[index - 1], row), below: joins(row, members[index + 1]) } satisfies UserRun,
+            ] as const,
+          ]
+        : [],
+    ),
+  )
+}
+
+/** Each user message's count of agent, model, location and compaction boundaries before it. */
+function boundarySegments(messages: readonly SessionMessageInfo[]) {
+  const segments = new Map<string, number>()
+  let segment = 0
+  messages.forEach((message) => {
+    if (
+      message.type === "agent-switched" ||
+      message.type === "model-switched" ||
+      message.type === "location-switched" ||
+      message.type === "compaction"
+    )
+      segment += 1
+
+    if (message.type === "user") segments.set(message.id, segment)
+  })
+
+  return segments
+}
