+    const active = document.activeElement
+
+    if (event.key === "Escape" && state.text !== undefined) return dismiss()
+    const action = element?.querySelector<HTMLButtonElement>("button:not(:disabled)")
+
+    if (
+      event.key === "Tab" &&
+      !event.shiftKey &&
+      !event.metaKey &&
+      !event.ctrlKey &&
+      !event.altKey &&
+      action &&
