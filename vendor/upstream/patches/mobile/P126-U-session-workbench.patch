diff --git a/packages/app/src/home/sessions/queries.ts b/packages/app/src/home/sessions/queries.ts
new file mode 100644
index 0000000..c7247c2
--- /dev/null
+++ b/packages/app/src/home/sessions/queries.ts
@@ -0,0 +1,24 @@
+import type { SessionInfo } from "@opencode/client/promise"
+import { queryOptions, skipToken } from "@tanstack/solid-query"
+import type { ServerConnection } from "@/runtime/server/registry"
+import type { ServerCtx } from "@/runtime/server/runtime"
+import { loadHomeSessionIndex } from "./index"
+
+// Keep the immutable result opaque so Solid Query does not recursively unwrap every session on mount.
+const selectSessions = (sessions: SessionInfo[]) => () => sessions
+
+export function homeSessionsQuery(conn: ServerConnection.Any | undefined, ctx: ServerCtx | undefined) {
+  return queryOptions({
+    queryKey: ["home-sessions", conn] as const,
+    queryFn: ctx
+      ? ({ signal }) => loadHomeSessionIndex((input, options) => ctx.sdk.api.session.list(input, options), signal)
+      : skipToken,
+    retry: false,
+    staleTime: 30_000,
+    // Returning to Home shows the last list and refreshes it, instead of loading again once the cache expires.
+    gcTime: Infinity,
+    refetchOnMount: true,
+    refetchOnReconnect: true,
+    select: selectSessions,
+  })
+}
diff --git a/packages/app/src/home/start/command-palette.tsx b/packages/app/src/home/start/command-palette.tsx
new file mode 100644
index 0000000..0b81687
--- /dev/null
+++ b/packages/app/src/home/start/command-palette.tsx
@@ -0,0 +1,97 @@
+import { useDialog } from "@opencode/ui/context/dialog"
+import { createMemo, onCleanup } from "solid-js"
+import { commandPaletteOptions, useCommand } from "@/shell/commands/command"
+import { useGlobal } from "@/runtime/server/runtime"
+import { useLanguage } from "@/runtime/i18n/language"
+import { ServerConnection } from "@/runtime/server/registry"
+import {
+  createCommandPaletteCommandEntry,
+  createKnownServerSessions,
+  createServerSessionEntries,
+  type CommandPaletteEntry,
+  type PaletteHighlight,
+} from "@/shell/commands/palette"
+import { CommandPaletteView, matchesCommandPaletteEntry } from "@/shell/commands/dialog"
+import { createSettingsPaletteEntries } from "@/settings/palette"
+
+export function HomeCommandPalette(props: {
+  server: ServerConnection.Any
+  onSelectSession: (entry: CommandPaletteEntry) => void
+}) {
+  const command = useCommand()
+  const dialog = useDialog()
+  const global = useGlobal()
+  const language = useLanguage()
+  const server = global.ensureServerCtx(props.server)
+  const state: PaletteHighlight = { cleanup: undefined, committed: false }
+  const settings = createSettingsPaletteEntries()
+
+  const commandEntries = createMemo(() => {
+    const category = language.t("palette.group.commands")
+
+    return commandPaletteOptions(command.options).map((option) => createCommandPaletteCommandEntry(option, category))
+  })
+
+  const sessions = createServerSessionEntries({
+    server: ServerConnection.key(props.server),
+    known: createKnownServerSessions(server),
+    projects: server.projects.list,
+    load: (search, signal) =>
+      server.sdk.api.session.list({ parentID: null, search, archived: false, limit: 50 }, { signal }),
+    get: (sessionID, signal) => server.sdk.api.session.get({ sessionID }, { signal }),
+    untitled: () => language.t("command.session.new"),
+    category: () => language.t("command.category.session"),
+    recentCategory: () => language.t("palette.group.recentSessions"),
+  })
+
+  const highlight = (item: CommandPaletteEntry | undefined) => {
+    state.cleanup?.()
+    state.cleanup = undefined
+
+    if (item?.type !== "command") return
+    state.cleanup = item.option?.onHighlight?.()
+  }
+
+  const select = (item: CommandPaletteEntry | undefined) => {
+    if (!item) return
+    state.committed = true
+    state.cleanup = undefined
+    dialog.close()
+
+    if (item.type === "command") {
+      void item.option?.onSelect?.("palette")
+
+      return
+    }
+
+    if (item.type === "session") props.onSelectSession(item)
+
+    if (item.type === "setting") settings.select(item)
+  }
+
+  const items = (query: string) => {
+    if (!query) return [...commandEntries().slice(0, 5), ...sessions.items("")]
+
+    return [
+      ...commandEntries().filter((entry) => matchesCommandPaletteEntry(entry, query)),
+      ...sessions.items(query),
+      ...settings.items(query),
+    ]
+  }
+
+  onCleanup(() => {
+    if (state.committed) return
+    state.cleanup?.()
+  })
+
+  return (
+    <CommandPaletteView
+      placeholder={language.t("palette.search.placeholder.home")}
+      items={items}
+      sources={[sessions.search]}
+      highlight={highlight}
+      select={select}
+      close={() => dialog.close()}
+    />
+  )
+}
