+})
+
+test("publishes each plugin command id once, from its newest owner", () => {
+  const items = pluginCommandItems([
+    command("details", "toggle", "first timeline"),
+    command("acme", "toggle", "acme"),
+    command("details", "toggle", "second timeline"),
