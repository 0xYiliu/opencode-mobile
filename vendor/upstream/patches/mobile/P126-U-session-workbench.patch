new file mode 100644
index 0000000..25724c1
--- /dev/null
+++ b/packages/app/src/session/header/drag-area.tsx
@@ -0,0 +1,79 @@
+import { createEffect, createSignal, onCleanup, Show } from "solid-js"
+import type { Platform } from "@/runtime/platform/platform"
+
+// Narrower gaps leave nothing worth grabbing between the title and the actions.
+const minWidth = 24
+
+/** Whether this window hides its native titlebar and moves from app-drawn drag regions. */
+export function windowDragEnabled(platform: Platform) {
+  return platform.platform === "desktop" && (platform.os === "macos" || platform.os === "windows")
+}
+
+/** Fills the session header between the title and the actions; the active timeline hands it to the pane's drag area. */
+export function SessionHeaderGap(props: { active: boolean; register?: (gap: HTMLElement) => () => void }) {
+  let gap!: HTMLDivElement
+
+  createEffect(() => {
+    if (props.active && props.register) onCleanup(props.register(gap))
+  })
+
+  return <div ref={gap} data-slot="session-header-gap" aria-hidden="true" class="flex-1 self-stretch" />
+}
+
+/**
+ * Moves the window from the session header's empty gap, as the hidden titlebar's row would. The area is pinned to the
+ * pane over the gap rather than placed in the header: the header sticks inside the timeline's scroller, and Chromium
+ * only recomputes drag regions on layout, so a region inside it would stay behind on scroll.
+ */
+export function SessionHeaderDrag(props: { pane?: HTMLElement; gap?: HTMLElement }) {
+  const [rect, setRect] = createSignal<{ x: number; y: number; width: number; height: number }>()
+
+  // Rename, truncation, readout updates and pane resizes all resize the gap; nothing here runs while the timeline scrolls.
+  createEffect(() => {
+    const pane = props.pane
+    const gap = props.gap
+    setRect(undefined)
+
+    const row = gap?.closest<HTMLElement>(".session-header-layout")
+
+    if (!pane || !gap || !row) return
+
+    // The gap spans the row's width between the title and the actions; the area takes the row's full height.
+    const measure = () => {
+      const box = gap.getBoundingClientRect()
+      const bounds = row.getBoundingClientRect()
+      const origin = pane.getBoundingClientRect()
+      setRect(
+        box.width < minWidth
+          ? undefined
+          : { x: box.left - origin.left, y: bounds.top - origin.top, width: box.width, height: bounds.height },
+      )
+    }
+
+    const resize = new ResizeObserver(measure)
+    resize.observe(pane)
+    resize.observe(gap)
+    // The row's sections catch moves that keep the gap's size, such as the breadcrumb and the actions trading width.
+    for (const section of row.children) resize.observe(section)
+    onCleanup(() => resize.disconnect())
+  })
+
+  return (
+    <Show when={rect()}>
+      {(value) => (
+        <div
+          data-slot="session-header-drag"
+          aria-hidden="true"
+          class="absolute"
+          style={{
+            left: `${value().x}px`,
+            top: `${value().y}px`,
+            width: `${value().width}px`,
+            height: `${value().height}px`,
+          }}
+          data-tauri-drag-region
+        />
+      )}
+    </Show>
+  )
+}
diff --git a/packages/app/src/session/header/fit.ts b/packages/app/src/session/header/fit.ts
new file mode 100644
index 0000000..c14cec8
--- /dev/null
+++ b/packages/app/src/session/header/fit.ts
@@ -0,0 +1,100 @@
+import { onCleanup, onMount } from "solid-js"
+import { createStore } from "solid-js/store"
+
+/** Fits the location names before allowing the session title to truncate. */
+export function createSessionHeaderFit() {
+  const [store, setStore] = createStore({ collapse: 0 })
+  let root!: HTMLDivElement
+
+  onMount(() => {
+    const fit = () => {
+      const location = root.querySelector<HTMLElement>(".session-header-location")
+      const title = root.querySelector<HTMLElement>(".session-header-title")
+      const measure = root.querySelector<HTMLElement>(".session-header-title-measure > span")
+      const trigger = root.querySelector<HTMLElement>('[data-slot="session-location-trigger"]')
+      const project = trigger?.querySelector<HTMLElement>('[data-slot="session-location-project"]')
+      const worktree = trigger?.querySelector<HTMLElement>('[data-slot="session-location-worktree"]')
+
+      if (!location || !title || !measure || !trigger || !project || !root.clientWidth) return
+
+      const gap = Number.parseFloat(getComputedStyle(trigger).columnGap)
+      const projectWidth = project.getBoundingClientRect().width + gap
+      const worktreeWidth = worktree ? worktree.getBoundingClientRect().width + gap : 0
+
+      // Hidden labels retain their intrinsic width, so fitting never depends on a previous truncation.
+      const expanded =
+        location.getBoundingClientRect().width +
+        (store.collapse >= 1 ? worktreeWidth : 0) +
+        (store.collapse >= 2 ? projectWidth : 0)
+
+      // Ancestors can fill the space a hidden name freed. Apply their cap to each reconstructed candidate.
+      const max = getComputedStyle(location).maxInlineSize
+
+      const limit =
+        max === "none"
+          ? Number.POSITIVE_INFINITY
+          : Number.parseFloat(max) * (max.endsWith("%") ? root.getBoundingClientRect().width / 100 : 1)
+
+      const children = [...title.children].filter(
+        (element) => !element.matches(".session-header-title-measure") && getComputedStyle(element).display !== "none",
+      )
+
+      const titleWidth = children.reduce(
+        (width, element) => {
+          if (element.matches('[data-slot="session-header-gap"]')) return width
+
+          if (element.matches("h1, input")) return width + measure.getBoundingClientRect().width
+          const style = getComputedStyle(element)
+
+          return (
+            width +
+            element.getBoundingClientRect().width +
+            Number.parseFloat(style.marginInlineStart) +
+            Number.parseFloat(style.marginInlineEnd)
+          )
+        },
+        Math.max(0, children.length - 1) * Number.parseFloat(getComputedStyle(title).columnGap),
+      )
+
+      // Everything outside these two sections is reserved for actions, separators and their spacing.
+      const available = location.getBoundingClientRect().width + title.getBoundingClientRect().width - titleWidth
+      setStore(
+        "collapse",
+        Math.min(expanded, limit) <= available
+          ? 0
+          : worktree && Math.min(expanded - worktreeWidth, limit) <= available
+            ? 1
+            : 2,
+      )
+    }
+
+    const resize = new ResizeObserver(fit)
+
+    const observe = () => {
+      resize.disconnect()
+      resize.observe(root)
+      root
+        .querySelectorAll(
+          ".session-header-location, .session-location-label, .session-header-title > *, .session-header-title-measure > span, .session-header-actions",
+        )
+        .forEach((element) => resize.observe(element))
+      fit()
+    }
+
+    // Conditional controls and the rename field can mount without resizing the container itself.
+    const mutation = new MutationObserver(observe)
+    mutation.observe(root, { childList: true, subtree: true })
+    observe()
+    onCleanup(() => {
+      resize.disconnect()
+      mutation.disconnect()
+    })
+  })
+
+  return {
+    ref: (element: HTMLDivElement) => (root = element),
+    get collapse() {
+      return store.collapse
+    },
+  }
+}
