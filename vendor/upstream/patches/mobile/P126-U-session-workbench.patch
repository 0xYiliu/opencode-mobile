index 0000000..b9b4b39
--- /dev/null
+++ b/packages/app/src/session/timeline/quote-background.ts
@@ -0,0 +1,141 @@
+type Rect = { left: number; top: number; right: number; bottom: number }
+
+/** Native selection fills line boxes; custom highlights only fill the smaller font boxes. */
+export function createQuoteBackground() {
+  const hosts = new Map<HTMLElement, { layer: HTMLSpanElement; relative: boolean }>()
+
+  const remove = (parent: HTMLElement) => {
+    const host = hosts.get(parent)
+
+    if (!host) return
+    host.layer.remove()
+    parent.classList.remove("timeline-quote-highlight-host")
+
+    if (host.relative) parent.classList.remove("timeline-quote-highlight-relative")
+    hosts.delete(parent)
+  }
+
+  return {
+    update(ranges: Range[]) {
+      const styles = new Map<Element, CSSStyleDeclaration>()
+      const boxes = new Map<Element, DOMRect>()
+      const lines = new Map<HTMLElement, Rect[]>()
+
+      const style = (element: Element) => {
+        const value = styles.get(element) ?? getComputedStyle(element)
+        styles.set(element, value)
+
+        return value
+      }
+
+      ranges.forEach((range) => {
+        const walker = document.createTreeWalker(range.commonAncestorContainer, NodeFilter.SHOW_TEXT)
+
+        const visit = (node: Node) => {
+          const parent = node.parentElement
+
+          if (!(parent instanceof HTMLElement) || !range.intersectsNode(node)) return
+          const piece = document.createRange()
+          piece.setStart(node, node === range.startContainer ? range.startOffset : 0)
+          piece.setEnd(node, node === range.endContainer ? range.endOffset : node.textContent!.length)
+          const block = lineBlock(parent, style)
+          const height = parseFloat(style(block).lineHeight)
+          const box = boxes.get(block) ?? block.getBoundingClientRect()
+          boxes.set(block, box)
+          const top = box.top + parseFloat(style(block).borderTopWidth) + parseFloat(style(block).paddingTop)
+
+          const rects = [...piece.getClientRects()].flatMap((rect) => {
+            if (!rect.width || !rect.height) return []
+
+            const y =
+              Number.isFinite(height) && height >= rect.height
+                ? top + Math.floor((rect.top + rect.height / 2 - top) / height) * height
+                : rect.top
+
+            return [{ left: rect.left, right: rect.right, top: y, bottom: y + Math.max(height || 0, rect.height) }]
+          })
+
+          if (!rects.length) return
+          const current = lines.get(parent) ?? []
+          current.push(...rects)
+          lines.set(parent, current)
+        }
+
+        if (range.commonAncestorContainer instanceof Text) return visit(range.commonAncestorContainer)
+
+        while (walker.nextNode()) visit(walker.currentNode)
+      })
+
+      hosts.forEach((_host, parent) => {
+        if (!lines.has(parent)) remove(parent)
+      })
+      lines.forEach((_rects, parent) => {
+        const existing = hosts.get(parent)
+
+        // A renderer can replace a retained element's textContent, removing its background child.
+        if (existing) {
+          if (existing.layer.parentElement !== parent) parent.append(existing.layer)
+
+          return
+        }
+
+        const layer = document.createElement("span")
+        layer.dataset.component = "timeline-quote-background"
+        layer.setAttribute("aria-hidden", "true")
+        const relative = style(parent).position === "static"
+        parent.classList.add("timeline-quote-highlight-host")
+
+        if (relative) parent.classList.add("timeline-quote-highlight-relative")
+        parent.append(layer)
+        hosts.set(parent, { layer, relative })
+      })
+
+      // Inline containing blocks can start at their first fragment, not their bounding box's left edge.
+      const origins = new Map([...hosts].map(([parent, host]) => [parent, host.layer.getBoundingClientRect()]))
+      lines.forEach((rects, parent) => {
+        const host = hosts.get(parent)!
+        const origin = origins.get(parent)!
+
+        const merged = rects
+          .sort((a, b) => a.top - b.top || a.left - b.left)
+          .reduce<Rect[]>((result, rect) => {
+            const previous = result.at(-1)
+
+            if (
+              previous &&
+              Math.abs(previous.top - rect.top) < 0.5 &&
+              Math.abs(previous.bottom - rect.bottom) < 0.5 &&
+              rect.left <= previous.right + 0.5
+            ) {
+              previous.right = Math.max(previous.right, rect.right)
+
+              return result
+            }
+
+            result.push({ ...rect })
+
+            return result
+          }, [])
+
+        host.layer.replaceChildren(
+          ...merged.map((rect) => {
+            const element = document.createElement("span")
+            element.style.left = `${rect.left - origin.left}px`
+            element.style.top = `${rect.top - origin.top}px`
+            element.style.width = `${rect.right - rect.left}px`
+            element.style.height = `${rect.bottom - rect.top}px`
+
+            return element
+          }),
+        )
+      })
+    },
+    clear: () => hosts.forEach((_host, parent) => remove(parent)),
+  }
+}
+
+function lineBlock(element: HTMLElement, style: (element: Element) => CSSStyleDeclaration): HTMLElement {
+  if (!/^(inline|contents)$/.test(style(element).display) || !element.parentElement) return element
+
+  return lineBlock(element.parentElement, style)
+}
diff --git a/packages/app/src/session/timeline/quote-highlight.ts b/packages/app/src/session/timeline/quote-highlight.ts
new file mode 100644
index 0000000..1132d9f
--- /dev/null
+++ b/packages/app/src/session/timeline/quote-highlight.ts
@@ -0,0 +1,240 @@
+import { createEffect, on, onCleanup } from "solid-js"
+import type { QuoteSource, createComposerQuoteSource } from "@/composer/quote-source"
+import { createQuoteBackground } from "./quote-background"
+
+const BASE = "timeline-quote-source"
+
+/** Capture exact offsets in stable parts, rather than finding the first occurrence of the quoted text. */
+export function captureQuoteSource(ranges: Range[]): QuoteSource {
+  const indexes = new Map<Element, Map<Text, number>>()
+
+  return ranges.reduce<QuoteSource>((sources, range) => {
+    const node = range.startContainer
+    const root = node.getRootNode()
+    const parent = node.parentElement
+    const part = (root instanceof ShadowRoot ? root.host : parent)?.closest("[data-timeline-part-id]")
+    const partID = part?.getAttribute("data-timeline-part-id")
+    const revealID = part?.closest("[data-message-id]")?.getAttribute("data-message-id")
+
+    if (!part || !partID || !revealID || !parent || !(node instanceof Text)) return sources
+    const body = parent.closest('[data-slot="text-part-body"], [data-slot="user-message-text"]')
+    const line = root instanceof ShadowRoot ? parent.closest("[data-line][data-line-type]") : undefined
+    const container = root instanceof ShadowRoot ? line : (body ?? part)
+
+    if (!container) return sources
+    const index = indexes.get(container) ?? new Map(textNodes(container).map((item) => [item.node, item.start]))
+    indexes.set(container, index)
+    const offset = index.get(node)
+
+    if (offset === undefined) return sources
+
+    const source = {
+      partID,
+      revealID,
+      body: body ? `[data-slot="${body.getAttribute("data-slot")}"]` : undefined,
+      shadow:
+        root instanceof ShadowRoot && line
+          ? {
+              host: [...part.querySelectorAll("diffs-container")].indexOf(root.host),
+              line: `[data-line="${CSS.escape(line.getAttribute("data-line")!)}"][data-line-type="${CSS.escape(line.getAttribute("data-line-type")!)}"]`,
+            }
+          : undefined,
+      start: offset + range.startOffset,
+      end: offset + range.endOffset,
+      text: range.toString(),
+    }
+
+    const previous = sources.at(-1)
+
+    // Token spans and inline formatting are contiguous text within the same source container.
+    if (
+      previous &&
+      previous.partID === source.partID &&
+      previous.body === source.body &&
+      previous.shadow?.host === source.shadow?.host &&
+      previous.shadow?.line === source.shadow?.line &&
+      previous.end === source.start
+    ) {
+      previous.end = source.end
+      previous.text += source.text
+
+      return sources
+    }
+
+    sources.push(source)
+
+    return sources
+  }, [])
+}
+
+export function createTimelineQuoteHighlight(input: {
+  root: () => HTMLElement | undefined
+  visible: () => HTMLElement | undefined
+  source: () => ReturnType<typeof createComposerQuoteSource>
+  enabled: () => boolean
+  reveal: (id: string, partID: string) => void
+  unpin: () => void
+}) {
+  let pending: { key: string; source: ReturnType<typeof createComposerQuoteSource> } | undefined
+
+  const reveal = () => {
+    const root = input.root()
+    const source = input.source()
+    const first = pending && pending.source === source && source.state.sources[pending.key]?.[0]
+
+    if (!first || !root || !input.enabled()) return
+    const range = resolveQuoteRange(root, first, new Map())
+    const rect = range && [...range.getClientRects()].find((rect) => rect.width > 0 && rect.height > 0)
+
+    if (!rect) return
+    pending = undefined
+    const viewport = input.visible()?.getBoundingClientRect() ?? root.getBoundingClientRect()
+    const sticky = root.querySelector<HTMLElement>("[data-session-title]")
+    const top = viewport.top + (sticky?.offsetHeight ?? 0)
+
+    if (rect.top >= top && rect.bottom <= viewport.bottom) return
+    input.unpin()
+    root.scrollBy({ top: rect.top - top - (viewport.bottom - top) / 2, behavior: "instant" })
+  }
+
+  createEffect(() => {
+    const root = input.root()
+    const source = input.source()
+    const pieces = source.state.pending ? source.state.sources[source.state.pending] : undefined
+
+    if (!root || !input.enabled() || !pieces?.length || typeof Highlight === "undefined" || !CSS.highlights) return
+    const base = new Highlight()
+    base.priority = -2
+    CSS.highlights.set(BASE, base)
+    let frame: number | undefined
+    const background = createQuoteBackground()
+    const observed = new Set<Element>()
+
+    const schedule = () => {
+      if (frame !== undefined) return
+      frame = requestAnimationFrame(() => {
+        frame = undefined
+        apply()
+      })
+    }
+
+    const apply = () => {
+      base.clear()
+      observer.disconnect()
+      const shadows = new Set<ShadowRoot>()
+      const containers = new Map<Element, ReturnType<typeof textNodes>>()
+      const ranges: Range[] = []
+
+      pieces.forEach((piece) => {
+        const range = resolveQuoteRange(root, piece, containers, (shadow) => {
+          if (shadows.has(shadow)) return
+          shadows.add(shadow)
+        })
+
+        if (!range) return
+        base.add(range)
+        ranges.push(range)
+      })
+      background.update(ranges)
+      reveal()
+      observer.observe(root, { childList: true, subtree: true, characterData: true })
+      observer.observe(document.documentElement, { attributes: true, attributeFilter: ["style", "class", "dir"] })
+      shadows.forEach((shadow) => observer.observe(shadow, { childList: true, subtree: true, characterData: true }))
+      const targets = new Set<Element>([root, ...containers.keys()])
+      observed.forEach((element) => {
+        if (targets.has(element)) return
+        resize.unobserve(element)
+        observed.delete(element)
+      })
+      targets.forEach((element) => {
+        if (observed.has(element)) return
+        observed.add(element)
+        resize.observe(element)
+      })
+    }
+
+    const observer = new MutationObserver(schedule)
+    const resize = new ResizeObserver(schedule)
+    document.fonts.addEventListener("loadingdone", schedule)
+
+    apply()
+    onCleanup(() => {
+      observer.disconnect()
+      resize.disconnect()
+      document.fonts.removeEventListener("loadingdone", schedule)
+
+      if (frame !== undefined) cancelAnimationFrame(frame)
+      background.clear()
+      CSS.highlights.delete(BASE)
+    })
+  })
+
+  createEffect(
+    on(
+      () => [input.source(), input.source().state.reveal?.sequence] as const,
+      ([current], previous) => {
+        const source = input.source()
+        const key = source.state.reveal?.key
+        const first = key && source.state.sources[key]?.[0]
+        const root = input.root()
+
+        pending = undefined
+
+        if (current !== previous?.[0] || !first || !root || !input.enabled()) return
+        pending = { key, source }
+        reveal()
+
+        if (!pending) return
+        input.unpin()
+        input.reveal(first.revealID, first.partID)
+      },
+    ),
+  )
+}
+
+function resolveQuoteRange(
+  root: HTMLElement,
+  piece: QuoteSource[number],
+  containers: Map<Element, ReturnType<typeof textNodes>>,
+  observe?: (shadow: ShadowRoot) => void,
+) {
+  const part = root.querySelector(`[data-timeline-part-id="${CSS.escape(piece.partID)}"]`)
+  const shadow = piece.shadow && part?.querySelectorAll("diffs-container")[piece.shadow.host]?.shadowRoot
+
+  if (shadow) observe?.(shadow)
+
+  const container = piece.shadow
+    ? shadow?.querySelector(piece.shadow.line)
+    : piece.body
+      ? part?.querySelector(piece.body)
+      : part
+
+  if (!container) return
+  const nodes = containers.get(container) ?? textNodes(container)
+  containers.set(container, nodes)
+  const start = nodes.find((item) => item.start <= piece.start && item.end > piece.start)
+  const end = nodes.find((item) => item.start < piece.end && item.end >= piece.end)
+
+  if (!start || !end) return
+  const range = document.createRange()
+  range.setStart(start.node, piece.start - start.start)
+  range.setEnd(end.node, piece.end - end.start)
+
+  // A changed tool result or rerender must never highlight unrelated text at the old offset.
+  return range.toString() === piece.text ? range : undefined
+}
+
+function textNodes(root: Element) {
+  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT)
+  const nodes: { node: Text; start: number; end: number }[] = []
+  let offset = 0
+
+  while (walker.nextNode()) {
+    // SAFETY: SHOW_TEXT restricts this walker to Text nodes.
+    const node = walker.currentNode as Text
+    nodes.push({ node, start: offset, end: offset + node.length })
+    offset += node.length
+  }
+
+  return nodes
+}
diff --git a/packages/app/src/session/timeline/quote-text.ts b/packages/app/src/session/timeline/quote-text.ts
