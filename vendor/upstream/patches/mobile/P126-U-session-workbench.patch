+      this.finalize(this.tip, this.lineNumber - 1)
+    }
+    void offset
+    const newBlock = this.newNode(tag, this.lineNumber)
+    newBlock.parent = this.tip
+    this.tip.children.push(newBlock)
+    this.tip = newBlock
+    return newBlock
+  }
+
+  canContain(parent: BlockType, child: BlockType): boolean {
