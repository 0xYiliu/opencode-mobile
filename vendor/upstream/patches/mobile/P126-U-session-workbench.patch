@@ -0,0 +1,19 @@
+import { expect, test } from "bun:test"
+import { arrayMove } from "./array-move"
+
+test("moves an item forward and backward", () => {
+  expect(arrayMove(["a", "b", "c", "d"], 0, 2)).toEqual(["b", "c", "a", "d"])
+  expect(arrayMove(["a", "b", "c", "d"], 3, 1)).toEqual(["a", "d", "b", "c"])
+  expect(arrayMove(["a", "b", "c"], 0, 2)).toEqual(["b", "c", "a"])
+})
+
+test("does not mutate the input", () => {
+  const items = ["a", "b", "c"]
+  arrayMove(items, 0, 2)
+  expect(items).toEqual(["a", "b", "c"])
+})
+
+test("returns the same array when nothing moves", () => {
+  const items = ["a", "b"]
+  expect(arrayMove(items, 1, 1)).toBe(items)
+})
diff --git a/packages/app/src/runtime/array-move.ts b/packages/app/src/runtime/array-move.ts
new file mode 100644
index 0000000..2765e33
--- /dev/null
+++ b/packages/app/src/runtime/array-move.ts
@@ -0,0 +1,8 @@
+export function arrayMove<T>(items: T[], from: number, to: number) {
+  if (from === to) return items
+
+  const next = items.slice()
+  next.splice(to, 0, ...next.splice(from, 1))
+
+  return next
+}
