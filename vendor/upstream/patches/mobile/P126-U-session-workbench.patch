+  createResizeObserver(input.root, () => {
+    if (!selected || reflow !== undefined) return
+    reflow = requestAnimationFrame(() => {
+      reflow = undefined
+      read()
+    })
+  })
+
+  createEffect(on(input.sessionKey, close, { defer: true }))
+  createEffect(() => {
+    if (!input.enabled()) close()
+  })
