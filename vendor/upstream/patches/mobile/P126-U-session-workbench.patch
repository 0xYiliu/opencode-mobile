index 0000000..21e0f79
--- /dev/null
+++ b/packages/app/src/session/composer/activity-chips.css
@@ -0,0 +1,259 @@
+[data-color-scheme="dark"] [data-slot="session-activity-chip"] {
+  background: var(--v2-background-bg-layer-01);
+}
+
+/* The composer buttons' overlays and focus ring, with overlays layered over the capsule's own surface. */
+[data-slot="session-activity-chip"] {
+  &:focus-visible {
+    outline: 2px solid var(--v2-border-border-focus);
+    outline-offset: 2.5px;
+  }
+
+  @media (hover: hover) {
+    &:hover:not(:active, [data-expanded]) {
+      background-image: linear-gradient(var(--v2-overlay-simple-overlay-hover), var(--v2-overlay-simple-overlay-hover));
+    }
+  }
+
+  &:is(:active, [data-expanded]) {
+    background-image: linear-gradient(
+      var(--v2-overlay-simple-overlay-pressed),
+      var(--v2-overlay-simple-overlay-pressed)
+    );
+  }
+}
+
+[data-slot="session-activity-summary"] {
+  color: var(--v2-text-text-faint);
+
+  > .truncate {
+    color: var(--v2-text-text-base);
+  }
+}
+
+/*
+ * The open panel sits just above the capsule, with their inline-start edges aligned, and its rows share the capsule's
+ * grid: the same hairline and 10px inset put row glyphs on the capsule's glyph, and the same 16px glyph and 8px gap put
+ * row text on the capsule's label. Rows are subgrids of one table, so agent names, descriptions and run times each
+ * line up in a column; descriptions take the remaining width and truncate only when the panel reaches its maximum.
+ */
+[data-component="menu-v2-content"][data-slot="session-activity-panel"] {
+  width: max-content;
+  min-width: max(var(--kb-popper-anchor-width, 0px), 240px);
+  max-width: min(360px, calc(100vw - 56px));
+  max-height: min(270px, var(--kb-popper-content-available-height, 270px));
+  overflow-y: auto;
+  display: grid;
+  grid-template-columns: auto auto minmax(0, 1fr) auto;
+  align-content: start;
+  column-gap: 8px;
+  padding: 4px;
+  scroll-padding-block: 4px;
+  /* The capsule's hairline, so both insets round to the same device pixels. */
+  border: 0.5px solid transparent;
+  border-radius: 10px;
+  background: var(--v2-background-bg-layer-01);
+  text-align: start;
+
+  [data-slot="menu-v2-item-content"] > span[dir] {
+    text-align: match-parent;
+    unicode-bidi: isolate;
+  }
+
+  [data-slot="session-activity-elapsed"] {
+    unicode-bidi: isolate;
+  }
+
+  /* With the panel's 4px padding, rows inset 10px like the capsule's content, at the end as at the start. */
+  [data-component="menu-v2-item"],
+  [data-slot="menu-v2-item-content"] {
+    display: grid;
+    grid-column: 1 / -1;
+    grid-template-columns: subgrid;
+    align-items: center;
+  }
+
+  [data-component="menu-v2-item"] {
+    padding-inline: 6px;
+    border-radius: 4px;
+  }
+
+  /* A shell's command spans the agent and description columns. */
+  [data-slot="menu-v2-item-content"] > span[dir="ltr"] {
+    grid-column: 2 / 4;
+  }
+
+  [data-slot="menu-v2-item-content"] > svg:first-child {
+    flex: none;
+    width: 16px;
+    height: 16px;
+  }
+
+  /*
+   * The run time and the stop button stack in one end-aligned cell of the last column, which is as wide as the
+   * longest run time, so swapping them on hover moves nothing.
+   */
+  [data-slot="session-activity-end"] {
+    grid-column: 4;
+    display: grid;
+    align-items: center;
+    justify-items: end;
+    margin-inline-start: 8px;
+
+    > * {
+      grid-area: 1 / 1;
+    }
+  }
+
+  [data-slot="session-activity-stop"] {
+    visibility: hidden;
+  }
+
+  [data-component="menu-v2-item"][data-stoppable]:is(:hover, [data-highlighted]) {
+    [data-slot="session-activity-stop"] {
+      visibility: visible;
+    }
+
+    [data-slot="session-activity-elapsed"] {
+      visibility: hidden;
+    }
+  }
+
+  /* Without hover, the stop button stays visible and the run time sits before it. */
+  @media (hover: none) {
+    [data-component="menu-v2-item"] {
+      min-height: 44px;
+    }
+
+    [data-slot="session-activity-stop"] {
+      min-width: 44px;
+      min-height: 44px;
+    }
+
+    [data-slot="session-activity-end"] {
+      display: flex;
+      gap: 2px;
+    }
+
+    [data-slot="session-activity-stop"],
+    [data-component="menu-v2-item"][data-stoppable]:is(:hover, [data-highlighted])
+      [data-slot="session-activity-elapsed"] {
+      visibility: visible;
+    }
+  }
+
+  /* One shell: a wider panel with its header row over the tail of its output. Switching views changes size at once. */
+  &[data-view="shell"] {
+    display: flex;
+    flex-direction: column;
+    width: min(560px, calc(100vw - 56px));
+    max-width: none;
+    max-height: min(320px, var(--kb-popper-content-available-height, 320px));
+    overflow: hidden;
+  }
+
+  [data-slot="session-activity-shell-header"] {
+    display: flex;
+    flex: none;
+    align-items: center;
+    gap: 8px;
+    min-height: 28px;
+    padding-inline-end: 2px;
+
+    [data-component="menu-v2-item"],
+    [data-slot="menu-v2-item-content"] {
+      display: flex;
+      flex: none;
+    }
+
+    [data-component="menu-v2-item"] {
+      padding-inline: 6px;
+    }
+
+    /* Matches the list's glyph column, so the arrow sits where the row icons were. */
+    [data-slot="session-activity-back"] {
+      width: 28px;
+      justify-content: center;
+      --menu-v2-fg: var(--v2-icon-icon-muted);
+
+      [data-slot="menu-v2-item-content"] {
+        flex: none;
+      }
+
+      svg:dir(rtl) {
+        transform: scaleX(-1);
+      }
+    }
+
+    [data-slot="session-activity-shell-stop"][aria-disabled="true"] {
+      --menu-v2-fg: var(--v2-text-text-muted);
+    }
+  }
+
+  [data-slot="session-activity-shell-command"] {
+    font-family: var(--v2-font-family-code);
+    font-size: 13px;
+    font-weight: 440;
+    line-height: var(--line-height-compact);
+    letter-spacing: -0.04px;
+    color: var(--v2-text-text-base);
+    text-align: left;
+  }
+
+  [data-slot="session-activity-shell-status"] {
+    flex: none;
+    padding-inline: 6px;
+    font-size: 13px;
+    line-height: var(--line-height-compact);
+    white-space: nowrap;
+    color: var(--v2-text-text-muted);
+
+    &[data-failed] {
+      color: var(--v2-state-fg-danger);
+    }
+  }
+
+  [data-slot="session-activity-shell-output"] {
+    min-height: 0;
+    flex: 1 1 auto;
+    overflow-x: hidden;
+    overflow-y: auto;
+    margin-top: 4px;
+    padding: 8px 10px;
+    border-radius: 6px;
+    background: var(--v2-background-bg-base);
+
+    pre {
+      margin: 0;
+      text-align: left;
+    }
+
+    code {
+      display: block;
+      font-family: var(--v2-font-family-code);
+      font-size: 13px;
+      font-weight: 440;
+      line-height: var(--line-height-compact);
+      letter-spacing: -0.04px;
+      color: var(--v2-text-text-base);
+      white-space: pre-wrap;
+      overflow-wrap: anywhere;
+    }
+  }
+
+  [data-slot="session-activity-shell-empty"] {
+    font-size: 13px;
+    line-height: var(--line-height-compact);
+    color: var(--v2-text-text-muted);
+  }
+
+  :root[data-motion="reduce"] & {
+    animation: none;
+  }
+}
+
+@media (hover: none) {
+  [data-slot="session-activity-chip"] {
+    min-height: 44px;
+  }
+}
