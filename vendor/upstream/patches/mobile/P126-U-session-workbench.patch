diff --git a/packages/ui/src/motion/slider.ts b/packages/ui/src/motion/slider.ts
new file mode 100644
index 0000000..d6cf394
--- /dev/null
+++ b/packages/ui/src/motion/slider.ts
@@ -0,0 +1,45 @@
+export interface SliderSpec {
+  min: number
+  max: number
+  step: number
+}
+
+const clamp = (value: number, min: number, max: number) => Math.max(min, Math.min(max, value))
+
+function validate(spec: SliderSpec) {
+  if (
+    !Number.isFinite(spec.min) ||
+    !Number.isFinite(spec.max) ||
+    !Number.isFinite(spec.step) ||
+    spec.max < spec.min ||
+    spec.step <= 0
+  )
+    throw new RangeError("Invalid slider range")
+}
+
+/** Includes both endpoints. Non-divisible ranges include a final shorter interval. */
+export function sliderStops(spec: SliderSpec): number {
+  validate(spec)
+
+  return Math.ceil((spec.max - spec.min) / spec.step - 1e-10) + 1
+}
+
+export function sliderValue(spec: SliderSpec, value: number): number {
+  validate(spec)
+  const nearest = spec.min + Math.round((value - spec.min) / spec.step) * spec.step
+  const result = Math.abs(value - spec.max) < Math.abs(value - nearest) ? spec.max : nearest
+
+  return Number(clamp(result, spec.min, spec.max).toPrecision(14))
+}
+
+export function sliderFraction(spec: SliderSpec, value: number): number {
+  return spec.max === spec.min ? 0 : clamp((value - spec.min) / (spec.max - spec.min), 0, 1)
+}
+
+export function sliderStep(spec: SliderSpec, value: number, direction: -1 | 1, count = 1): number {
+  const last = sliderStops(spec) - 1
+  const current = value >= spec.max ? last : Math.round((value - spec.min) / spec.step)
+  const index = clamp(current + direction * count, 0, last)
+
+  return sliderValue(spec, Math.min(spec.max, spec.min + index * spec.step))
+}
diff --git a/packages/ui/src/motion/velocity.ts b/packages/ui/src/motion/velocity.ts
new file mode 100644
index 0000000..f84310a
--- /dev/null
+++ b/packages/ui/src/motion/velocity.ts
@@ -0,0 +1,46 @@
+/** Timestamps are performance.now()-style milliseconds. Fixed ring buffer; push allocates nothing. */
+export class VelocityTracker {
+  private xs = new Float64Array(128)
+  private ys = new Float64Array(128)
+  private ts = new Float64Array(128)
+  private start = 0
+  private count = 0
+
+  push(x: number, y: number, t: number): void {
+    if (!Number.isFinite(x) || !Number.isFinite(y) || !Number.isFinite(t)) return
+
+    if (this.count && t < this.ts[(this.start + this.count - 1) % 128]!) this.reset()
+
+    while (this.count > 0 && t - this.ts[this.start]! > 90) {
+      this.start = (this.start + 1) % 128
+      this.count--
+    }
+
+    if (this.count === 128) {
+      this.start = (this.start + 1) % 128
+      this.count--
+    }
+
+    const index = (this.start + this.count++) % 128
+    this.xs[index] = x
+    this.ys[index] = y
+    this.ts[index] = t
+  }
+
+  velocity() {
+    if (this.count < 2) return { x: 0, y: 0 }
+    const last = (this.start + this.count - 1) % 128
+    const seconds = (this.ts[last]! - this.ts[this.start]!) / 1000
+
+    if (seconds <= 0 || performance.now() - this.ts[last]! > 90) return { x: 0, y: 0 }
+
+    return {
+      x: (this.xs[last]! - this.xs[this.start]!) / seconds,
+      y: (this.ys[last]! - this.ys[this.start]!) / seconds,
+    }
+  }
+
+  reset(): void {
+    this.start = this.count = 0
+  }
+}
