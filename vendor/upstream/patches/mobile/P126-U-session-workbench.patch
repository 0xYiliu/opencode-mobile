diff --git a/packages/util/src/abort.test.ts b/packages/util/src/abort.test.ts
new file mode 100644
index 0000000..c854216
--- /dev/null
+++ b/packages/util/src/abort.test.ts
@@ -0,0 +1,16 @@
+import { expect, test } from "bun:test"
+import { abort } from "./abort.js"
+
+test("aborts with an AbortError that does not record the caller's stack", () => {
+  const controller = new AbortController()
+  function disposeComponent() {
+    abort(controller)
+  }
+
+  disposeComponent()
+
+  expect(controller.signal.aborted).toBe(true)
+  expect(controller.signal.reason).toBeInstanceOf(DOMException)
+  expect(controller.signal.reason.name).toBe("AbortError")
+  expect(String(controller.signal.reason.stack)).not.toContain("disposeComponent")
+})
diff --git a/packages/util/src/session-mention.test.ts b/packages/util/src/session-mention.test.ts
new file mode 100644
index 0000000..8ca5ea1
--- /dev/null
+++ b/packages/util/src/session-mention.test.ts
@@ -0,0 +1,19 @@
+import { expect, test } from "bun:test"
+import { parseSessionMention, serializeSessionMention, sessionMentions } from "./session-mention.js"
+
+const id = "ses_0123456789abcdefghijklmnop"
+
+test("session tokens round-trip independently of the title", () => {
+  expect(serializeSessionMention({ id })).toBe(`@session:${id}`)
+  expect(parseSessionMention(`@session:${id}`)).toEqual({ id })
+  expect(parseSessionMention(id)).toEqual({ id })
+  expect(sessionMentions(`See @session:${id}, then ${id}.`).map((match) => match.id)).toEqual([id, id])
+})
+
+test.each(["ses_123", `@session:${id}extra`, `x${id}`, `${id}/path`, `https://host/${id}`, `@other:${id}`, `${id}_x`])(
+  "does not parse malformed or embedded IDs: %s",
+  (text) => {
+    expect(parseSessionMention(text)).toBeUndefined()
+    expect(sessionMentions(text)).toEqual([])
+  },
+)
diff --git a/packages/util/src/session-mention.ts b/packages/util/src/session-mention.ts
new file mode 100644
index 0000000..20001dc
--- /dev/null
+++ b/packages/util/src/session-mention.ts
@@ -0,0 +1,24 @@
+export type SessionMention = { id: `ses_${string}` }
+
+// Match complete generated IDs only, including while an assistant is streaming one.
+const pattern = /(?<![\w/:@-])(?:@session:)?(ses_[A-Za-z0-9]{26})(?![\w/-])/g
+
+export function sessionMentions(text: string) {
+  return Array.from(text.matchAll(pattern), (match) => ({
+    // SAFETY: the capture above requires the session prefix and a complete generated suffix.
+    id: match[1] as SessionMention["id"],
+    text: match[0],
+    start: match.index,
+    end: match.index + match[0].length,
+  }))
+}
+
+export function parseSessionMention(text: string): SessionMention | undefined {
+  const match = sessionMentions(text)[0]
+
+  return match?.text === text ? { id: match.id } : undefined
+}
+
+export function serializeSessionMention(mention: SessionMention) {
+  return `@session:${mention.id}`
+}
