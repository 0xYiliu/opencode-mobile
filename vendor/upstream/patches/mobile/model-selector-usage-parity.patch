+import type { UsageLimitsBudget, UsageLimitsInfo } from "@opencode/client/promise"
+import { Button } from "@opencode/ui/button"
+import { useDialog } from "@opencode/ui/context/dialog"
+import { onMount } from "solid-js"
+import { UsageDialogContent } from "./dialog"
+import type { CurrentModel } from "./limits"
+
+const resetsAt = Date.UTC(2026, 10, 1)
+const hour = 3_600_000
+
+const opus = { providerID: "opencode", modelID: "claude-opus-5", name: "Claude Opus 5" }
+const sonnet = { providerID: "opencode", modelID: "claude-sonnet-5", name: "Claude Sonnet 5" }
+
+const budget = (input: Partial<UsageLimitsBudget> & Pick<UsageLimitsBudget, "id">): UsageLimitsBudget => ({
+  limit: 150,
+  spent: 0,
+  scope: "each",
+  per: "set",
+  coverage: "all",
+  models: [],
+  vendors: [],
+  picked: false,
+  shared: false,
+  resetsAt,
+  ...input,
+})
+
+const anthropic = (spent: number) =>
+  budget({ id: "anthropic", coverage: "models", vendors: ["Anthropic"], models: [opus, sonnet], spent })
+
+const pool = (spent: number) => budget({ id: "pool", scope: "combined", shared: true, limit: 1_000, spent })
+
+const info = (budgets: UsageLimitsBudget[], go = false): UsageLimitsInfo => ({
+  workspace: { id: "wrk_1", name: "Acme", usageURL: "https://opencode.ai/wrk_1/activity/overview" },
+  ...(go
+    ? {
+        go: {
+          rolling: { percent: 42, limited: false, resetsAt: Date.now() + 3 * hour },
+          weekly: { percent: 18, limited: false, resetsAt: Date.now() + 100 * hour },
+          monthly: { percent: 7, limited: false, resetsAt: Date.now() + 500 * hour },
+        },
+      }
+    : {}),
+  budgets,
+})
+
+function UsageStory(props: { info: UsageLimitsInfo; model?: CurrentModel; credits?: boolean }) {
+  const dialog = useDialog()
+  const open = () => dialog.show(() => <UsageDialogContent {...props} onSwitchModel={() => {}} />)
+
+  onMount(open)
+
+  return (
+    <div class="flex min-h-[560px] items-end justify-center">
+      <Button variant="ghost-muted" onClick={open}>
+        Usage
+      </Button>
+    </div>
+  )
+}
+
+export default {
+  title: "App/Dialogs/Usage",
+  id: "app-dialog-usage",
+}
+
+export const Default = { render: () => <UsageStory info={info([anthropic(123.14), pool(394.57)], true)} /> }
+
+export const PerModel = {
+  render: () => (
+    <UsageStory
+      model={opus}
+      info={info([
+        budget({
+          id: "each",
+          coverage: "models",
+          per: "model",
+          limit: 20,
+          spent: 20,
+          picked: true,
+          models: [
+            { ...opus, spent: 20 },
+            { ...sonnet, spent: 4.5 },
+          ],
+        }),
+      ])}
+    />
+  ),
+}
+
+export const ModelBudgetReached = {
+  render: () => <UsageStory model={opus} info={info([anthropic(150.42), pool(394.57)])} />,
+}
+
+export const WorkspaceBudgetReached = { render: () => <UsageStory info={info([anthropic(80), pool(1_000.12)])} /> }
+
+export const OutOfCredits = { render: () => <UsageStory credits info={info([anthropic(80), pool(394.57)])} /> }
+
+export const NoBudgets = { render: () => <UsageStory info={info([])} /> }
diff --git a/packages/app/src/usage/dialog.tsx b/packages/app/src/usage/dialog.tsx
new file mode 100644
index 0000000..bb94788
--- /dev/null
+++ b/packages/app/src/usage/dialog.tsx
@@ -0,0 +1,443 @@
+import type { LocationRef, UsageLimitsInfo } from "@opencode/client/promise"
+import { Button } from "@opencode/ui/button"
+import { useDialog } from "@opencode/ui/context/dialog"
+import { Dialog, DialogBody, DialogFooter, DialogHeader, DialogTitleGroup } from "@opencode/ui/dialog"
+import { Loader } from "@opencode/ui/loader"
+import { createStore } from "solid-js/store"
+import { For, type JSX, Match, onMount, Show, Switch } from "solid-js"
+import { useLanguage } from "@/runtime/i18n/language"
+import { usePlatform } from "@/runtime/platform/platform"
+import { useData } from "@/runtime/server/current"
+import { useUsageFormat } from "./format"
+import {
+  type BudgetLabel,
+  type BudgetNote,
+  type BudgetRow,
+  type Callout,
+  type CurrentModel,
+  type GoRow,
+  type LimitAction,
+  usageView,
+} from "./limits"
+import "./dialog.css"
+
+/** The Usage dialog: the location's OpenCode Go allowance and Console budgets, refreshed when it opens. */
+export function DialogUsage(props: {
+  location: LocationRef
+  /** The model in use, so a per-model budget shows this model's counter. */
+  model?: CurrentModel
+  /** The last request was refused because the workspace is out of credits. */
+  credits?: boolean
+  onSwitchModel?: () => void
+}) {
+  const data = useData()
+  const language = useLanguage()
+  const [state, setState] = createStore({ loading: true, failed: false })
+  const load = () => {
+    setState({ loading: true, failed: false })
+    data.location.usage.invalidate(props.location)
+    data.location.usage
+      .sync(props.location)
+      .then(() => setState({ loading: false, failed: false }))
+      .catch(() => setState({ loading: false, failed: true }))
+  }
+  onMount(load)
+  const info = () => data.location.usage.limits(props.location)
+
+  return (
+    <Switch>
+      <Match when={info()}>
+        {(value) => (
+          <UsageDialogContent
+            info={value()}
+            model={props.model}
+            credits={props.credits}
+            onSwitchModel={props.onSwitchModel}
+          />
+        )}
+      </Match>
+      <Match when={true}>
+        <UsageFrame>
+          <div class="flex min-h-[120px] items-center justify-center px-4 pb-4">
+            <Switch>
+              <Match when={state.loading}>
+                <Loader />
+              </Match>
+              <Match when={state.failed}>
+                <div class="flex flex-col items-center gap-3">
+                  <span class="text-[13px] leading-text-compact font-[440] tracking-[-0.04px] text-v2-text-text-muted">
+                    {language.t("usage.error")}
+                  </span>
+                  <Button variant="neutral" onClick={load}>
+                    {language.t("usage.retry")}
+                  </Button>
+                </div>
+              </Match>
+              <Match when={true}>
+                <Panel gap={8}>
+                  <Item>
+                    <Line class="font-[530] text-v2-text-text-base">{language.t("usage.signedOut.title")}</Line>
+                    <Line class="text-v2-text-text-muted">{language.t("usage.signedOut.body")}</Line>
+                  </Item>
+                </Panel>
+              </Match>
+            </Switch>
+          </div>
+        </UsageFrame>
+      </Match>
+    </Switch>
+  )
+}
+
+/** The dialog for usage limits already loaded. */
+export function UsageDialogContent(props: {
+  info: UsageLimitsInfo
+  model?: CurrentModel
+  credits?: boolean
+  onSwitchModel?: () => void
+}) {
+  const language = useLanguage()
+  const platform = usePlatform()
+  const dialog = useDialog()
+  const format = useUsageFormat()
+  const view = () => usageView(props.info, { model: props.model, credits: props.credits })
+  const workspace = () => view().workspace ?? language.t("usage.workspace.fallback")
+  const vendors = (list: readonly string[]) =>
+    new Intl.ListFormat(language.intl(), { style: "long", type: "conjunction" }).format(list)
+  const duration = (until: number) => {
+    const minutes = Math.max(1, Math.floor((until - Date.now()) / 60_000))
+    if (minutes >= 1_440)
+      return language.t("usage.duration.days", {
+        days: Math.floor(minutes / 1_440),
+        hours: Math.floor((minutes % 1_440) / 60),
+      })
+    if (minutes >= 60)
+      return language.t("usage.duration.hours", { hours: Math.floor(minutes / 60), minutes: minutes % 60 })
+    return language.t("usage.duration.minutes", { minutes })
+  }
+  const label = (value: BudgetLabel): string => {
+    if (value.kind === "all") return language.t("usage.budget.all")
+    if (value.kind === "each") return language.t("usage.budget.each")
+    if (value.kind === "vendors") {
+      const params = {
+        vendors: vendors(value.vendors),
+        price: value.price === undefined ? "" : format.money(value.price, "auto"),
+      }
+      if (value.price !== undefined)
+        return language.t(value.each ? "usage.budget.vendorsPriceEach" : "usage.budget.vendorsPrice", params)
+      return language.t(value.each ? "usage.budget.vendorsEach" : "usage.budget.vendors", params)
+    }
+    if (value.kind === "price")
+      return language.t(value.each ? "usage.budget.priceEach" : "usage.budget.price", {
+        price: format.money(value.price, "auto"),
+      })
+    const models =
+      value.names.length > 2
+        ? language.plural("usage.budget.modelsMore", value.names.length - 2, {
+            first: value.names[0],
+            second: value.names[1],
+          })
+        : vendors(value.names)
+    return value.each ? language.t("usage.budget.modelsEach", { models }) : models
+  }
+  const scope = (row: BudgetRow) => {
+    const params = { limit: format.money(row.limit, "auto"), workspace: workspace() }
+    const amount = {
+      you: row.perModel ? "usage.budget.youEach" : "usage.budget.you",
+      everyone: row.perModel ? "usage.budget.everyoneEach" : "usage.budget.everyone",
+      group: row.perModel ? "usage.budget.groupEach" : "usage.budget.group",
+    } as const
+    return [language.t(amount[row.sharing], params), ...row.notes.map((value) => note(value, row))].join(" · ")
+  }
+  const note = (value: BudgetNote, row: BudgetRow) => {
+    if (value.kind === "runs-out-first") return language.t("usage.note.runsOutFirst")
+    if (value.kind === "paused") return language.t("usage.note.paused", { label: label(row.label) })
+    if (value.kind === "includes-web-search") return language.t("usage.note.webSearch")
+    if (value.kind === "paused-by")
+      return language.t(value.shared ? "usage.note.pausedByWorkspace" : "usage.note.pausedByBudget")
+    return language.t("usage.note.currentModel", { model: value.name })
+  }
+  const footer = () => {
+    const value = view().footer
+    if (value.kind === "credits-only") return language.t("usage.footer.creditsOnly", { workspace: workspace() })
+    return language.t(value.kind === "budgets-reset" ? "usage.footer.budgetsReset" : "usage.footer.resets", {
+      time: format.time(value.resetsAt),
+    })
+  }
+  const callout = (value: Callout) => {
+    if (value.kind === "credits")
+      return {
+        title: language.t("usage.callout.credits.title", { workspace: workspace() }),
+        body: language.t("usage.callout.credits.body"),
+      }
+    const params = { workspace: workspace(), time: format.time(value.resetsAt) }
+    if (value.kind === "workspace")
+      return {
+        title: language.t("usage.callout.workspace.title"),
+        body: language.t("usage.callout.workspace.body", params),
+      }
+    return {
+      title: language.t("usage.callout.personal.title"),
+      body: language.t("usage.callout.personal.body", params),
+    }
+  }
+  const action = (value: LimitAction) => {
+    if (value.kind === "other-models")
+      return {
+        title: language.t("usage.action.otherModels.title"),
+        body:
+          value.vendors.length > 0
+            ? language.t("usage.action.otherModels.vendors", { vendors: vendors(value.vendors) })
+            : language.t("usage.action.otherModels.body"),
+      }
+    const limit = format.money(value.limit, "auto")
+    return {
+      title:
+        value.vendors.length > 0
+          ? language.t("usage.action.each.titleVendors", { vendors: vendors(value.vendors) })
+          : language.t("usage.action.each.title"),
+      body: value.suggestion
+        ? language.t("usage.action.each.suggestion", {
+            limit,
+            model: value.suggestion.name,
+            left: format.money(value.suggestion.left),
+          })
+        : language.t("usage.action.each.body", { limit }),
+    }
+  }
+  const switchModel = () => {
+    dialog.close()
+    props.onSwitchModel?.()
+  }
+
+  return (
+    <UsageFrame
+      footer={
+        <>
+          <span class="flex h-7 min-w-0 flex-1 items-center">
+            <Line class="text-v2-text-text-faint">{footer()}</Line>
+          </span>
+          <Button
+            variant="ghost"
+            class="text-v2-text-text-muted!"
+            onClick={() => platform.openExternal(props.info.workspace.usageURL)}
+          >
+            {language.t("usage.footer.details")}
+          </Button>
+        </>
+      }
+    >
+      <Show when={view().callout}>
+        {(value) => (
+          <div data-slot="usage-callout" class="flex items-stretch gap-0.5 px-4">
+            <div class="w-0.5 shrink-0 bg-v2-state-fg-danger" />
+            <div class="flex flex-1 flex-col gap-1.5 rounded-r-md bg-v2-state-bg-danger p-3">
+              <Line class="font-[530] text-[var(--usage-reached)]">{callout(value()).title}</Line>
+              <p class="m-0 text-[13px] leading-text-base font-[440] tracking-[-0.04px] text-[var(--usage-reached)]">
+                {callout(value()).body}
+              </p>
+            </div>
+          </div>
+        )}
+      </Show>
+      <Show when={view().go}>
+        {(rows) => (
+          <Section label={language.t("usage.section.go")}>
+            <Panel>
+              <For each={rows()}>
+                {(row, index) => (
+                  <>
+                    <Show when={index() > 0}>
+                      <Divider />
+                    </Show>
+                    <GoItem row={row} used={language.t("usage.go.used", { percent: Math.round(row.percent) })}>
+                      {language.t("usage.go.resetsIn", { duration: duration(row.resetsAt) })}
+                    </GoItem>
+                  </>
+                )}
+              </For>
+            </Panel>
+          </Section>
+        )}
+      </Show>
+      <Section label={language.t("usage.section.console")} badge={view().workspace} dimmed={view().dimmed}>
+        <Show
+          when={view().budgets.length > 0}
+          fallback={
+            <Panel gap={8}>
+              <Item>
+                <Line class="font-[530] text-v2-text-text-base">{language.t("usage.empty.title")}</Line>
+                <Line class="text-v2-text-text-muted">
+                  {language.t("usage.empty.body", { workspace: workspace() })}
+                </Line>
+              </Item>
+            </Panel>
+          }
+        >
+          <Panel>
+            <For each={view().budgets}>
+              {(row, index) => (
+                <>
+                  <Show when={index() > 0}>
+                    <Divider />
+                  </Show>
+                  <Item>
+                    <div class="flex items-start justify-between self-stretch">
+                      <div class="flex min-w-0 flex-1 flex-col gap-0.5">
+                        <Line class="font-[530] text-v2-text-text-base">{label(row.label)}</Line>
+                        <p class="m-0 text-[13px] leading-text-compact font-[440] tracking-[-0.04px] text-v2-text-text-muted">
+                          {scope(row)}
+                        </p>
+                      </div>
+                      <Spend
+                        status={
+                          row.reached
+                            ? language.t("usage.budget.reached")
+                            : language.t("usage.budget.left", { amount: format.money(row.left) })
+                        }
+                        reached={row.reached}
+                      >
+                        {row.reached
+                          ? language.t("usage.budget.spentOf", {
+                              spent: format.money(row.spent),
+                              limit: format.money(row.limit, "auto"),
+                            })
+                          : language.t("usage.budget.of", { limit: format.money(row.limit, "auto") })}
+                      </Spend>
+                    </div>
+                    <Track fill={row.fill} reached={row.reached} />
+                  </Item>
+                </>
+              )}
+            </For>
+            <Show when={view().action}>
+              {(value) => (
+                <div class="flex items-center gap-4 self-stretch px-4">
+                  <div class="flex min-w-0 flex-1 flex-col gap-1">
+                    <Line class="font-[530] text-v2-text-text-base">{action(value()).title}</Line>
+                    <p class="m-0 text-[13px] leading-text-base font-[440] tracking-[-0.04px] text-v2-text-text-muted">
+                      {action(value()).body}
+                    </p>
+                  </div>
+                  <Button variant="neutral" onClick={switchModel}>
+                    {language.t("usage.action.switch")}
+                  </Button>
+                </div>
+              )}
+            </Show>
+          </Panel>
+        </Show>
+      </Section>
+    </UsageFrame>
+  )
+}
+
+function UsageFrame(props: { children: JSX.Element; footer?: JSX.Element }) {
+  const language = useLanguage()
+  return (
+    <Dialog fit containerClass="w-[min(calc(100vw-32px),512px)]!">
+      <div data-component="usage-dialog" class="flex flex-col self-stretch">
+        <DialogHeader>
+          <DialogTitleGroup title={language.t("usage.title")} />
+        </DialogHeader>
+        <DialogBody>
+          <div class="flex flex-col gap-4">{props.children}</div>
+        </DialogBody>
+        <Show when={props.footer}>
+          <DialogFooter>{props.footer}</DialogFooter>
+        </Show>
+      </div>
+    </Dialog>
+  )
+}
+
+function Section(props: { label: string; badge?: string; dimmed?: boolean; children: JSX.Element }) {
+  return (
+    <div class="flex flex-col gap-3" classList={{ "opacity-60": props.dimmed }}>
+      <div class="flex items-center gap-2 pr-5 pl-4">
+        <Line class="text-v2-text-text-muted">{props.label}</Line>
+        <Show when={props.badge}>
+          {(badge) => (
+            <span class="flex h-4 items-center rounded-[2px] bg-v2-background-bg-layer-03 px-1 text-[11px] leading-text-tight font-[530] tracking-[0.05px] text-v2-text-text-muted">
+              {badge()}
+            </span>
+          )}
+        </Show>
+      </div>
+      <div class="flex flex-col px-3">{props.children}</div>
+    </div>
+  )
+}
+
+function Panel(props: { gap?: 8 | 16; children: JSX.Element }) {
+  return (
+    <div
+      class="flex flex-col self-stretch rounded-lg border-[0.5px] border-v2-border-border-base bg-v2-background-bg-base py-4"
+      classList={{ "gap-2": props.gap === 8, "gap-4": props.gap !== 8 }}
+    >
+      {props.children}
+    </div>
+  )
+}
+
+function Item(props: { children: JSX.Element }) {
+  return <div class="flex flex-col gap-4 self-stretch px-4">{props.children}</div>
+}
+
+function Divider() {
+  return <div class="h-[0.5px] shrink-0 self-stretch bg-v2-border-border-base" />
+}
+
+/** One line of 13px text that truncates rather than wraps. */
+function Line(props: { class?: string; children: JSX.Element }) {
+  return (
+    <span
+      class={`min-w-0 truncate text-[13px] leading-text-compact font-[440] tracking-[-0.04px] ${props.class ?? ""}`}
+    >
+      {props.children}
+    </span>
+  )
+}
+
+function GoItem(props: { row: GoRow; used: string; children: JSX.Element }) {
+  const language = useLanguage()
+  return (
+    <Item>
+      <div class="flex items-center justify-between self-stretch">
+        <Line class="font-[530] text-v2-text-text-base">{language.t(`usage.go.${props.row.window}`)}</Line>
+        <Spend status={props.used} reached={props.row.limited}>
+          {props.children}
+        </Spend>
+      </div>
+      <Track fill={props.row.percent / 100} reached={props.row.limited} />
+    </Item>
+  )
+}
+
+function Spend(props: { status: string; reached: boolean; children: JSX.Element }) {
+  return (
+    <div class="flex shrink-0 items-center gap-1.5">
+      <Line
+        class={`font-[530] tabular-nums ${props.reached ? "text-[var(--usage-reached)]" : "text-v2-text-text-base"}`}
+      >
+        {props.status}
+      </Line>
+      <svg width="3" height="3" viewBox="0 0 3 3" aria-hidden="true" class="shrink-0 text-v2-icon-icon-muted">
+        <circle cx="1.5" cy="1.5" r="0.5625" fill="currentColor" />
+      </svg>
+      <Line class="text-v2-text-text-muted">{props.children}</Line>
+    </div>
+  )
+}
+
+function Track(props: { fill: number; reached: boolean }) {
+  return (
+    <div class="flex h-2 items-center self-stretch overflow-hidden rounded-[2px] bg-v2-background-bg-layer-03">
+      <div
+        class="h-2"
+        classList={{ "bg-v2-background-bg-inverse": !props.reached, "bg-[var(--usage-reached)]": props.reached }}
+        style={{ width: `${Math.max(0, Math.min(1, props.fill)) * 100}%` }}
+      />
+    </div>
+  )
+}
diff --git a/packages/app/src/usage/format.ts b/packages/app/src/usage/format.ts
new file mode 100644
index 0000000..c8c101a
--- /dev/null
+++ b/packages/app/src/usage/format.ts
@@ -0,0 +1,33 @@
+import { useLanguage } from "@/runtime/i18n/language"
+
+/** Dollar amounts and reset times as the usage surfaces write them. */
+export function useUsageFormat() {
+  const language = useLanguage()
+  return {
+    /** `auto` drops the cents of a whole amount, the way limits are set. */
+    money: (value: number, cents: "always" | "auto" = "always") =>
+      new Intl.NumberFormat(language.intl(), {
+        style: "currency",
+        currency: "USD",
+        minimumFractionDigits: cents === "auto" && Number.isInteger(value) ? 0 : 2,
+        maximumFractionDigits: 2,
+      }).format(value),
+    time: (at: number) =>
+      language.t("usage.time", {
+        date: new Intl.DateTimeFormat(language.intl(), { month: "short", day: "numeric" }).format(at),
+        time: new Intl.DateTimeFormat(language.intl(), { timeStyle: "short" }).format(at),
+        zone:
+          new Intl.DateTimeFormat(language.intl(), { timeZoneName: "shortOffset" })
+            .formatToParts(at)
+            .find((part) => part.type === "timeZoneName")?.value ?? "",
+      }),
+    /** A reset time where there is no room for its time zone. */
+    shortTime: (at: number) =>
+      new Intl.DateTimeFormat(language.intl(), {
+        month: "short",
+        day: "numeric",
+        hour: "numeric",
+        minute: "2-digit",
+      }).format(at),
+  }
+}
diff --git a/packages/app/src/usage/limits.test.ts b/packages/app/src/usage/limits.test.ts
new file mode 100644
index 0000000..833c3b9
--- /dev/null
+++ b/packages/app/src/usage/limits.test.ts
@@ -0,0 +1,141 @@
+import { describe, expect, test } from "bun:test"
+import type { UsageLimitsBudget, UsageLimitsInfo } from "@opencode/client/promise"
+import { modelUsage, usageView } from "./limits"
+
+const RESET = Date.UTC(2026, 10, 1)
+
+const budget = (input: Partial<UsageLimitsBudget> & Pick<UsageLimitsBudget, "id">): UsageLimitsBudget => ({
+  limit: 100,
+  spent: 0,
+  scope: "each",
+  per: "set",
+  coverage: "all",
+  models: [],
+  vendors: [],
+  picked: false,
+  shared: false,
+  resetsAt: RESET,
+  ...input,
+})
+
+const info = (...budgets: UsageLimitsBudget[]): UsageLimitsInfo => ({
+  workspace: { id: "wrk_1", name: "Acme", usageURL: "https://opencode.ai/wrk_1/activity/overview" },
+  budgets,
+})
+
+const opus = { providerID: "opencode", modelID: "claude-opus-5", name: "Claude Opus 5" }
+const sonnet = { providerID: "opencode", modelID: "claude-sonnet-5", name: "Claude Sonnet 5" }
+const served = (id: string, provider = "opencode") => ({ id, provider: { id: provider, integrationID: "opencode" } })
+
+describe("modelUsage", () => {
+  test("covers a model by every budget that counts it and keeps the least left", () => {
+    const limits = info(
+      budget({ id: "all", limit: 500, spent: 100 }),
+      budget({
+        id: "anthropic",
+        coverage: "models",
+        per: "model",
+        limit: 50,
+        spent: 50,
+        vendors: ["Anthropic"],
+        models: [
+          { ...opus, spent: 50 },
+          { ...sonnet, spent: 20 },
+        ],
+      }),
+    )
+
+    expect(modelUsage(limits, served("claude-sonnet-5"))).toEqual({ left: 30, reached: false, resetsAt: RESET })
+    expect(modelUsage(limits, served("claude-opus-5"))).toEqual({ left: 0, reached: true, resetsAt: RESET })
+    // A budget on all spend covers models served through the workspace, but not OpenCode Go or a direct provider.
+    expect(modelUsage(limits, served("gpt-6-sol", "console-openai"))).toEqual({
+      left: 400,
+      reached: false,
+      resetsAt: RESET,
+    })
+    expect(modelUsage(limits, served("glm-5.3", "opencode-go"))).toBeUndefined()
+    expect(modelUsage(limits, { id: "claude-opus-5", provider: { id: "anthropic" } })).toBeUndefined()
+  })
+})
+
+describe("usageView", () => {
+  test("orders budgets by what stops the member first", () => {
+    const view = usageView(
+      info(budget({ id: "roomy", limit: 500, spent: 10 }), budget({ id: "tight", limit: 150, spent: 123.14 })),
+    )
+
+    expect(view.budgets.map((row) => [row.id, row.notes])).toEqual([
+      ["tight", [{ kind: "runs-out-first" }]],
+      ["roomy", []],
+    ])
+    expect(view.budgets[0]).toMatchObject({ left: 26.86, reached: false })
+    expect(view.footer).toEqual({ kind: "resets", resetsAt: RESET })
+    expect(view.callout).toBeUndefined()
+  })
+
+  test("explains a reached budget on all spend and pauses the rest", () => {
+    const view = usageView(
+      info(
+        budget({ id: "models", coverage: "models", limit: 50, spent: 5, vendors: ["Anthropic"], models: [opus] }),
+        budget({ id: "pool", scope: "combined", shared: true, limit: 150, spent: 150.42 }),
+      ),
+    )
+
+    expect(view.callout).toEqual({ kind: "workspace", resetsAt: RESET })
+    expect(view.dimmed).toBe(true)
+    expect(view.action).toBeUndefined()
+    expect(view.budgets.map((row) => [row.id, row.sharing, row.notes])).toEqual([
+      ["pool", "everyone", [{ kind: "includes-web-search" }]],
+      ["models", "you", [{ kind: "paused-by", shared: true }]],
+    ])
+  })
+
+  test("offers other models when a budget on some models is reached", () => {
+    const vendors = usageView(
+      info(budget({ id: "anthropic", coverage: "models", limit: 50, spent: 50, vendors: ["Anthropic"] })),
+    )
+
+    expect(vendors.callout).toBeUndefined()
+    expect(vendors.budgets[0].notes).toEqual([{ kind: "paused" }])
+    expect(vendors.action).toEqual({ kind: "other-models", vendors: ["Anthropic"] })
+
+    // A budget per model counts the model in use, and suggests the covered model with the most room.
+    const each = usageView(
+      info(
+        budget({
+          id: "each",
+          coverage: "models",
+          per: "model",
+          limit: 20,
+          spent: 20,
+          picked: true,
+          models: [
+            { ...opus, spent: 20 },
+            { ...sonnet, spent: 5 },
+          ],
+        }),
+      ),
+      { model: opus },
+    )
+
+    expect(each.budgets[0]).toMatchObject({
+      label: { kind: "models", names: ["Claude Opus 5", "Claude Sonnet 5"], each: true },
+      reached: true,
+      notes: [{ kind: "current-model", name: "Claude Opus 5" }],
+    })
+    expect(each.action).toEqual({
+      kind: "other-models-each",
+      vendors: [],
+      limit: 20,
+      suggestion: { name: "Claude Sonnet 5", left: 15 },
+    })
+  })
+
+  test("blames the workspace's credits over its budgets", () => {
+    const view = usageView(info(budget({ id: "all", limit: 100, spent: 10 })), { credits: true })
+
+    expect(view.callout).toEqual({ kind: "credits" })
+    expect(view.footer).toEqual({ kind: "budgets-reset", resetsAt: RESET })
+    expect(usageView(info(), { credits: true }).footer).toEqual({ kind: "credits-only" })
+  })
+})
diff --git a/packages/app/src/usage/limits.ts b/packages/app/src/usage/limits.ts
new file mode 100644
index 0000000..aba16c1
--- /dev/null
+++ b/packages/app/src/usage/limits.ts
@@ -0,0 +1,189 @@
+import type { UsageLimitsBudget, UsageLimitsInfo } from "@opencode/client/promise"
+
+/** The model the member is using, so a per-model budget shows this model's own counter. */
+export type CurrentModel = { readonly providerID: string; readonly modelID: string; readonly name: string }
+
+/** What a budget counts, before it is put into words. */
+export type BudgetLabel =
+  | { readonly kind: "all" }
+  | { readonly kind: "vendors"; readonly vendors: readonly string[]; readonly each: boolean; readonly price?: number }
+  | { readonly kind: "price"; readonly price: number; readonly each: boolean }
+  | { readonly kind: "models"; readonly names: readonly string[]; readonly each: boolean }
+  | { readonly kind: "each" }
+
+export type BudgetNote =
+  | { readonly kind: "runs-out-first" }
+  | { readonly kind: "paused" }
+  | { readonly kind: "includes-web-search" }
+  | { readonly kind: "paused-by"; readonly shared: boolean }
+  | { readonly kind: "current-model"; readonly name: string }
+
+export type BudgetRow = {
+  readonly id: string
+  readonly label: BudgetLabel
+  readonly limit: number
+  readonly perModel: boolean
+  /** Who spends against it: the member alone, everyone in the workspace, or a group of members. */
+  readonly sharing: "you" | "everyone" | "group"
+  readonly notes: readonly BudgetNote[]
+  readonly reached: boolean
+  readonly spent: number
+  readonly left: number
+  /** How much of the limit is spent, from 0 to 1. */
+  readonly fill: number
+}
+
+export type Callout =
+  | { readonly kind: "credits" }
+  | { readonly kind: "workspace" | "personal"; readonly resetsAt: number }
+
+export type LimitAction =
+  | { readonly kind: "other-models"; readonly vendors: readonly string[] }
+  | {
+      readonly kind: "other-models-each"
+      readonly vendors: readonly string[]
+      readonly limit: number
+      /** The covered model with the most room left, to switch to. */
+      readonly suggestion?: { readonly name: string; readonly left: number }
+    }
+
+export type Footer =
+  | { readonly kind: "resets" | "budgets-reset"; readonly resetsAt: number }
+  | { readonly kind: "credits-only" }
+
+export type GoRow = {
+  readonly window: "rolling" | "weekly" | "monthly"
+  readonly percent: number
+  readonly limited: boolean
+  readonly resetsAt: number
+}
+
+export type UsageView = {
+  readonly workspace: string | undefined
+  readonly callout?: Callout
+  readonly go?: readonly GoRow[]
+  readonly budgets: readonly BudgetRow[]
+  /** A callout explains why paid models are paused, so the budgets are shown as context. */
+  readonly dimmed: boolean
+  readonly action?: LimitAction
+  readonly footer: Footer
+}
+
+/**
+ * What the Usage dialog shows for a workspace's usage limits. Budgets are ordered by what stops the member first, the
+ * least left. `credits` marks a workspace whose credits ran out.
+ */
+export function usageView(
+  info: UsageLimitsInfo,
+  context: { readonly model?: CurrentModel; readonly credits?: boolean } = {},
+): UsageView {
+  const budgets = info.budgets
+    .map((budget) => ({ budget, ...spend(budget, context.model) }))
+    .toSorted((a, b) => a.left - b.left)
+  const blocking = budgets.find((entry) => entry.reached && entry.budget.coverage === "all")
+  const callout: Callout | undefined = context.credits
+    ? { kind: "credits" }
+    : blocking && { kind: blocking.budget.shared ? "workspace" : "personal", resetsAt: blocking.budget.resetsAt }
+  const anyReached = budgets.some((entry) => entry.reached)
+  const reachedModels = budgets.find((entry) => entry.reached && entry.budget.coverage === "models")
+  const resetsAt = Math.min(...info.budgets.map((budget) => budget.resetsAt))
+  const go = info.go
+  return {
+    workspace: info.workspace.name,
+    callout,
+    go: go && (["rolling", "weekly", "monthly"] as const).map((window) => ({ window, ...go[window] })),
+    budgets: budgets.map((entry, index) => ({
+      id: entry.budget.id,
+      label: label(entry.budget),
+      limit: entry.budget.limit,
+      perModel: entry.budget.per === "model",
+      sharing: entry.budget.scope === "each" ? "you" : entry.budget.shared ? "everyone" : "group",
+      notes: [
+        ...(index === 0 && !callout && !anyReached && budgets.length > 1 ? [{ kind: "runs-out-first" as const }] : []),
+        ...(entry.reached && entry.budget.coverage === "all" ? [{ kind: "includes-web-search" as const }] : []),
+        // A budget per model names the model it paused instead.
+        ...(entry.reached && entry.budget.coverage === "models" && entry.budget.per === "set"
+          ? [{ kind: "paused" as const }]
+          : []),
+        ...(!entry.reached && blocking ? [{ kind: "paused-by" as const, shared: blocking.budget.shared }] : []),
+        ...(entry.current ? [{ kind: "current-model" as const, name: entry.current.name }] : []),
+      ],
+      reached: entry.reached,
+      spent: entry.spent,
+      left: entry.left,
+      fill: entry.budget.limit > 0 ? Math.min(1, entry.spent / entry.budget.limit) : 1,
+    })),
+    dimmed: callout !== undefined,
+    action: callout || !reachedModels ? undefined : action(reachedModels.budget),
+    footer:
+      info.budgets.length === 0
+        ? { kind: "credits-only" }
+        : { kind: context.credits ? "budgets-reset" : "resets", resetsAt },
+  }
+}
+
+/** What the member's budgets leave for one model: the least any budget covering it has left. */
+export type ModelUsage = { readonly left: number; readonly reached: boolean; readonly resetsAt: number }
+
+/**
+ * What the Console budgets leave for a model, when any covers it. A budget on all spend covers every model the
+ * workspace serves; OpenCode Go bills its own allowance instead.
+ */
+export function modelUsage(
+  info: UsageLimitsInfo,
+  model: { readonly id: string; readonly provider: { readonly id: string; readonly integrationID?: string } },
+): ModelUsage | undefined {
+  const served = model.provider.integrationID === "opencode" && model.provider.id !== "opencode-go"
+  const covering = info.budgets.flatMap((budget) => {
+    if (budget.coverage === "all") return served ? [{ budget, spent: budget.spent }] : []
+    const entry = budget.models.find((item) => item.providerID === model.provider.id && item.modelID === model.id)
+    if (!entry) return []
+    return [{ budget, spent: budget.per === "model" ? (entry.spent ?? 0) : budget.spent }]
+  })
+  if (covering.length === 0) return undefined
+  return {
+    left: Math.min(...covering.map((entry) => Math.max(0, entry.budget.limit - entry.spent))),
+    reached: covering.some((entry) => entry.spent >= entry.budget.limit),
+    resetsAt: Math.min(...covering.map((entry) => entry.budget.resetsAt)),
+  }
+}
+
+/** The spend a budget's cap compares against: a per-model budget's counter for the current model, when it covers it. */
+function spend(budget: UsageLimitsBudget, model: CurrentModel | undefined) {
+  const current =
+    budget.per === "model" && model
+      ? budget.models.find((entry) => entry.providerID === model.providerID && entry.modelID === model.modelID)
+      : undefined
+  const spent = current?.spent ?? budget.spent
+  return { current: current && model, spent, reached: spent >= budget.limit, left: Math.max(0, budget.limit - spent) }
+}
+
+function label(budget: UsageLimitsBudget): BudgetLabel {
+  const each = budget.per === "model"
+  if (budget.coverage === "all") return { kind: "all" }
+  if (budget.vendors.length > 0)
+    return {
+      kind: "vendors",
+      vendors: budget.vendors,
+      each,
+      ...(budget.inputPriceAtLeast === undefined ? {} : { price: budget.inputPriceAtLeast }),
+    }
+  if (budget.inputPriceAtLeast !== undefined) return { kind: "price", price: budget.inputPriceAtLeast, each }
+  if (budget.picked) return { kind: "models", names: budget.models.map((model) => model.name), each }
+  return { kind: "each" }
+}
+
+// A per-model budget counts as reached by the model in use, so the model in use never has room to suggest.
+function action(budget: UsageLimitsBudget): LimitAction {
+  if (budget.per !== "model") return { kind: "other-models", vendors: budget.vendors }
+  const room = budget.models
+    .map((entry) => ({ name: entry.name, left: Math.max(0, budget.limit - (entry.spent ?? 0)) }))
+    .filter((entry) => entry.left > 0)
+    .toSorted((a, b) => b.left - a.left)[0]
+  return {
+    kind: "other-models-each",
+    vendors: budget.vendors,
+    limit: budget.limit,
+    ...(room ? { suggestion: room } : {}),
+  }
+}
