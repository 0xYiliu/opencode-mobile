@@ -0,0 +1,52 @@
+import { createMemo, Show } from "solid-js"
+import { turnMessages, turnSources } from "@opencode/session-ui/sources"
+import { sourcesExperiment } from "@opencode/session-ui/sources/experiment"
+import { SourcesPanel } from "@opencode/session-ui/sources/panel"
+import { useExtension, type MountedSession } from "../sdk"
+import type Sources from "./index"
+
+export default function SourcesTab(props: { session: MountedSession; from: string }) {
+  const ctx = useExtension<typeof Sources>()
+
+  // mobile(M-036): on the narrow-screen mobile view the render receives the panel's id instead of a
+  // message id, so the tab shows the most recent turn that has sources, else the empty state. The
+  // chip path below (a message id from `list`) is the wide-layout entry (registered delta; see
+  // units/gui-extensions.md).
+  const sources = createMemo(() => {
+    const list = props.session.server.data.session.message.list(props.session.id)
+
+    if (props.from !== "turn") return turnSources(turnMessages(list, props.from))
+
+    for (let index = list.length - 1; index >= 0; index--) {
+      const message = list[index]
+
+      if (message.type !== "user") continue
+
+      const value = turnSources(turnMessages(list, message.id))
+
+      if (value.steps.length > 0) return value
+    }
+
+    return { steps: [], sources: [] }
+  })
+
+  const open = (url: string) => {
+    const pane = ctx.uses.browser()
+
+    if (pane.status === "active" && pane.value.canOpen(props.session)) return pane.value.open(props.session, url)
+    ctx.system.openExternal(url)
+  }
+
+  return (
+    <div class="flex h-full min-h-0 flex-col bg-v2-background-bg-base" data-slot="session-sources-panel">
+      <Show
+        when={sources().steps.length > 0}
+        fallback={<div class="flex h-full items-center justify-center p-4 text-v2-text-text-muted">{ctx.t("panel.none")}</div>}
+      >
+        <div class="min-h-0 flex-1 overflow-y-auto" data-scrollable>
+          <SourcesPanel sources={sources()} icons={sourcesExperiment.icons} onOpen={open} />
+        </div>
+      </Show>
+    </div>
+  )
+}
diff --git a/packages/gui-extensions/src/sources/renderer.tsx b/packages/gui-extensions/src/sources/renderer.tsx
new file mode 100644
index 0000000..bfdd022
--- /dev/null
+++ b/packages/gui-extensions/src/sources/renderer.tsx
@@ -0,0 +1,108 @@
+import { createMemo, lazy, onCleanup, Show, Suspense } from "solid-js"
+import { turnMessages, turnSources } from "@opencode/session-ui/sources"
+import { sourcesExperiment } from "@opencode/session-ui/sources/experiment"
+import { SourcesTitle } from "@opencode/session-ui/sources/title"
+import { createKeyed, LinkHandler, onIdle, Panel, type MountedSession, type PanelTab, type Setup } from "../sdk"
+import type Sources from "./index"
+
+/**
+ * The Sources experiment's side panel: one transient tab per turn, keyed by the user message that opened it. The
+ * timeline's sources chip opens it with a link whose origin is this extension and whose href is that message's ID.
+ * Turning the experiment off stops listing the tabs, which closes them.
+ */
+const setup: Setup<typeof Sources> = (ctx) => {
+  const SourcesTab = lazy(() => import("./panel"))
+  onCleanup(
+    onIdle(() => {
+      if (sourcesExperiment.enabled) void SourcesTab.preload()
+    }),
+  )
+
+  // Tab objects per session, reused so strip updates and session switches do not rebuild a trigger.
+  const tabs = new Map<string, Map<string, PanelTab>>()
+
+  // Drops the tab objects of sessions whose shell tab closed.
+  createKeyed(
+    () => [...ctx.sessions.list().map((session) => session.key), ctx.sessions.current()?.key].join("\u0000"),
+    () => {
+      const keep = new Set([...ctx.sessions.list().map((session) => session.key), ctx.sessions.current()?.key])
+      tabs.forEach((_cache, key) => {
+        if (!keep.has(key)) tabs.delete(key)
+      })
+    },
+  )
+
+  const count = (session: MountedSession, id: string) =>
+    turnSources(turnMessages(session.server.data.session.message.list(session.id), id)).sources.length
+
+  ctx.add(LinkHandler, {
+    match: (link) => sourcesExperiment.enabled && link.origin === ctx.id && !!link.session,
+    open(link) {
+      if (link.session) ctx.layout.open(`${ctx.id}:${link.href}`, link.session, { tab: "select" })
+    },
+  })
+
+  ctx.add(Panel, {
+    id: "turn",
+    region: "side",
+    transient: true,
+    // mobile(M-036): the narrow-screen More-drawer entry, before goal (order 70). The render
+    // receives the panel's id as the tab id on this path; the tab shows the most recent turn
+    // with sources, or an honest empty state while the experiment is off (registered delta;
+    // see units/gui-extensions.md).
+    mobile: {
+      get title() {
+        return ctx.t("panel.title")
+      },
+      order: 60,
+      kind: "menu",
+    },
+    list: (input) => {
+      if (!sourcesExperiment.enabled) {
+        tabs.delete(input.session.key)
+
+        return []
+      }
+
+      const cache = tabs.get(input.session.key) ?? new Map<string, PanelTab>()
+      tabs.set(input.session.key, cache)
+
+      return input.open.map((id) => {
+        const existing = cache.get(id)
+
+        if (existing) return existing
+
+        const tab: PanelTab = {
+          id,
+          get title() {
+            return ctx.t("tab.count", { count: count(input.session, id) })
+          },
+          label: (state) => {
+            const total = createMemo(() => count(state.session, id))
+
+            return <SourcesTitle count={total()} />
+          },
+        }
+
+        cache.set(id, tab)
+
+        return tab
+      })
+    },
+    render: (props) => (
+      // mobile(M-036): the gate-off fallback renders an honest empty state instead of the upstream
+      // blank face — the fallback is only reachable on the narrow-screen mobile view, whose More
+      // drawer entry always exists (registered delta; see units/gui-extensions.md).
+      <Show when={sourcesExperiment.enabled} fallback={<div class="flex h-full items-center justify-center p-4 text-v2-text-text-muted">{ctx.t("panel.disabled")}</div>}>
+        <Suspense>
+          <SourcesTab session={props.session} from={props.tab.id} />
+        </Suspense>
+      </Show>
+    ),
+    close: (input) => {
+      tabs.get(input.session.key)?.delete(input.tab.id)
+    },
+  })
+}
+
+export default setup
