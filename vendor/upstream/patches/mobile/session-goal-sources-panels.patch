+++ b/packages/session-ui/src/sources/sources.test.ts
@@ -0,0 +1,172 @@
+import type { SessionMessageAssistant, SessionMessageAssistantTool, SessionMessageInfo } from "@opencode/client/promise"
+import { describe, expect, test } from "bun:test"
+import { turnMessages, turnSources } from "./sources"
+
+const model = { id: "claude-sonnet-4", providerID: "anthropic" }
+
+// The text content the websearch tool writes for its results (packages/core/src/tool/plugin/websearch.ts).
+const searchText = (results: { url: string; title?: string; content?: string }[]) =>
+  results.length
+    ? results
+        .map(
+          (result) =>
+            `## [${result.title ?? result.url}](${result.url})${result.content ? `\n\n${result.content}` : ""}`,
+        )
+        .join("\n\n")
+    : "No search results found. Please try a different query."
+
+const search = (id: string, query: string, results: { url: string; title?: string; content?: string }[]) =>
+  ({
+    type: "tool",
+    id,
+    name: "websearch",
+    state: {
+      status: "completed",
+      input: { query },
+      content: [{ type: "text", text: searchText(results) }],
+      metadata: { provider: "exa" },
+    },
+    time: { created: 1, ran: 2, completed: 3 },
+  }) satisfies SessionMessageAssistantTool
+
+const fetch = (id: string, url: string, error?: string) =>
+  ({
+    type: "tool",
+    id,
+    name: "webfetch",
+    state: error
+      ? { status: "error", input: { url, format: "markdown" }, error: { type: "ToolExecutionError", message: error } }
+      : { status: "completed", input: { url, format: "markdown" }, content: [{ type: "text", text: "# Page" }] },
+    time: { created: 1, ran: 2, completed: 3 },
+  }) satisfies SessionMessageAssistantTool
+
+const assistant = (id: string, content: SessionMessageAssistant["content"]): SessionMessageAssistant => ({
+  id,
+  type: "assistant",
+  agent: "build",
+  model,
+  content,
+  time: { created: 1, completed: 4 },
+})
+
+describe("turnSources", () => {
+  test("lists searches and fetches across the turn's messages in the order they ran", () => {
+    const value = turnSources([
+      assistant("msg_1", [
+        { type: "text", text: "Looking." },
+        search("call_1", "one million checkboxes", [
+          { url: "https://eieio.games/blog/one-million-checkboxes", title: "One Million Checkboxes" },
+        ]),
+        {
+          type: "tool",
+          id: "call_read",
+          name: "read",
+          state: { status: "completed", input: {}, content: [{ type: "text", text: "x" }] },
+          time: { created: 1 },
+        },
+      ]),
+      assistant("msg_2", [fetch("call_2", "https://www.nytimes.com/2024/07/03/technology/checkboxes.html")]),
+    ])
+
+    expect(value.steps.map((step) => [step.type, step.id])).toEqual([
+      ["search", "call_1"],
+      ["fetch", "call_2"],
+    ])
+    expect(value.steps[0]).toMatchObject({
+      query: "one million checkboxes",
+      status: "completed",
+      results: [{ title: "One Million Checkboxes", site: "eieio.games" }],
+    })
+    expect(value.steps[1]).toMatchObject({
+      site: "nytimes.com",
+      host: "www.nytimes.com",
+      path: "/2024/07/03/technology/checkboxes.html",
+    })
+  })
+
+  test("counts each page once, however its URL was written", () => {
+    const value = turnSources([
+      assistant("msg_1", [
+        search("call_1", "a", [
+          { url: "https://eieio.games/", title: "eieio" },
+          { url: "https://example.com/post?id=1" },
+        ]),
+        search("call_2", "b", [
+          { url: "https://www.eieio.games", title: "eieio again" },
+          { url: "http://example.com/post?id=1#top" },
+          { url: "https://example.com/post?id=2" },
+        ]),
+        fetch("call_3", "https://eieio.games/"),
+      ]),
+    ])
+
+    expect(value.sources.map((source) => source.url)).toEqual([
+      "https://eieio.games/",
+      "https://example.com/post?id=1",
+      "https://example.com/post?id=2",
+    ])
+  })
+
+  test("keeps a title only when the tool had one, and skips headings that aren't web links", () => {
+    const [step] = turnSources([
+      assistant("msg_1", [
+        search("call_1", "titles", [
+          { url: "https://example.com/a" },
+          { url: "https://example.com/b", title: "Notes [draft](v2)", content: "## [Not a result](file:///etc/hosts)" },
+        ]),
+      ]),
+    ]).steps
+
+    expect(step?.type === "search" ? step.results.map((result) => [result.url, result.title]) : []).toEqual([
+      ["https://example.com/a", undefined],
+      ["https://example.com/b", "Notes [draft](v2)"],
+    ])
+  })
+
+  test("reads empty and failed searches and failed fetches without inventing sources", () => {
+    const failed: SessionMessageAssistantTool = {
+      type: "tool",
+      id: "call_2",
+      name: "websearch",
+      state: {
+        status: "error",
+        input: { query: "rate limited" },
+        error: { type: "ToolExecutionError", message: "Web search rate limited (HTTP 429)" },
+      },
+      time: { created: 1, completed: 3 },
+    }
+
+    const value = turnSources([
+      assistant("msg_1", [
+        search("call_1", "nothing here", []),
+        failed,
+        fetch("call_3", "https://down.example.com/page", "Request failed with status code: 503"),
+      ]),
+    ])
+
+    expect(value.steps).toMatchObject([
+      { type: "search", status: "completed", results: [] },
+      { type: "search", status: "error", results: [], error: "Web search rate limited (HTTP 429)" },
+      { type: "fetch", status: "error", error: "Request failed with status code: 503" },
+    ])
+    expect(value.sources).toEqual([])
+  })
+})
+
+describe("turnMessages", () => {
+  test("takes the assistant messages after the prompt, up to the next prompt", () => {
+    const user = (id: string): SessionMessageInfo => ({ id, type: "user", text: id, time: { created: 1 } })
+
+    const messages = [
+      user("msg_u1"),
+      assistant("msg_a1", []),
+      assistant("msg_a2", []),
+      user("msg_u2"),
+      assistant("msg_a3", []),
+    ]
+
+    expect(turnMessages(messages, "msg_u1").map((message) => message.id)).toEqual(["msg_a1", "msg_a2"])
+    expect(turnMessages(messages, "msg_u2").map((message) => message.id)).toEqual(["msg_a3"])
+    expect(turnMessages(messages, "msg_missing")).toEqual([])
+  })
+})
diff --git a/packages/session-ui/src/sources/sources.ts b/packages/session-ui/src/sources/sources.ts
new file mode 100644
index 0000000..0b2ea7a
--- /dev/null
+++ b/packages/session-ui/src/sources/sources.ts
@@ -0,0 +1,141 @@
+import type { SessionMessageAssistant, SessionMessageAssistantTool, SessionMessageInfo } from "@opencode/client/promise"
+import { Option, Schema } from "effect"
+import { currentToolError, currentToolInput, currentToolOutput } from "../message/current-tool-state"
+
+const decodeQuery = Schema.decodeUnknownOption(Schema.Struct({ query: Schema.String }))
+
+const decodeURL = Schema.decodeUnknownOption(Schema.Struct({ url: Schema.String }))
+
+export type SourceResult = {
+  url: string
+  title?: string
+  /** The hostname without `www.`, as shown and as the letter tile's seed. */
+  site: string
+  /** The full hostname, where its favicon lives. */
+  host: string
+}
+
+type StepStatus = "running" | "completed" | "error"
+
+export type SourceStep =
+  | { type: "search"; id: string; query: string; status: StepStatus; results: SourceResult[]; error?: string }
+  | ({ type: "fetch"; id: string; path: string; status: StepStatus; error?: string } & SourceResult)
+
+export type TurnSources = {
+  steps: SourceStep[]
+  /** Distinct sources in the order the turn met them: search results and opened pages, deduped by URL. */
+  sources: SourceResult[]
+}
+
+/** The web searches and page fetches of one turn's assistant messages, in the order they ran. */
+export function turnSources(messages: readonly SessionMessageAssistant[]): TurnSources {
+  const steps = messages.flatMap((message) => message.content.flatMap((content) => step(content)))
+  const seen = new Set<string>()
+
+  const sources = steps
+    .flatMap((item) => (item.type === "search" ? item.results : item.status === "error" ? [] : [item]))
+    .filter((item) => {
+      const key = identity(item.url)
+
+      if (seen.has(key)) return false
+      seen.add(key)
+
+      return true
+    })
+
+  return { steps, sources }
+}
+
+/** The assistant messages of the turn a user message opened, grouped as the timeline groups them. */
+export function turnMessages(messages: readonly SessionMessageInfo[], from: string) {
+  const start = messages.findIndex((message) => message.id === from)
+
+  if (start === -1) return []
+
+  const end = messages.findIndex(
+    (message, index) => index > start && (message.type === "user" || message.type === "shell"),
+  )
+
+  return messages
+    .slice(start + 1, end === -1 ? undefined : end)
+    .filter((message): message is SessionMessageAssistant => message.type === "assistant")
+}
+
+function step(content: SessionMessageAssistant["content"][number]): SourceStep[] {
+  if (content.type !== "tool" || content.state.status === "streaming") return []
+
+  if (content.name === "websearch") return [search(content)]
+
+  if (content.name !== "webfetch") return []
+
+  const page = Option.getOrUndefined(
+    decodeURL(currentToolInput(content)).pipe(Option.flatMapNullishOr((input) => source(input.url))),
+  )
+
+  if (!page) return []
+
+  return [
+    {
+      type: "fetch",
+      id: content.id,
+      ...page,
+      path: path(page.url),
+      status: content.state.status,
+      error: currentToolError(content),
+    },
+  ]
+}
+
+function search(tool: SessionMessageAssistantTool): SourceStep {
+  return {
+    type: "search",
+    id: tool.id,
+    query: Option.match(decodeQuery(currentToolInput(tool)), { onNone: () => "", onSome: (input) => input.query }),
+    status: tool.state.status === "streaming" ? "running" : tool.state.status,
+    results: tool.state.status === "completed" ? results(currentToolOutput(tool) ?? "") : [],
+    error: currentToolError(tool),
+  }
+}
+
+// The websearch tool keeps its structured results out of the message and writes each one as a `## [title](url)`
+// heading in its text content (packages/core/src/tool/plugin/websearch.ts); a result without a title repeats its URL.
+function results(text: string) {
+  return text.split("\n").flatMap((line): SourceResult[] => {
+    if (!line.startsWith("## [") || !line.endsWith(")")) return []
+
+    const split = line.lastIndexOf("](")
+
+    if (split < 4) return []
+
+    const result = source(line.slice(split + 2, -1))
+
+    if (!result) return []
+
+    const title = line.slice(4, split).trim()
+
+    return [{ ...result, title: title && title !== result.url ? title : undefined }]
+  })
+}
+
+function source(url: string): SourceResult | undefined {
+  if (!URL.canParse(url)) return undefined
+
+  const parsed = new URL(url)
+
+  if (parsed.protocol !== "https:" && parsed.protocol !== "http:") return undefined
+
+  return { url, host: parsed.hostname, site: parsed.hostname.replace(/^www\./, "") }
+}
+
+// One source per page: the scheme, `www.`, a trailing slash and the fragment don't make another.
+function identity(url: string) {
+  const parsed = new URL(url)
+
+  return `${parsed.hostname.replace(/^www\./, "")}${parsed.pathname.replace(/\/+$/, "")}${parsed.search}`
+}
+
+function path(url: string) {
+  const parsed = new URL(url)
+
+  return `${parsed.pathname.replace(/\/+$/, "")}${parsed.search}`
+}
