-  color-scheme: light;
-  --text-mix-blend-mode: multiply;
-
-  ${lightCss}
-
-  @media (prefers-color-scheme: dark) {
-    color-scheme: dark;
-    --text-mix-blend-mode: plus-lighter;
-
-    ${darkCss}
-  }
-}
-`
-  }
-
