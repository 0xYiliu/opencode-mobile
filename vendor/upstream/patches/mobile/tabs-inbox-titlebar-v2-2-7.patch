diff --git a/packages/app/src/shell/back-chain.ts b/packages/app/src/shell/back-chain.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c154a3216b3083e6c3a62d17f50c33d8864b2d7e
--- /dev/null
+++ b/packages/app/src/shell/back-chain.ts
@@ -0,0 +1,78 @@
+// mobile(tabs-inbox-titlebar-v2-2-7): the in-app back chain for the Android bridge.
+//
+// The native shell offers one request to this synchronous registry. Layers are tried from
+// the topmost visible surface down; the first explicit true consumes one press. A decline
+// leaves the native canGoBack/goBack fallback unchanged. This module deliberately has no
+// navigation product or session side effects: it only closes the surface that already owns
+// the current state.
+
+export type BackLayer = () => boolean
+
+export const BACK_LAYER_ORDER = {
+  dialog: 10,
+  popover: 15,
+  panelDrawer: 20,
+  dockPanel: 30,
+  titlebarMore: 40,
+  goBack: 90,
+} as const
+
+const layers: Array<{ order: number; consume: BackLayer }> = []
+
+export function registerBackLayer(order: number, consume: BackLayer): () => void {
+  const entry = { order, consume }
+  layers.push(entry)
+  layers.sort((a, b) => a.order - b.order)
+
+  return () => {
+    const index = layers.indexOf(entry)
+    if (index !== -1) layers.splice(index, 1)
+  }
+}
+
+export function consumeBackChain(): boolean {
+  for (const layer of layers) {
+    try {
+      if (layer.consume() === true) return true
+    } catch {
+      // A failed layer declines. The next visible layer or native fallback still gets a turn.
+    }
+  }
+
+  return false
+}
+
+export function backLayerOrders(): number[] {
+  return layers.map((layer) => layer.order)
+}
+
+/** Live open-state sentinels for Kobalte menus/popovers and the details flyout. */
+export const POPOVER_OPEN_SELECTOR =
+  '[role="menu"], [role="dialog"][data-expanded], .session-service-flyout[data-open]'
+
+/** Close one open floating surface through the existing Escape handlers. */
+export function consumePopoverSurface(doc: Document): boolean {
+  if (!doc.querySelector(POPOVER_OPEN_SELECTOR)) return false
+  doc.dispatchEvent(new KeyboardEvent("keydown", { key: "Escape" }))
+  return true
+}
+
+export interface DockFaces {
+  desktop: boolean
+  side: { opened(): boolean; toggle(): void }
+  bottom: { opened(): boolean; setOpened(open: boolean): void }
+}
+
+/** Close exactly one existing wide-screen dock surface, side before bottom. */
+export function consumeDockPanel(faces: DockFaces): boolean {
+  if (!faces.desktop) return false
+  if (faces.side.opened()) {
+    faces.side.toggle()
+    return true
+  }
+  if (faces.bottom.opened()) {
+    faces.bottom.setOpened(false)
+    return true
+  }
+  return false
+}
diff --git a/packages/app/src/shell/back-chain.test.ts b/packages/app/src/shell/back-chain.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..621ed341d35d0f62f8207734be8162a0c46a3b8d
--- /dev/null
+++ b/packages/app/src/shell/back-chain.test.ts
@@ -0,0 +1,132 @@
+import { describe, expect, test } from "bun:test"
+import {
+  BACK_LAYER_ORDER,
+  backLayerOrders,
+  consumeBackChain,
+  consumeDockPanel,
+  consumePopoverSurface,
+  registerBackLayer,
+  type DockFaces,
+} from "./back-chain"
+
+describe("android back chain", () => {
+  test("declines when no layer owns the press", () => {
+    expect(consumeBackChain()).toBe(false)
+  })
+
+  test("uses layer order and stops after one consuming layer", () => {
+    const visited: string[] = []
+    const removeDialog = registerBackLayer(BACK_LAYER_ORDER.dialog, () => {
+      visited.push("dialog")
+      return true
+    })
+    const removeHistory = registerBackLayer(BACK_LAYER_ORDER.goBack, () => {
+      visited.push("history")
+      return true
+    })
+
+    expect(consumeBackChain()).toBe(true)
+    expect(visited).toEqual(["dialog"])
+
+    removeHistory()
+    removeDialog()
+    expect(backLayerOrders()).toEqual([])
+  })
+
+  test("a throwing layer declines without blocking the next layer", () => {
+    const removeThrowing = registerBackLayer(10, () => {
+      throw new Error("broken layer")
+    })
+    const removeFallback = registerBackLayer(90, () => true)
+
+    expect(consumeBackChain()).toBe(true)
+
+    removeFallback()
+    removeThrowing()
+  })
+
+  test("keeps the canonical one-layer order", () => {
+    expect(BACK_LAYER_ORDER.dialog).toBeLessThan(BACK_LAYER_ORDER.popover)
+    expect(BACK_LAYER_ORDER.popover).toBeLessThan(BACK_LAYER_ORDER.panelDrawer)
+    expect(BACK_LAYER_ORDER.panelDrawer).toBeLessThan(BACK_LAYER_ORDER.dockPanel)
+    expect(BACK_LAYER_ORDER.dockPanel).toBeLessThan(BACK_LAYER_ORDER.titlebarMore)
+    expect(BACK_LAYER_ORDER.titlebarMore).toBeLessThan(BACK_LAYER_ORDER.goBack)
+  })
+})
+
+describe("floating surfaces", () => {
+  test("only live popover markers consume", () => {
+    const menu = document.createElement("div")
+    menu.setAttribute("role", "menu")
+    document.body.appendChild(menu)
+
+    let escaped = false
+    const listener = (event: Event) => {
+      escaped = (event as KeyboardEvent).key === "Escape"
+    }
+    document.addEventListener("keydown", listener)
+
+    expect(consumePopoverSurface(document)).toBe(true)
+    expect(escaped).toBe(true)
+
+    menu.remove()
+    document.removeEventListener("keydown", listener)
+    expect(consumePopoverSurface(document)).toBe(false)
+  })
+
+  test("mounted closed faces do not consume", () => {
+    const popover = document.createElement("div")
+    popover.setAttribute("role", "dialog")
+    popover.setAttribute("data-closed", "")
+    document.body.appendChild(popover)
+
+    expect(consumePopoverSurface(document)).toBe(false)
+
+    popover.setAttribute("data-expanded", "")
+    expect(consumePopoverSurface(document)).toBe(true)
+    popover.remove()
+  })
+})
+
+describe("dock surfaces", () => {
+  const faces = (desktop: boolean, side: boolean, bottom: boolean) => {
+    const state = { sideClosed: false, bottomClosed: false }
+    const value: DockFaces = {
+      desktop,
+      side: {
+        opened: () => side,
+        toggle: () => {
+          state.sideClosed = true
+        },
+      },
+      bottom: {
+        opened: () => bottom,
+        setOpened: (open) => {
+          state.bottomClosed = !open
+        },
+      },
+    }
+    return { value, state }
+  }
+
+  test("closes side before bottom and never both", () => {
+    const { value, state } = faces(true, true, true)
+    expect(consumeDockPanel(value)).toBe(true)
+    expect(state).toEqual({ sideClosed: true, bottomClosed: false })
+  })
+
+  test("closes the bottom dock when side is closed", () => {
+    const { value, state } = faces(true, false, true)
+    expect(consumeDockPanel(value)).toBe(true)
+    expect(state.bottomClosed).toBe(true)
+  })
+
+  test("does not close a dock on a narrow layout", () => {
+    const { value, state } = faces(false, true, true)
+    expect(consumeDockPanel(value)).toBe(false)
+    expect(state).toEqual({ sideClosed: false, bottomClosed: false })
+  })
+})
+
+// Keep the negative contract visible: this module never calls session interrupt/abort,
+// inbox cancel, pty removal, or process kill. Back only consumes an owned UI surface.
