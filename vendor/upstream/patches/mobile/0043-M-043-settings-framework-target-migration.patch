@@ -0,0 +1,82 @@
+import { Button } from "@opencode/ui/button"
+import { Icon } from "@opencode/ui/icon"
+import { Menu } from "@opencode/ui/menu"
+import { For, Show } from "solid-js"
+import { useLanguage } from "@/runtime/i18n/language"
+import { useGlobal } from "@/runtime/server/runtime"
+import type { ServerHealth } from "@/runtime/server/health"
+import { ServerHealthIndicator } from "@/servers/registry/row"
+import { ServerLabel } from "@/servers/registry/label"
+import { useSettingsSurface } from "@/settings/surface"
+import { settingsServerReachable, useSettingsServers, type SettingsServer } from "./inventory"
+
+/** Chooses the server per-server pages show; renders nothing with one server. */
+export function SettingsServerSwitcher() {
+  const language = useLanguage()
+  const global = useGlobal()
+  const surface = useSettingsSurface()
+  const servers = useSettingsServers()
+  const health = (server: SettingsServer) => global.servers.health[server.key]
+  const unreachable = (server: SettingsServer) => !settingsServerReachable(server, health(server))
+
+  return (
+    <Show when={servers().length > 1 && surface.server()}>
+      {(selected) => (
+        <Menu placement="bottom-end" gutter={6} modal={false}>
+          <Menu.Trigger
+            as={Button}
+            size="small"
+            variant="outline"
+            class="settings-server-switcher"
+            data-action="settings-server-select"
+          >
+            <ServerDot health={health(selected())} unreachable={unreachable(selected())} />
+            <span class="settings-server-switcher-label">{language.t("settings.server.switcher.label")}</span>
+            <ServerLabel
+              class="settings-server-switcher-name"
+              server={selected().connection}
+              name={selected().name}
+            />
+            <Icon name="chevron-down" class="settings-server-switcher-chevron" />
+          </Menu.Trigger>
+          <Menu.Portal>
+            <Menu.Content class="settings-server-switcher-menu">
+              <Menu.RadioGroup value={selected().key} onChange={(key) => surface.selectServer(key)}>
+                <For each={servers()}>
+                  {(server) => (
+                    <Menu.RadioItem value={server.key} closeOnSelect>
+                      <ServerDot health={health(server)} unreachable={unreachable(server)} />
+                      <ServerLabel class="settings-server-switcher-option" server={server.connection} name={server.name} hint />
+                      <Show when={unreachable(server)}>
+                        <span class="settings-server-switcher-status">
+                          {language.t("settings.server.switcher.unreachable")}
+                        </span>
+                      </Show>
+                    </Menu.RadioItem>
+                  )}
+                </For>
+              </Menu.RadioGroup>
+              <Menu.Separator />
+              <Menu.Item onSelect={() => surface.select("servers")}>
+                <span class="settings-server-switcher-icon">
+                  <Icon name="server" />
+                </span>
+                {language.t("settings.server.switcher.manage")}
+              </Menu.Item>
+            </Menu.Content>
+          </Menu.Portal>
+        </Menu>
+      )}
+    </Show>
+  )
+}
+
+function ServerDot(props: { health: ServerHealth | undefined; unreachable: boolean }) {
+  const health = () => props.health ?? (props.unreachable ? { healthy: false } : undefined)
+
+  return (
+    <span class="settings-server-switcher-icon">
+      <ServerHealthIndicator health={health()} authenticationRequired={!!health()?.unauthorized} />
+    </span>
+  )
+}
diff --git a/packages/app/src/settings/servers/unavailable.tsx b/packages/app/src/settings/servers/unavailable.tsx
new file mode 100644
index 0000000..5004a33
--- /dev/null
+++ b/packages/app/src/settings/servers/unavailable.tsx
@@ -0,0 +1,86 @@
+import { Button } from "@opencode/ui/button"
+import { useDialog } from "@opencode/ui/context/dialog"
+import { Icon } from "@opencode/ui/icon"
+import type { JSX } from "solid-js"
+import { createStore } from "solid-js/store"
+import { useLanguage } from "@/runtime/i18n/language"
+import { useGlobal } from "@/runtime/server/runtime"
+import { ServerConnection } from "@/runtime/server/registry"
+import { DialogServer } from "@/servers/connect/dialog"
+import { SettingsList } from "@/settings/list"
+import type { SettingsServer } from "./inventory"
+import "@/settings/settings.css"
+
+/** A per-server page while its server is unreachable. */
+export function SettingsServerUnavailable(props: {
+  entry: SettingsServer
+  title: string
+  description: string
+  headerAction?: JSX.Element
+  /** Opens the Servers page, for servers this page cannot edit. */
+  onManage: () => void
+  onServerChange: (server: ServerConnection.Any) => void
+}) {
+  const language = useLanguage()
+  const dialog = useDialog()
+  const global = useGlobal()
+  const [state, setState] = createStore({ retrying: false })
+
+  const http = () =>
+    props.entry.connection?.type === "http" && !ServerConnection.builtin(props.entry.connection)
+      ? props.entry.connection
+      : undefined
+
+  const retry = () => {
+    setState("retrying", true)
+    void global.servers.retry().finally(() => setState("retrying", false))
+  }
+
+  const edit = () => {
+    const server = http()
+
+    if (!server) return props.onManage()
+    void dialog.push(() => <DialogServer mode="edit" server={server} onSave={props.onServerChange} />)
+  }
+
+  return (
+    <>
+      <div class="settings-tab-header">
+        <div class="settings-tab-header-row">
+          <div class="flex min-w-0 flex-col gap-1">
+            <h2 class="settings-tab-title">{props.title}</h2>
+            <span class="text-11-regular text-v2-text-text-muted">{props.description}</span>
+          </div>
+          <div class="settings-tab-header-actions">{props.headerAction}</div>
+        </div>
+      </div>
+      <div class="settings-tab-body">
+        <SettingsList>
+          <div class="settings-server-unavailable" role="status">
+            <Icon name="outline-hexagonal-warning" class="settings-server-unavailable-icon" />
+            <div class="settings-server-unavailable-title">
+              {language.t("settings.server.unreachable.title", { server: props.entry.name })}
+            </div>
+            <div class="settings-server-unavailable-description">
+              {language.t("settings.server.unreachable.description", { server: props.entry.name })}
+            </div>
+            <div class="settings-server-unavailable-actions">
+              <Button
+                size="normal"
+                variant="neutral"
+                icon="refresh"
+                disabled={state.retrying}
+                onClick={retry}
+              >
+                {language.t("settings.server.unreachable.retry")}
+              </Button>
+              <Button size="normal" variant="ghost-muted" onClick={edit}>
+                {language.t("settings.server.unreachable.edit")}
+              </Button>
+            </div>
+          </div>
+        </SettingsList>
+      </div>
+    </>
+  )
+}
