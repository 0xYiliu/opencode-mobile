+import { createMemo, For, lazy, Show, Suspense, type JSX } from "solid-js"
+import { createStore } from "solid-js/store"
+import { Tabs } from "@opencode/ui/tabs"
+import { Icon } from "@opencode/ui/icon"
+import { Panel, type PanelSidebar, type PanelTab, type MountedSession, type SessionScreen } from "@opencode/plugin/gui"
+import { useLanguage } from "@/runtime/i18n/language"
+import { usePluginHost } from "./host"
+import { panelKey } from "./panel-keys"
+import { MobilePanel, type Region, type RegionEntry } from "./panels"
+
+const MobilePanelDrawer = lazy(async () => {
+  const { MobilePanelDrawer } = await import("@/shell/mobile-panel-drawer")
+
+  return { default: MobilePanelDrawer }
+})
+
+export type MobileEntry = RegionEntry & { readonly mobile: NonNullable<Panel["mobile"]> }
+
+/** Panels that offer a narrow-screen view, keyed `${plugin}:${panel id}`. */
+export function createMobileViews() {
+  const host = usePluginHost()
+
+  const entries = createMemo(() =>
+    host.items(Panel).flatMap((item): MobileEntry[] => {
+      const mobile = item.value.mobile
+
+      if (!mobile) return []
+      const tab: PanelTab = { id: item.value.id, title: mobile.title }
+
+      return [{ key: panelKey(item.plugin, item.value.id), plugin: item.plugin, tab, provider: item.value, mobile }]
+    }),
+  )
+
+  const sorted = (kinds: readonly string[]) =>
+    entries()
+      .filter((entry) => kinds.includes(entry.mobile.kind))
+      .toSorted((a, b) => a.mobile.order - b.mobile.order)
+
+  return {
+    entries,
+    tabs: createMemo(() => sorted(["tab"])),
+    menu: createMemo(() => sorted(["menu", "drawer"])),
+    find: (key: string) => entries().find((entry) => entry.key === key),
+  }
+}
+
+export type MobileViews = ReturnType<typeof createMobileViews>
+
+/** The narrow-screen view switcher: the conversation, each tab view, and a More drawer with the other views. */
+export function MobileViewTabs(props: {
+  views: MobileViews
+  region: Region
+  current: string
+  session: MountedSession
+  screen: SessionScreen
+  sidebar: PanelSidebar
+  bottom?: boolean
+  onSelect: (key: string) => void
+}): JSX.Element {
+  const language = useLanguage()
+
+  const [store, setStore] = createStore<{
+    open: boolean
+    loaded: boolean
+    drawer: string | undefined
+  }>({
+    open: false,
+    loaded: false,
+    drawer: undefined,
+  })
+
+  const drawer = createMemo(() => (store.drawer ? props.views.find(store.drawer) : undefined))
+
+  const tab = createMemo(() =>
+    props.current === "session" || props.views.tabs().some((entry) => entry.key === props.current)
+      ? props.current
+      : "more",
+  )
+
+  let trigger: HTMLButtonElement | undefined
+
+  return (
+    <div
+      class="relative flex shrink-0 items-center before:pointer-events-none before:absolute before:inset-x-0 before:h-px before:bg-v2-border-border-base before:content-['']"
+      classList={{ "before:top-0": props.bottom, "before:bottom-0": !props.bottom }}
+      data-slot="session-mobile-view-navigation"
+    >
+      <Tabs value={tab()} variant="line" class="!h-auto min-w-0 flex-1" data-slot="session-mobile-view-tabs">
+        <Tabs.List aria-label={language.t("session.view.select")} class="!h-9 !gap-0 !px-0 before:!hidden">
+          <Tabs.Trigger
+            value="session"
+            class="min-w-0 flex-1"
+            classes={{ button: "w-full justify-center" }}
+            onClick={() => props.onSelect("session")}
+          >
+            {language.t("session.tab.session")}
+          </Tabs.Trigger>
+          <For each={props.views.tabs()}>
+            {(entry) => (
+              <Tabs.Trigger
+                value={entry.key}
+                class="min-w-0 flex-1"
+                classes={{ button: "w-full justify-center" }}
+                onClick={() => props.onSelect(entry.key)}
+              >
+                {entry.mobile.title}
+              </Tabs.Trigger>
+            )}
+          </For>
+          <Show when={props.views.menu().length}>
+            <Tabs.Trigger
+              value="more"
+              ref={(element: HTMLButtonElement) => {
+                trigger = element
+              }}
+              class="min-w-0 flex-1"
+              classes={{ button: "w-full justify-center" }}
+              aria-haspopup="dialog"
+              aria-expanded={store.open}
+              onClick={() => setStore({ open: true, loaded: true, drawer: undefined })}
+            >
+              {language.t("session.tab.more")}
+            </Tabs.Trigger>
+          </Show>
+        </Tabs.List>
+      </Tabs>
+      <Show when={store.loaded}>
+        <Suspense>
+          <MobilePanelDrawer
+            title={drawer()?.mobile.title ?? language.t("common.moreOptions")}
+            hideHeader
+            open={store.open}
+            onOpenChange={(open) => setStore("open", open)}
+            returnFocus={() => trigger}
+          >
+            <Show
+              when={drawer()}
+              keyed
+              fallback={
+                <div
+                  data-slot="session-mobile-view-options"
+                  class="flex flex-col gap-0.5 rounded-[6px] bg-v2-background-bg-base p-0.5 shadow-[var(--v2-elevation-raised)] [[data-color-scheme=dark]_&]:bg-v2-background-bg-layer-01"
+                >
+                  <For each={props.views.menu().filter((entry) => entry.mobile.kind === "menu")}>
+                    {(entry) => (
+                      <button
+                        type="button"
+                        class="flex min-h-11 w-full items-center gap-2 rounded-[4px] py-1 ps-3 pe-2 text-start text-[13px] font-[440] leading-[var(--line-height-base)] text-v2-text-text-base hover:bg-[var(--v2-overlay-simple-overlay-hover)] focus-visible:outline-none focus-visible:bg-[var(--v2-overlay-simple-overlay-hover)] aria-pressed:bg-[var(--v2-overlay-simple-overlay-pressed)]"
+                        aria-pressed={props.current === entry.key}
+                        onClick={() => {
+                          props.onSelect(entry.key)
+                          setStore("open", false)
+                        }}
+                      >
+                        <Show when={entry.mobile.icon}>
+                          {(icon) => <Icon name={icon()} class="shrink-0 text-v2-icon-icon-muted" />}
+                        </Show>
+                        <span class="min-w-0 flex-1 truncate">{entry.mobile.title}</span>
+                        <Show when={props.current === entry.key}>
+                          <Icon name="check" class="ms-1 shrink-0 text-v2-icon-icon-muted" />
+                        </Show>
+                      </button>
+                    )}
+                  </For>
+                  <For each={props.views.menu().filter((entry) => entry.mobile.kind === "drawer")}>
+                    {(entry) => (
+                      <button
+                        type="button"
+                        class="flex min-h-11 w-full items-center gap-2 rounded-[4px] py-1 ps-3 pe-2 text-start text-[13px] font-[440] leading-[var(--line-height-base)] text-v2-text-text-base hover:bg-[var(--v2-overlay-simple-overlay-hover)] focus-visible:outline-none focus-visible:bg-[var(--v2-overlay-simple-overlay-hover)]"
+                        onClick={() => setStore("drawer", entry.key)}
+                      >
+                        <Show when={entry.mobile.icon}>
+                          {(icon) => <Icon name={icon()} class="shrink-0 text-v2-icon-icon-muted" />}
+                        </Show>
+                        <span class="min-w-0 flex-1 truncate">{entry.mobile.title}</span>
+                        <Icon name="chevron-right" class="ms-1 shrink-0 text-v2-icon-icon-muted" />
+                      </button>
+                    )}
+                  </For>
+                </div>
+              }
+            >
+              {(entry) => (
+                <MobilePanel
+                  entry={entry}
+                  view={props.session}
+                  screen={props.screen}
+                  sidebar={props.sidebar}
+                  visible={store.open}
+                  open={() => props.region.openFor(entry.plugin)}
+                />
+              )}
+            </Show>
+          </MobilePanelDrawer>
+        </Suspense>
+      </Show>
+    </div>
+  )
+}
diff --git a/packages/app/src/runtime/plugin/module.ts b/packages/app/src/runtime/plugin/module.ts
new file mode 100644
index 0000000..2fdadcd
--- /dev/null
+++ b/packages/app/src/runtime/plugin/module.ts
@@ -0,0 +1,64 @@
+import {
+  evaluatePluginBundle,
+  inertModule,
+  mainOnlyModule,
+  type PluginModule,
+  type Entry,
+} from "@opencode/plugin/gui/host"
+
+// Plugin bundles share the host's module instances, so tokens, contexts and schemas they import are the same objects
+// the host checks against. In a window, the main SDK's name resolves to the window SDK.
+const modules = {
+  effect: () => import("effect"),
+  "@opencode/plugin/gui": () => import("@opencode/plugin/gui"),
+  "@opencode/plugin/gui/main": () => import("@opencode/plugin/gui"),
+  "@opencode/plugin/gui/file": () => import("@opencode/plugin/gui/file"),
+  "@opencode/plugin/gui/review": () => import("@opencode/plugin/gui/review"),
+  "@opencode/plugin/gui/browser": () => import("@opencode/plugin/gui/browser"),
+  "@opencode/plugin/rpc": () => import("@opencode/plugin/rpc"),
+  "@opencode/schema/rpc": () => import("@opencode/schema/rpc"),
+  "@opencode/client": () => import("@opencode/client"),
+  "@opencode/client/effect": () => import("@opencode/client/effect"),
+  "@opencode/client/solid": () => import("@opencode/client/solid"),
+  "solid-js": () => import("solid-js"),
+  "solid-js/web": () => import("solid-js/web"),
+  "solid-js/store": () => import("solid-js/store"),
+} satisfies Record<PluginModule, () => Promise<object>>
+
+/**
+ * Builds a host `Entry` for a plugin's `./gui-experimental` bundle, read from the desktop app's own server. The
+ * bundle is evaluated here so the host reads its `Plugin.define` declarations (`os`, `stores`, `i18n`) before it
+ * activates the plugin. A plugin with only a `main` setup gets an empty window setup, so it still lists as active. It
+ * takes the server plugin's id. A bundle that fails to evaluate becomes an entry that fails, so Extensions › Plugins
+ * reports it.
+ */
+export async function pluginDefinition(id: string, code: string): Promise<Entry> {
+  const loaded = new Map<string, object>(
+    await Promise.all(Object.entries(modules).map(async ([name, load]) => [name, await load()] as const)),
+  )
+
+  const bundle = await Promise.try(() =>
+    evaluatePluginBundle(code, {
+      process: "window",
+      require: (name) => {
+        const module = loaded.get(name)
+
+        if (module) return module
+
+        if (mainOnlyModule(name)) return inertModule(name)
+
+        throw new Error(`Plugin GUI bundle requires a module the app does not share: ${name}`)
+      },
+    }),
+  ).then(
+    (value) => ({ ok: true as const, value }),
+    (cause: unknown) => ({ ok: false as const, cause }),
+  )
+
+  if (!bundle.ok) return { id, windowEntry: () => Promise.reject(bundle.cause) }
+
+  const setup = bundle.value.setup
+
+  // A setup's returned cleanup reaches the host, which runs it when the plugin goes away.
+  return { ...bundle.value.definition, id, windowEntry: async () => ({ default: (ctx: never) => setup?.(ctx) }) }
+}
diff --git a/packages/app/src/runtime/plugin/mounted-session.ts b/packages/app/src/runtime/plugin/mounted-session.ts
new file mode 100644
index 0000000..58650d4
--- /dev/null
+++ b/packages/app/src/runtime/plugin/mounted-session.ts
@@ -0,0 +1,353 @@
+import {
+  batch,
+  createMemo,
+  createEffect,
+  createRenderEffect,
+  createRoot,
+  createSignal,
+  getOwner,
+  on,
+  onCleanup,
+  untrack,
+  type Accessor,
+} from "solid-js"
+import type {
+  BackgroundTask,
+  Comments,
+  Composer,
+  Files,
+  LineRange,
+  ServerRef,
+  MountedSession,
+  SessionScreen,
+} from "@opencode/plugin/gui"
+import { useComments } from "@/composer/comments"
+import { createComposerEditorActions } from "@/composer/editor/actions"
+import { useComposerState } from "@/composer/persistence"
+import type { ComposerStateValue } from "@/composer/state"
+import { useLocal } from "@/providers/models/selection"
+import { useServer } from "@/runtime/server/current"
+import { ServerConnection, useServers } from "@/runtime/server/registry"
+import { sessionInWorkspace, sessionProject, type SessionModel } from "@/session/model"
+import { useFile } from "@/workspaces/files/model"
+import { useWorkspaceLocation } from "@/workspaces/location"
+import { pathKey } from "@/workspaces/path-key"
+import { usePluginAttachment } from "./host-apis"
+
+const noTasks: readonly BackgroundTask[] = []
+
+/** The root of the routed session's object, which ends when the screen routes another session. */
+type ObjectRoot = { dispose?: () => void }
+
+/**
+ * The routed session as plugins see it: one frozen object per routed session, a new one each time the screen
+ * routes another session, and the `SessionScreen` that owns the route-following files, comments and composer.
+ */
+export function createMountedSession(session: SessionModel) {
+  const file = useFile()
+  const comments = useComments()
+  const composer = useComposerState()
+  const local = useLocal()
+  const server = useServer()
+  const servers = useServers()
+  const location = useWorkspaceLocation()
+  const attachment = usePluginAttachment()
+  // The composer region owns background tasks and is created after the view.
+  const [background, setBackground] = createSignal<Accessor<readonly BackgroundTask[]>>()
+  // The screen's composer view, created after this object, says whether it takes quotes and focuses its prompt.
+  const [prompt, setPrompt] = createSignal<{ quotable: Accessor<boolean>; focus: () => void; focused: () => boolean }>()
+
+  const serverRef: ServerRef = {
+    get id() {
+      return server.key
+    },
+    get name() {
+      return servers.label(server.conn) || server.key
+    },
+    get url() {
+      return server.ctx.sdk.url
+    },
+    get password() {
+      return server.conn.http.password
+    },
+    get client() {
+      return server.ctx.sdk.api
+    },
+    get data() {
+      return server.ctx.data
+    },
+    get local() {
+      return server.isLocal
+    },
+    get builtin() {
+      return ServerConnection.builtin(server.conn)
+    },
+    get compatible() {
+      return !server.health?.incompatible
+    },
+    get connected() {
+      return server.ctx.sdk.connection.status() === "connected"
+    },
+  }
+
+  const files: Files = {
+    get root() {
+      return location().directory
+    },
+    ready: file.ready,
+    resolve: file.normalize,
+    absolute: file.absolute,
+    get: file.get,
+    missing: file.notFound,
+    sync: (path, options) => {
+      file.watch(path)
+
+      return file.load(path, options)
+    },
+    unwatch: file.unwatch,
+    exists: file.exists,
+    search: (query, options) =>
+      options?.kind === "any" ? file.searchFilesAndDirectories(query, options) : file.searchFiles(query, options),
+    selection: {
+      // SAFETY: the file model returns the view cache's selection for the path, which its schema types as a line range.
+      get: (path) => file.selectedLines(path) as LineRange | null | undefined,
+      set: (path, range) => void file.setSelectedLines(path, range),
+    },
+    scroll: {
+      get: (path) => ({
+        // SAFETY: the file model returns the view cache's offsets for the path, which its schema types as numbers.
+        top: file.scrollTop(path) as number | undefined,
+        // SAFETY: as above.
+        left: file.scrollLeft(path) as number | undefined,
+      }),
+      set(path, value) {
+        if (value.top !== undefined) file.setScrollTop(path, value.top)
+
+        if (value.left !== undefined) file.setScrollLeft(path, value.left)
+      },
+    },
+    tree: {
+      list: file.tree.children,
+      state: file.tree.state,
+      sync: (path, options) => (options?.force ? file.tree.refresh(path) : file.tree.list(path)),
+      expand: (path, options) => void file.tree.expand(path, options),
+      collapse: (path) => void file.tree.collapse(path),
+    },
+  }
+
+  const commentFile = (id: string) => comments.all().find((item) => item.id === id)?.file
+
+  const comment: Comments = {
+    list: (path) => (path ? comments.list(path) : comments.all()),
+    add: comments.add,
+    update(id, text) {
+      const path = commentFile(id)
+
+      if (path) comments.update(path, id, text)
+    },
+    remove(id) {
+      const path = commentFile(id)
+
+      if (path) comments.remove(path, id)
+    },
+    focus: { current: comments.focus, set: (value) => void comments.setFocus(value) },
+    active: { current: comments.active, set: (value) => void comments.setActive(value) },
+  }
+
+  // A write before the routed session's draft loads would replace the stored draft, so it waits for the load and then
+  // applies to that session. Later writes queue behind it to keep call order.
+  let writes: Promise<void> | undefined
+
+  const write = (apply: (draft: ComposerStateValue) => void) => {
+    const target = composer.capture()
+
+    if (!writes && composer.ready()) return apply(target)
+    const loaded = composer.ready() ? undefined : composer.ready.promise
+
+    const next = Promise.resolve(writes)
+      .then(() => loaded)
+      .catch(() => undefined)
+      .then(() => apply(target))
+
+    writes = next
+
+    const settle = () => {
+      if (writes === next) writes = undefined
+    }
+
+    void next.then(settle, settle)
+  }
+
+  // A subagent's session has no composer, so its draft is never sent.
+  const edit = (apply: (draft: ReturnType<typeof createComposerEditorActions>) => void) => {
+    if (!session.data.isChild()) write((target) => apply(createComposerEditorActions(target.store)))
+  }
+
+  const composerRef: Composer = {
+    text: () =>
+      session.data.isChild()
+        ? ""
+        : composer
+            .capture()
+            .current()
+            .map((part) => ("content" in part ? part.content : ""))
+            .join(""),
+    insert(text) {
+      const value = text.replace(/\r\n?/g, "\n")
+
+      if (value) edit((draft) => draft.addText(value))
+    },
+    setText: (value) => edit((draft) => draft.setText(value.replace(/\r\n?/g, "\n"))),
+    model() {
+      const item = session.data.isChild() ? undefined : local.model.current()
+
+      if (!item) return
+
+      return { providerID: item.provider.id, modelID: item.id, variant: local.model.variant.current() }
+    },
+    setModel(model) {
+      const item = session.data.isChild()
+        ? undefined
+        : local.model.list().find((entry) => entry.provider.id === model.providerID && entry.id === model.modelID)
+
+      if (!item || (model.variant !== undefined && !Object.keys(item.variants ?? {}).includes(model.variant)))
+        return false
+      // As the model picker selects: the model first, then a variant chosen with it.
+      local.model.set({ providerID: model.providerID, modelID: model.modelID }, { recent: true })
+
+      if (model.variant !== undefined) local.model.variant.set(model.variant)
+
+      return true
+    },
+    setVariant(variant) {
+      if (session.data.isChild() || !local.model.current()) return false
+
+      if (variant !== undefined && !local.model.variant.list().includes(variant)) return false
+      local.model.variant.set(variant)
+
+      return true
+    },
+    attach: (part) => write((draft) => draft.context.add(part)),
+    quotable: () => !!prompt()?.quotable(),
+    focus(commentID) {
+      if (commentID === undefined) return prompt()?.focus()
+
+      const item = composer.context.items().find((entry) => entry.type === "quote" && entry.commentID === commentID)
+
+      if (item) composer.capture().quoteComment.set(item.key)
+    },
+    update: (id, patch) => write((draft) => draft.context.updateComment(id, patch)),
+    detach: (id) => write((draft) => draft.context.removeComment(id)),
+    focused: () => !!prompt()?.focused(),
+  }
+
+  // Each object's memos live in its own root, which ends when the next object replaces it: a kept object stops
+  // updating `project`, `listedProject` and `local`, and its other fields keep reading this session's data.
+  const create = (input: { id: string; directory: string; tab: string; visit: object }): MountedSession => {
+    const id = input.id
+    const directory = input.directory
+    const info = () => server.ctx.data.session.get(id)
+
+    // Global sync adds the worktrees found on disk. Raw metadata stands in until global sync lists the project.
+    const project = createMemo(() => {
+      const value = info()
+
+      return (value && server.ctx.projects.forSession(value)) || sessionProject(server.ctx.data, value, directory)
+    })
+
+    // Only a project opened at this exact directory; a session in a project subfolder has none.
+    const listedProject = createMemo(() => {
+      const key = pathKey(directory)
+
+      return server.ctx.projects
+        .list()
+        .find((item) => pathKey(item.worktree) === key || item.sandboxes?.some((sandbox) => pathKey(sandbox) === key))
+    })
+
+    const local = createMemo(() => !sessionInWorkspace(server.ctx.sync.data.project, info(), directory))
+
+    const view: MountedSession = Object.freeze({
+      key: `${server.key}\n${id}`,
+      id,
+      tab: input.tab,
+      visit: input.visit,
+      server: serverRef,
+      get pending() {
+        return server.ctx.data.session.creating(id)
+      },
+      get location() {
+        return info()?.location
+      },
+      get project() {
+        return project()
+      },
+      get listedProject() {
+        return listedProject()
+      },
+      directory,
+      get local() {
+        return local()
+      },
+      // The composer region serves the routed session only.
+      get background() {
+        return mounted() === view ? (background()?.() ?? noTasks) : noTasks
+      },
+    })
+
+    return view
+  }
+
+  // One object while this screen is mounted, whichever session it routes: its models follow the route.
+  const screen: SessionScreen = Object.freeze({
+    file: files,
+    comment,
+    composer: composerRef,
+  })
+
+  const owner = getOwner()
+  const root: ObjectRoot = {}
+
+  onCleanup(() => root.dispose?.())
+
+  // A new object for each routed session, and for the same session once it moves to another directory or its shell tab
+  // is known: its fields never change. A moment without an id keeps the last one. A move is the same routing visit.
+  const mounted = createMemo<MountedSession>((previous) => {
+    const id = session.identity.sessionID() ?? ""
+    const directory = session.workspace.directory()
+    const tab = session.layout.tabKey() ?? ""
+
+    if (previous && !id) return previous
+
+    if (previous && previous.id === id && previous.directory === directory && previous.tab === tab) return previous
+
+    const visit = previous?.id === id ? previous.visit : {}
+
+    return untrack(() =>
+      createRoot((dispose) => {
+        root.dispose?.()
+        root.dispose = dispose
+
+        return create({ id, directory, tab, visit })
+      }, owner),
+    )
+  })
+
+  // The session's declared stores start loading now, before its regions read them.
+  createRenderEffect(on(mounted, (view) => attachment.preload(view)))
+  // Publish both after render, with the original session-mount timing. Renders receive their own screen directly;
+  // only global observers need this attachment. One batch prevents exposing a view on another screen.
+  createEffect(() =>
+    batch(() => {
+      onCleanup(attachment.screen(screen))
+      onCleanup(attachment.mount(mounted))
+    }),
+  )
+
+  return {
+    screen,
+    view: mounted,
+    bindBackground: (tasks: Accessor<readonly BackgroundTask[]>) => setBackground(() => tasks),
+    bindPrompt: (value: { quotable: Accessor<boolean>; focus: () => void; focused: () => boolean }) =>
+      setPrompt(() => value),
+  }
+}
diff --git a/packages/app/src/runtime/plugin/pane-drag.tsx b/packages/app/src/runtime/plugin/pane-drag.tsx
new file mode 100644
index 0000000..2b561a4
--- /dev/null
+++ b/packages/app/src/runtime/plugin/pane-drag.tsx
@@ -0,0 +1,224 @@
+import { Show } from "solid-js"
+import { createStore } from "solid-js/store"
+import { Portal } from "solid-js/web"
+import { SESSION_PANES, type SessionPane } from "@/shell/state/session-tabs"
+
+type Rect = { left: number; top: number; width: number; height: number }
+
+/** Where a dragged tab lands: before a tab in a pane's strip (its end without `before`), or in a pane. */
+export type PaneDropTarget = { pane: SessionPane; before?: string; strip: boolean; rect: Rect }
+
+/**
+ * Drags side and bottom panel tabs between panes. The strips and pane bodies mark themselves with `data-pane-strip`,
+ * `data-pane-tab` and `data-pane-content`; the session row with `data-pane-row`. Dropping on a strip places the tab
+ * between its neighbours, on a pane body moves it there, on the lower half of the side pane splits it, and on the
+ * bottom edge of the session opens the bottom pane.
+ */
+export function createPaneDrag(input: {
+  /** Panes that hold tabs; a pane without them is created by dropping on its zone. */
+  shown: (pane: SessionPane) => boolean
+  drop: (key: string, target: PaneDropTarget) => void
+}) {
+  const [state, setState] = createStore<{
+    key?: string
+    title: string
+    x: number
+    y: number
+    target?: PaneDropTarget
+  }>({ title: "", x: 0, y: 0 })
+
+  const hit = (x: number, y: number, key: string): PaneDropTarget | undefined => {
+    const inside = (rect: DOMRect) =>
+      rect.width > 0 && rect.height > 0 && x >= rect.left && x <= rect.right && y >= rect.top && y <= rect.bottom
+
+    // A scrolled strip, or one wider than its animating pane, extends past what is on screen.
+    const strip = Array.from(document.querySelectorAll<HTMLElement>("[data-pane-strip]")).find((element) =>
+      inside(visibleRect(element)),
+    )
+
+    const stripPane = paneOf(strip?.dataset.paneStrip)
+
+    if (strip && stripPane) {
+      const tabs = Array.from(strip.querySelectorAll<HTMLElement>("[data-pane-tab]")).filter(
+        (element) => element.dataset.paneTab !== key,
+      )
+
+      const next = tabs.find((element) => {
+        const rect = element.getBoundingClientRect()
+
+        return x < rect.left + rect.width / 2
+      })
+
+      const anchor = (next ?? tabs.at(-1))?.getBoundingClientRect()
+      const bounds = visibleRect(strip)
+
+      return {
+        pane: stripPane,
+        before: next?.dataset.paneTab,
+        strip: true,
+        rect: anchor
+          ? {
+              left: Math.min(Math.max((next ? anchor.left : anchor.right) - 1, bounds.left), bounds.right - 2),
+              top: anchor.top + 2,
+              width: 2,
+              height: anchor.height - 4,
+            }
+          : { left: bounds.left + 12, top: bounds.top + 12, width: 2, height: bounds.height - 24 },
+      }
+    }
+
+    const content = Array.from(document.querySelectorAll<HTMLElement>("[data-pane-content]")).find((element) =>
+      inside(element.getBoundingClientRect()),
+    )
+
+    const contentPane = paneOf(content?.dataset.paneContent)
+
+    if (content && contentPane) {
+      const rect = content.getBoundingClientRect()
+
+      if (contentPane === "side" && !input.shown("split") && y > rect.top + rect.height / 2)
+        return {
+          pane: "split",
+          strip: false,
+          rect: { left: rect.left, top: rect.top + rect.height / 2, width: rect.width, height: rect.height / 2 },
+        }
+
+      return { pane: contentPane, strip: false, rect: toRect(rect) }
+    }
+
+    const chat = document.querySelector<HTMLElement>('[data-slot="session-chat-panel"]')?.getBoundingClientRect()
+    const row = document.querySelector<HTMLElement>("[data-pane-row]")?.getBoundingClientRect()
+
+    if (!chat || !row || input.shown("bottom") || !inside(chat) || y < chat.bottom - chat.height / 4) return
+    const height = Math.min(280, row.height / 3)
+
+    return {
+      pane: "bottom",
+      strip: false,
+      rect: { left: row.left, top: row.bottom - height, width: row.width, height },
+    }
+  }
+
+  const start = (event: PointerEvent, key: string, title: string) => {
+    if (event.button !== 0) return
+    const origin = { x: event.clientX, y: event.clientY }
+    const drag = { active: false }
+    const swallow = (click: MouseEvent) => click.stopPropagation()
+
+    const move = (moved: PointerEvent) => {
+      if (!drag.active && Math.hypot(moved.clientX - origin.x, moved.clientY - origin.y) < 4) return
+
+      if (!drag.active) {
+        drag.active = true
+        document.body.style.userSelect = "none"
+      }
+
+      const target = hit(moved.clientX, moved.clientY, key)
+      // Away from any drop target the release cancels, so the cursor stays normal.
+      document.body.style.cursor = target ? "grabbing" : ""
+      setState({ key, title, x: moved.clientX, y: moved.clientY, target })
+    }
+
+    const finish = (commit: boolean) => {
+      window.removeEventListener("pointermove", move)
+      window.removeEventListener("pointerup", up)
+      window.removeEventListener("pointercancel", cancel)
+      window.removeEventListener("keydown", escape, true)
+
+      if (!drag.active) return
+      const target = state.target
+      document.body.style.userSelect = ""
+      document.body.style.cursor = ""
+      setState({ key: undefined, target: undefined })
+      // The release over the strip would click whatever tab is under it.
+      window.addEventListener("click", swallow, true)
+      setTimeout(() => window.removeEventListener("click", swallow, true))
+
+      if (commit && target) input.drop(key, target)
+    }
+
+    const up = () => finish(true)
+    const cancel = () => finish(false)
+
+    const escape = (keyboard: KeyboardEvent) => {
+      if (keyboard.key !== "Escape") return
+      keyboard.preventDefault()
+      keyboard.stopPropagation()
+      finish(false)
+    }
+
+    window.addEventListener("pointermove", move)
+    window.addEventListener("pointerup", up)
+    window.addEventListener("pointercancel", cancel)
+    window.addEventListener("keydown", escape, true)
+  }
+
+  return {
+    /** The dragged tab's key while a drag runs. */
+    dragging: () => state.key,
+    start,
+    Layer: () => (
+      <Show when={state.key}>
+        <Portal>
+          <div class="fixed inset-0 z-[100] pointer-events-none" data-component="pane-drag-layer">
+            <Show when={state.target}>
+              {(target) => (
+                <div
+                  data-slot={target().strip ? "pane-drop-indicator" : "pane-drop-zone"}
+                  data-pane={target().pane}
+                  class="absolute"
+                  classList={{
+                    "bg-v2-icon-icon-accent rounded-full": target().strip,
+                    "rounded-[10px] border border-v2-icon-icon-accent bg-[color-mix(in_srgb,var(--v2-icon-icon-accent)_12%,transparent)]":
+                      !target().strip,
+                  }}
+                  style={{
+                    left: `${target().rect.left}px`,
+                    top: `${target().rect.top}px`,
+                    width: `${target().rect.width}px`,
+                    height: `${target().rect.height}px`,
+                  }}
+                />
+              )}
+            </Show>
+            <div
+              class="absolute max-w-60 h-7 px-2.5 flex items-center rounded-md bg-v2-background-bg-base text-13-regular text-v2-text-text-base truncate shadow-[var(--v2-elevation-raised)] opacity-90"
+              style={{ left: `${state.x + 12}px`, top: `${state.y + 12}px` }}
+            >
+              {state.title}
+            </div>
+          </div>
+        </Portal>
+      </Show>
+    ),
+  }
+}
+
+export type PaneDrag = ReturnType<typeof createPaneDrag>
+
+function paneOf(value: string | undefined) {
+  return SESSION_PANES.find((pane) => pane === value)
+}
+
+/** The element's on-screen rect: its bounding rect clipped by every ancestor that clips overflow. */
+function visibleRect(element: HTMLElement) {
+  const rect = element.getBoundingClientRect()
+  const bounds = { left: rect.left, top: rect.top, right: rect.right, bottom: rect.bottom }
+
+  for (let parent = element.parentElement; parent; parent = parent.parentElement) {
+    const style = getComputedStyle(parent)
+
+    if (style.overflowX === "visible" && style.overflowY === "visible") continue
+    const clip = parent.getBoundingClientRect()
+    bounds.left = Math.max(bounds.left, clip.left)
+    bounds.top = Math.max(bounds.top, clip.top)
+    bounds.right = Math.min(bounds.right, clip.right)
+    bounds.bottom = Math.min(bounds.bottom, clip.bottom)
+  }
+
+  return new DOMRect(bounds.left, bounds.top, bounds.right - bounds.left, bounds.bottom - bounds.top)
+}
+
+function toRect(rect: DOMRect): Rect {
+  return { left: rect.left, top: rect.top, width: rect.width, height: rect.height }
+}
diff --git a/packages/app/src/runtime/plugin/panel-keys.ts b/packages/app/src/runtime/plugin/panel-keys.ts
