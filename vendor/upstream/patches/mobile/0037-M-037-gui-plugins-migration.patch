+// The module lists only: `gui()` reads them at build time, so this file imports nothing.
+
+/**
+ * The modules a plugin's `./gui-experimental` bundle may require that both processes provide, each its own instance.
+ * Main maps `@opencode/plugin/gui` to the main SDK and a window maps `@opencode/plugin/gui/main` to the window SDK:
+ * both export the same `Plugin`, `Store`, `Ipc`, `Contract` and `Registry`, so one definition and contract serve both
+ * processes. `@opencode/plugin/rpc` is here because a plugin's `./rpc` contract imports it, and its GUI imports that
+ * contract.
+ */
+export const pluginSharedModules = [
+  "effect",
+  "@opencode/plugin/gui",
+  "@opencode/plugin/gui/main",
+  "@opencode/plugin/rpc",
+  "@opencode/schema/rpc",
+  "@opencode/client",
+  "@opencode/client/effect",
+] as const
+
+/**
+ * The modules only a window provides to a plugin's `./gui-experimental` bundle; main gives the bundle an inert
+ * placeholder.
+ */
+export const pluginWindowModules = [
+  "solid-js",
+  "solid-js/web",
+  "solid-js/store",
+  "@opencode/plugin/gui/file",
+  "@opencode/plugin/gui/review",
+  "@opencode/plugin/gui/browser",
+  "@opencode/client/solid",
+] as const
+
+/** A module name in `pluginSharedModules` or `pluginWindowModules`. */
+export type PluginModule = (typeof pluginSharedModules)[number] | (typeof pluginWindowModules)[number]
diff --git a/packages/plugin/src/gui/plugin.ts b/packages/plugin/src/gui/plugin.ts
new file mode 100644
index 0000000..5b2f32a
--- /dev/null
+++ b/packages/plugin/src/gui/plugin.ts
@@ -0,0 +1,98 @@
+import type { SetupContext } from "./context.js"
+import type { Cleanup } from "./core.js"
+import type { Declarations, Stores } from "./declarations.js"
+import type { MainContext } from "./main.js"
+
+export type { Cleanup, Declarations }
+
+/**
+ * A window setup: the `setup` of `Plugin.define`. `Plugin.Setup<typeof definition>` types one written apart from
+ * its declarations, with `ctx.stores` from the declared stores. Runs synchronously under the plugin's Solid owner;
+ * return nothing, or a cleanup that runs when the plugin goes away. Put async work in `createKeyed` or
+ * `createLatest`, and pass `ctx.signal` or a signal derived from it. The return type rejects async functions and
+ * replacement values; the host also rejects thenables from JavaScript bundles.
+ *
+ * @param ctx - The plugin's context, under its Solid owner.
+ *
+ * @example
+ * ```ts
+ * export default Plugin.define({
+ *   setup(ctx) {
+ *     ctx.add(Command, () => ({ id: "settings", title: ctx.t("settings"), run: () => ctx.layout.settings(ctx.id) }))
+ *   },
+ * })
+ * ```
+ */
+export type Setup<D extends Declarations = Declarations<{}>> = (ctx: SetupContext<D>) => Cleanup | void
+
+/**
+ * A main-process setup: the `main` of `Plugin.define`. It may be async; return nothing, or a cleanup that runs when
+ * the plugin goes away.
+ *
+ * @param ctx - The plugin's main-process context.
+ *
+ * @example
+ * ```ts
+ * export default Plugin.define({
+ *   main(ctx) {
+ *     const awake = ctx.storage.store("awake", { schema: Schema.Boolean, initial: false })
+ *     ctx.provide(KeepAwake, { get: () => awake.value, set: (enabled) => awake.set(enabled) })
+ *   },
+ * })
+ * ```
+ */
+export type MainSetup = (ctx: MainContext) => Cleanup | void | Promise<Cleanup | void>
+
+/**
+ * A plugin's GUI: the default export of its `./gui-experimental` bundle. Its `Declarations`, then a window setup, a
+ * main-process setup, or both. The app's built-in plugins declare with it too.
+ */
+export type Definition<S extends Stores = Stores> = Declarations<S> & {
+  /** Runs in every desktop app window. See `Setup`. */
+  readonly setup?: Setup<NoInfer<Declarations<S>>>
+  /** Runs once in the desktop app's main process. See `MainSetup`. */
+  readonly main?: MainSetup
+}
+
+/**
+ * Defines a plugin's GUI, the default export of its `./gui-experimental` bundle, as `Plugin.define` from
+ * `@opencode/plugin` and `@opencode/plugin/tui` define its server and terminal halves. It declares no id: the host
+ * assigns the server plugin's (`ctx.id`). The window setup's `ctx.stores` is typed from the declared stores.
+ *
+ * @param plugin - The declarations and at least one setup.
+ * @returns The same object.
+ *
+ * @example
+ * ```tsx
+ * export default Plugin.define({
+ *   setup(ctx) {
+ *     ctx.add(Command, () => ({ id: "open", title: ctx.t("open"), run: () => void ctx.main(Acme).ping() }))
+ *   },
+ *   main(ctx) {
+ *     ctx.provide(Acme, { ping: () => "pong" })
+ *   },
+ * })
+ * ```
+ */
+export function define<const S extends Stores = {}>(plugin: Definition<S> & WithSetup): Definition<S>
+/**
+ * Declares a plugin's GUI without setups, so setups written in other files are typed from it
+ * (`Plugin.Setup<typeof definition>`) and the app's host lists can attach their own entries. Returns only the
+ * declarations.
+ *
+ * @param plugin - The declarations.
+ * @returns The same object.
+ */
+export function define<const S extends Stores = {}>(plugin: Declarations<S>): Declarations<S>
+/**
+ * Returns the plugin as it is; the overloads above carry its types.
+ *
+ * @param plugin - The declarations, with any setups.
+ * @returns The same object.
+ */
+export function define(plugin: Definition) {
+  return plugin
+}
+
+// A bundle's default export needs a setup; without one, `define` returns only the declarations.
+type WithSetup = { readonly setup: unknown } | { readonly main: unknown }
diff --git a/packages/plugin/src/gui/plugin.typecheck.ts b/packages/plugin/src/gui/plugin.typecheck.ts
new file mode 100644
index 0000000..a5bcc28
--- /dev/null
+++ b/packages/plugin/src/gui/plugin.typecheck.ts
@@ -0,0 +1,44 @@
+// Type-level contract of `Plugin.define`, checked by `bun typecheck`. Nothing imports this file. Each `@ts-expect-error`
+// fails the typecheck if its line stops being an error.
+
+import { Schema } from "effect"
+import { Command, Contract, Ipc, Plugin, Store } from "./index.js"
+
+const Notes = Contract.define<{ count(): number }, "acme.notes">("acme.notes")
+
+const Pinger = Ipc.define({ id: "acme", methods: { ping: { output: Schema.String } } })
+
+export const plugin = Plugin.define({
+  stores: { prefs: Store.global(Schema.Struct({ on: Schema.Boolean }), { on: true }) },
+  setup(ctx) {
+    ctx.provide(Notes, { count: () => 1 })
+    ctx.add(Command, () => ({ id: "open", title: String(ctx.stores.prefs.value.on), run() {} }))
+    void ctx.main(Pinger).ping()
+
+    return () => {}
+  },
+  main(ctx) {
+    ctx.provide(Pinger, { ping: () => "pong" })
+  },
+})
+
+// Split across files: declare once, type each setup from the declarations, then define the plugin with them.
+const declared = Plugin.define({ stores: { count: Store.global(Schema.Struct({ n: Schema.Number }), { n: 0 }) } })
+
+const setup: Plugin.Setup<typeof declared> = (ctx) => {
+  ctx.stores.count.set({ n: ctx.stores.count.value.n + 1 })
+}
+
+export const split = Plugin.define({ ...declared, setup })
+
+export const wrongImpl = Plugin.define({
+  setup(ctx) {
+    // @ts-expect-error the implementation must match the contract
+    ctx.provide(Notes, { size: () => 1 })
+  },
+})
+
+export const asyncWindow = Plugin.define({
+  // @ts-expect-error a window setup is synchronous
+  async setup() {},
+})
diff --git a/packages/plugin/src/gui/reactive.ts b/packages/plugin/src/gui/reactive.ts
new file mode 100644
index 0000000..95a7bc7
--- /dev/null
+++ b/packages/plugin/src/gui/reactive.ts
@@ -0,0 +1,222 @@
+import {
+  createMemo,
+  createRenderEffect,
+  createRoot,
+  createSignal,
+  getOwner,
+  on,
+  onCleanup,
+  runWithOwner,
+  untrack,
+  type Accessor,
+} from "solid-js"
+import { createStore } from "solid-js/store"
+import type { Live } from "./core.js"
+import { isLiveAccessor, LifetimeContext } from "./internal.js"
+import { usePlugin } from "./solid.js"
+
+type Falsy = undefined | null | false
+
+/**
+ * What `createKeyed` and `createLatest` follow: a `Live` accessor from `ctx.use(token)`, followed through its
+ * generations, or any accessor, followed by the identity of its value.
+ */
+export type KeyedSource = Accessor<unknown>
+
+/**
+ * What a source gives while it is active: the provider's value for a `Live` accessor; for a plain accessor, its value,
+ * which is active while it is not undefined, null or false.
+ */
+export type KeyedValue<S> =
+  S extends Accessor<Live<infer T>> ? T : S extends Accessor<infer T> ? Exclude<T, Falsy> : never
+
+/** One run of `createKeyed`: the source's value, or none while it is not active. */
+type Run = { readonly value: unknown; readonly generation?: number } | undefined
+
+/**
+ * Runs `fn` once per key, like `<Show keyed>`: each active generation of a `Live` accessor, or each identity of a plain
+ * accessor's value. Each run, and each run of `otherwise` while there is no key, has its own owner: its
+ * `onCleanup` and its registrations end with it. This is the way plugin code runs side effects reactively; use it
+ * only to sync with something outside Solid (the DOM, a widget, an Ipc subscription), never to set state from state.
+ * Call it under an owner: in setup, or in a component.
+ *
+ * A plain accessor that builds an object, such as `{ directory, tab }`, gives a new key each time it reads, even when
+ * every field is unchanged; pass `equals` to compare the fields that matter instead.
+ *
+ * @param source - A `Live` accessor from `ctx.use(token)`, or any accessor.
+ * @param fn - Runs once per key with the source's value. It runs untracked.
+ * @param options - What runs while there is no key, and when a plain accessor's new value is the same key.
+ *
+ * @example
+ * ```ts
+ * // Each provider generation: listen to its events; the listener ends with the generation.
+ * createKeyed(ctx.use(Changes), (changes) => changes.watch(screen, "files"))
+ * // A plain accessor: the picker runs while the tab is visible, and `otherwise` while it is not.
+ * createKeyed(visible, startPicker, { otherwise: endPicker })
+ * // An object source: lists again only when the directory or the tab changes.
+ * createKeyed(() => ({ directory: file.root, tab: tab() }), (key) => void list(key), {
+ *   equals: (previous, next) => previous.directory === next.directory && previous.tab === next.tab,
+ * })
+ * ```
+ */
+export function createKeyed<S extends KeyedSource>(
+  source: S,
+  fn: (value: KeyedValue<S>) => void,
+  options?: {
+    /**
+     * Runs while the source has no key: a `Live` accessor that is pending or inactive, or a plain accessor whose value
+     * is undefined, null or false. Its own owner ends when a key arrives.
+     */
+    readonly otherwise?: () => void
+    /**
+     * Whether a plain accessor's new value is the same key as the one `fn` last ran with, so the run stays and `fn`
+     * does not run again. Use it when the source builds an object each time it reads. Defaults to identity (`===`).
+     * A `Live` accessor always keys by generation and ignores it.
+     */
+    readonly equals?: (previous: KeyedValue<S>, next: KeyedValue<S>) => boolean
+  },
+) {
+  const read: KeyedSource = source
+  const same = options?.equals
+
+  const active = isLiveAccessor(read)
+    ? createMemo<Run>(
+        () => {
+          const value = read()
+
+          return value.status === "active" ? value : undefined
+        },
+        undefined,
+        // A Live source changes generation, not merely object, when its provider restarts.
+        { equals: (previous, next) => previous?.generation === next?.generation },
+      )
+    : createMemo<Run>(
+        () => {
+          const value = read()
+
+          return value === undefined || value === null || value === false ? undefined : { value }
+        },
+        undefined,
+        {
+          equals: (previous, next) => {
+            if (previous === undefined || next === undefined) return previous === next
+
+            // SAFETY: both values come from `source` while it is active, which is what `KeyedValue<S>` describes.
+            return (
+              previous.value === next.value || !!same?.(previous.value as KeyedValue<S>, next.value as KeyedValue<S>)
+            )
+          },
+        },
+      )
+
+  createRenderEffect(
+    on(active, (current) => {
+      // SAFETY: `current.value` comes from `source`, and `KeyedValue<S>` is what that source gives while active.
+      const run = current === undefined ? options?.otherwise : () => fn(current.value as KeyedValue<S>)
+
+      if (!run) return
+
+      // A root per run, so a registration made through a captured owner after the run ended disposes at once.
+      const lifetime = { ended: false }
+      const scope = createRoot((dispose) => ({ owner: getOwner(), dispose }))
+
+      onCleanup(() => {
+        lifetime.ended = true
+        scope.dispose()
+      })
+
+      if (scope.owner) scope.owner.context = { ...scope.owner.context, [LifetimeContext.id]: lifetime }
+      runWithOwner(scope.owner, run)
+    }),
+  )
+}
+
+/**
+ * The latest result of `fetch` for the source's current value. Never suspends. A new value aborts the previous request
+ * through its signal and drops its reply; so does the owner going away. `latest` keeps the last result meanwhile.
+ * Call it under an owner: in setup, or in a component.
+ *
+ * @param source - What to fetch for: a `Live` accessor from `ctx.use(token)`, or any accessor (see `KeyedValue`).
+ * @param fetch - Fetches for one value. Pass `signal` on to the request.
+ * @returns A store; read its fields in render or in a memo.
+ *
+ * @example
+ * ```ts
+ * const active = createLatest(ctx.use(Pairing), (pairing, signal) => pairing.screenActive({ signal }))
+ * const awake = () => active.latest ?? false
+ * ```
+ */
+export function createLatest<S extends KeyedSource, T>(
+  source: S,
+  fetch: (value: KeyedValue<S>, signal: AbortSignal) => Promise<T>,
+): {
+  /** The last result; kept while a newer request runs and while the source has no value. Undefined before the first. */
+  readonly latest: T | undefined
+  /** A request for the current value is in flight. */
+  readonly loading: boolean
+  /**
+   * The current request's rejection. Undefined while a request runs, after a result, and while the source has no
+   * value, so it never describes an earlier value's request.
+   */
+  readonly error: unknown
+} {
+  const [state, setState] = createStore<{ latest: T | undefined; loading: boolean; error: unknown }>({
+    latest: undefined,
+    loading: false,
+    error: undefined,
+  })
+
+  createKeyed(
+    source,
+    (value) => {
+      const controller = new AbortController()
+
+      onCleanup(() => controller.abort())
+      setState({ loading: true, error: undefined })
+      void Promise.try(() => fetch(value, controller.signal)).then(
+        (latest) => {
+          if (!controller.signal.aborted) setState({ latest, loading: false, error: undefined })
+        },
+        (cause: unknown) => {
+          if (!controller.signal.aborted) setState({ loading: false, error: cause })
+        },
+      )
+    },
+    { otherwise: () => setState({ loading: false, error: undefined }) },
+  )
+
+  return state
+}
+
+/**
+ * State that returns to `initial` on every routing visit of the current session (`MountedSession.visit`), e.g. a
+ * selection to forget when the user goes Home and back. Call it inside a contribution or setup: it reads
+ * `usePlugin()`.
+ *
+ * @param initial - The value at the start of every visit.
+ * @returns The value accessor and its setter, like `createSignal`.
+ *
+ * @example
+ * ```ts
+ * const [expanded, setExpanded] = createVisitState(false)
+ * ```
+ */
+export function createVisitState<T>(initial: T) {
+  const sessions = usePlugin().sessions
+  const visit = () => sessions.current()?.visit
+
+  const [state, setState] = createSignal<{ readonly visit: object | undefined; readonly value: T }>({
+    visit: undefined,
+    value: initial,
+  })
+
+  const value = () => {
+    const current = state()
+
+    return current.visit !== undefined && current.visit === visit() ? current.value : initial
+  }
+
+  const set = (next: T) => void setState({ visit: untrack(visit), value: next })
+
+  return [value, set] as const
+}
diff --git a/packages/plugin/src/gui/registries.ts b/packages/plugin/src/gui/registries.ts
new file mode 100644
index 0000000..57df039
