@@ -0,0 +1,44 @@
+import { Schema } from "effect"
+import { Ipc } from "./core.js"
+
+/**
+ * The updater's state, the same in every window.
+ * - `disabled`: this build does not update itself.
+ * - `idle`: no check has run yet.
+ * - `checking`: a check is running.
+ * - `downloading`: `version` is downloading.
+ * - `ready`: `version` is staged; `install` restarts into it.
+ * - `download-required`: `version` needs a manual download; `install` opens it.
+ * - `up-to-date`: the last check found nothing newer.
+ * - `installing`: `version` is installing.
+ * - `error`: the last check or download failed with `message`.
+ */
+export const UpdaterState = Schema.Union([
+  Schema.Struct({ status: Schema.Literal("disabled") }),
+  Schema.Struct({ status: Schema.Literal("idle") }),
+  Schema.Struct({ status: Schema.Literal("checking") }),
+  Schema.Struct({ status: Schema.Literal("downloading"), version: Schema.String }),
+  Schema.Struct({ status: Schema.Literal("ready"), version: Schema.String }),
+  Schema.Struct({ status: Schema.Literal("download-required"), version: Schema.String }),
+  Schema.Struct({ status: Schema.Literal("up-to-date") }),
+  Schema.Struct({ status: Schema.Literal("installing"), version: Schema.String }),
+  Schema.Struct({ status: Schema.Literal("error"), message: Schema.String }),
+])
+
+/** The updater's state; see `UpdaterState`. */
+export type UpdaterState = typeof UpdaterState.Type
+
+/** The desktop app updater. Its state is app-wide; every window receives the same value. */
+export const Updater = Ipc.define({
+  id: "updater",
+  state: UpdaterState,
+  methods: {
+    check: { output: UpdaterState },
+    /** Restarts into a staged update, or opens the installer download. */
+    install: {},
+  },
+  events: {
+    /** The app menu asks the focused window to check with in-app feedback (beta builds). */
+    check: Schema.Null,
+  },
+})
diff --git a/packages/plugin/src/gui/vite.ts b/packages/plugin/src/gui/vite.ts
new file mode 100644
index 0000000..d86fd9f
--- /dev/null
+++ b/packages/plugin/src/gui/vite.ts
@@ -0,0 +1,61 @@
+import { isBuiltin } from "node:module"
+import path from "node:path"
+import type { Plugin } from "vite"
+import solid from "vite-plugin-solid"
+import { pluginSharedModules, pluginWindowModules } from "./modules.js"
+
+/** Where `gui()` reads a plugin's GUI and writes its `./gui-experimental` bundle. */
+export interface GuiOptions {
+  /** The module whose default export is the plugin's `Plugin.define`. Defaults to `src/gui.tsx`. */
+  readonly entry?: string
+  /** The CommonJS bundle to write, the file `./gui-experimental` exports. Defaults to `dist/gui-experimental.cjs`. */
+  readonly outFile?: string
+}
+
+// The modules the app provides to a plugin's GUI, each the app's own instance; the bundle must not include a copy.
+const provided = new Set<string>([...pluginSharedModules, ...pluginWindowModules])
+
+/**
+ * Builds a plugin's `./gui-experimental` bundle with Vite: compiles Solid JSX, writes one CommonJS file with every
+ * dynamic `import()` inlined, since the app loads no second chunk, and keeps the modules the app provides external,
+ * with Electron and Node built-ins. Another module of Effect, Solid or OpenCode fails the build: the app does not
+ * provide it, and a bundled copy would not share the app's instance.
+ *
+ * @param options - The entry and the bundle to write.
+ * @returns The Vite plugins.
+ *
+ * @example
+ * ```ts
+ * // vite.config.ts
+ * export default defineConfig({ plugins: [gui()] })
+ * ```
+ */
+export function gui(options: GuiOptions = {}): Plugin[] {
+  const outFile = options.outFile ?? "dist/gui-experimental.cjs"
+
+  return [
+    solid(),
+    {
+      name: "opencode-gui",
+      enforce: "pre",
+      config: () => ({
+        build: {
+          outDir: path.dirname(outFile),
+          emptyOutDir: false,
+          lib: {
+            entry: options.entry ?? "src/gui.tsx",
+            formats: ["cjs"],
+            fileName: () => path.basename(outFile),
+          },
+          rollupOptions: { output: { exports: "named", inlineDynamicImports: true } },
+        },
+      }),
+      resolveId(source) {
+        if (provided.has(source) || source === "electron" || isBuiltin(source)) return { id: source, external: true }
+
+        if (/^(effect|solid-js|@opencode)\//.test(source))
+          this.error(`${source} is not a module the OpenCode app provides to plugin GUIs: ${[...provided].join(", ")}`)
+      },
