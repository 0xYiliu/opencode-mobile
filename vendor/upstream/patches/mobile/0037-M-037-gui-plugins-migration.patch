+  }
+
+  const shell: Tabs = {
+    list: shellTabs,
+    open: openSession,
+    focus(key) {
+      const tab = findTab(key)
+
+      if (tab) tabs.select(tab)
+    },
+    move(key, index) {
+      const keys = tabs.store.map(tabKey).filter((item) => item !== key)
+
