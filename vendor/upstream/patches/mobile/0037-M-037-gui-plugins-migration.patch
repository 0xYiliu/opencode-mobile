diff --git a/packages/ui/src/motion-tuning-features.ts b/packages/ui/src/motion-tuning-features.ts
new file mode 100644
index 0000000..ee60012
--- /dev/null
+++ b/packages/ui/src/motion-tuning-features.ts
@@ -0,0 +1,161 @@
+import type { DurationOptions } from "./motion"
+import { motionTuning, type MotionAction, type MotionKnob } from "./motion-tuning"
+
+type Mode = Extract<MotionKnob, { kind: "mode" }>
+
+type Toggle = Extract<MotionKnob, { kind: "toggle" }>
+
+/** One feature of the app the Knobs panel tunes: an area's subsection, or the area's own knobs. */
+export type MotionFeature = {
+  key: string
+  area: string
+  name: string
+  description?: string
+  /** A CSS selector for the part of the app the feature changes. */
+  target?: string
+  /** Every knob in registration order, modes and the switch included. */
+  knobs: MotionKnob[]
+  /** Alternatives offered beside the spring presets, such as James. */
+  modes: Mode[]
+  /** The experiment switch that turns the whole feature on or off. */
+  switch?: Toggle
+  /** What replays its motion. */
+  actions: MotionAction[]
+}
+
+/** A feature's preset: "shipped", a spring preset, or the id of one of its modes. */
+export type MotionFeaturePreset = string
+
+// The areas in the order the panel shows them; any other area follows in the order it registered.
+const areas = ["Timeline", "Composer", "Projects", "Voice"]
+
+// Features named here lead their area in this order, whichever module registered first; the rest follow in the order
+// they registered.
+const order = ["Docks"]
+
+/** Every registered knob and action as features under their areas, leaving out the speed the debug bar owns. */
+export function motionFeatures() {
+  const knobs = motionTuning.list().filter((item) => item.group !== "Global")
+  const actions = motionTuning.actions()
+  const rank = (list: string[], name: string) => (list.includes(name) ? list.indexOf(name) : list.length)
+  const keys = [...new Set([...knobs, ...actions].map(keyOf))]
+
+  const features = keys.map((key): MotionFeature => {
+    const own = knobs.filter((item) => keyOf(item) === key)
+    const first = own[0] ?? actions.find((item) => keyOf(item) === key)
+    const subsection = first?.subsection
+
+    return {
+      key,
+      area: first?.group ?? key,
+      // An area's own knobs would repeat the area's name, so a lone knob names its feature, else "General".
+      name: subsection ?? (own.length === 1 && own[0] ? own[0].label : "General"),
+      description: own.find((item) => item.description)?.description,
+      target: own.find((item) => item.target)?.target,
+      knobs: own,
+      modes: own.filter((item): item is Mode => item.kind === "mode"),
+      switch: own.find((item): item is Toggle => item.kind === "toggle" && !!item.experiment && !item.when),
+      actions: actions.filter((item) => keyOf(item) === key),
+    }
+  })
+
+  return [...new Set(features.map((feature) => feature.area))]
+    .toSorted((a, b) => rank(areas, a) - rank(areas, b))
+    .map((area) => ({
+      area,
+      features: features
+        .filter((feature) => feature.area === area)
+        .toSorted((a, b) => rank(order, a.name) - rank(order, b.name)),
+    }))
+}
+
+/** The knobs a feature's page shows as rows: what its `when` allows, without modes or the switch. */
+export function featureControls(feature: MotionFeature) {
+  return feature.knobs.filter((item) => item.kind !== "mode" && item !== feature.switch && (item.when?.() ?? true))
+}
+
+/** Whether anything in the feature differs from what ships. */
+export function featureChanged(feature: MotionFeature) {
+  return feature.knobs.some(changed)
+}
+
+export function changed(item: MotionKnob) {
+  if (item.kind === "spring") return !sameSpring(item.value, item.initial)
+
+  if (item.kind === "easing") return item.value.some((value, index) => value !== item.initial[index])
+
+  return item.value !== item.initial
+}
+
+/** The presets a feature offers: Shipped and the three spring presets while it shows a spring, then its modes. */
+export function featurePresets(feature: MotionFeature): MotionFeaturePreset[] {
+  const springs = featureControls(feature).some((item) => item.kind === "spring")
+
+  if (!springs && feature.modes.length === 0) return []
+
+  return ["shipped", "snappy", "smooth", "calm", ...feature.modes.map((item) => item.id)]
+}
+
+/**
+ * The preset the feature's values match, or undefined when they've been tuned by hand. Experiment choices are the
+ * design under test, not tuning, so they never make a feature Custom.
+ */
+export function activeFeaturePreset(feature: MotionFeature): MotionFeaturePreset | undefined {
+  const mode = feature.modes.find((item) => item.value)
+
+  if (mode) return mode.id
+
+  const tuning = feature.knobs.filter((item) => !item.experiment && item.kind !== "mode")
+
+  if (!tuning.some(changed)) return "shipped"
+
+  // A spring preset sets only springs, so any other knob tuned by hand makes the feature Custom.
+  if (tuning.some((item) => item.kind !== "spring" && changed(item))) return
+
+  const springs = featureControls(feature).flatMap((item) => (item.kind === "spring" ? [item] : []))
+
+  return (["snappy", "smooth", "calm"] as const).find(
+    (preset) => springs.length > 0 && springs.every((item) => sameSpring(item.value, item.presets[preset])),
+  )
+}
+
+/** Applies a preset: Shipped resets the tuning, a spring preset sets every spring it shows, a mode turns that mode on. */
+export function applyFeaturePreset(feature: MotionFeature, preset: MotionFeaturePreset) {
+  feature.modes.forEach((item) => {
+    if (item.value !== (item.id === preset)) motionTuning.set(item, item.id === preset)
+  })
+
+  if (preset === "shipped")
+    return feature.knobs.forEach((item) => {
+      if (!item.experiment && item.kind !== "mode") reset(item)
+    })
+
+  if (preset !== "snappy" && preset !== "smooth" && preset !== "calm") return
+
+  featureControls(feature).forEach((item) => {
+    if (item.kind === "spring") motionTuning.set(item, { ...item.presets[preset] })
+  })
+}
+
+/** Puts every knob in the feature back to what ships, experiments and modes included. */
+export function resetFeature(feature: MotionFeature) {
+  feature.knobs.forEach(reset)
+}
+
+export function reset(item: MotionKnob) {
+  if (!changed(item)) return
+
+  if (item.kind === "spring") return motionTuning.set(item, { ...item.initial })
+
+  if (item.kind === "easing") return motionTuning.set(item, [...item.initial])
+
+  motionTuning.set(item, item.initial)
+}
+
+function keyOf(item: MotionKnob | MotionAction) {
+  return item.subsection ? `${item.group} · ${item.subsection}` : item.group
+}
+
+function sameSpring(a: DurationOptions, b: DurationOptions) {
+  return a.duration === b.duration && a.bounce === b.bounce
+}
diff --git a/packages/ui/src/motion-tuning-fields.ts b/packages/ui/src/motion-tuning-fields.ts
new file mode 100644
index 0000000..f216e46
--- /dev/null
+++ b/packages/ui/src/motion-tuning-fields.ts
@@ -0,0 +1,42 @@
+import { choice, easing, knob, spring, toggle } from "knobs"
+import type { DurationOptions } from "./motion"
+import { motionTuning, type Bezier, type MotionKnob } from "./motion-tuning"
+
+/** The knobs field that edits a motion knob, defaulting to its shipped value. */
+export function motionField(item: MotionKnob, meta: { label: string; group?: string; subsection?: string }) {
+  if (item.kind === "spring") return spring(item.initial, meta)
+
+  if (item.kind === "toggle" || item.kind === "mode") return toggle(item.initial, meta)
+
+  if (item.kind === "easing") return easing(item.initial, meta)
+
+  if (item.kind === "choice") return choice(item.initial, item.options, { ...meta, labels: item.labels })
+
+  return knob(item.initial, { ...meta, min: item.min, max: item.max, step: item.step, unit: item.unit })
+}
+
+/** Applies a value from a knob's field (see `motionField`) to the knob. */
+export function applyMotion(item: MotionKnob, value: MotionKnob["value"]) {
+  if (item.kind === "spring") {
+    // SAFETY: a spring knob's field is a spring field.
+    return motionTuning.set(item, value as DurationOptions)
+  }
+
+  if (item.kind === "easing") {
+    // SAFETY: an easing knob's field is an easing field.
+    return motionTuning.set(item, [...(value as Bezier)] as Bezier)
+  }
+
+  if (item.kind === "toggle" || item.kind === "mode") {
+    // SAFETY: a toggle knob's field is a toggle field.
+    return motionTuning.set(item, value as boolean)
+  }
+
+  if (item.kind === "choice") {
+    // SAFETY: a choice knob's field is a choice field.
+    return motionTuning.set(item, value as string)
+  }
+
+  // SAFETY: a number knob's field is a number field.
+  motionTuning.set(item, value as number)
+}
diff --git a/packages/ui/src/motion-tuning.ts b/packages/ui/src/motion-tuning.ts
new file mode 100644
index 0000000..91ef17b
--- /dev/null
+++ b/packages/ui/src/motion-tuning.ts
@@ -0,0 +1,349 @@
+import type { DurationOptions } from "./motion"
+
+// Live motion settings for developer mode. Each surface registers knobs under the area of the app it belongs to
+// (Composer, Timeline…) and the feature they tune, with their shipped defaults, plus actions that replay its motion;
+// the Knobs panel lists the features (`motion-tuning-features`) and opens one to tune it. A knob marked `experiment`
+// is a design variant to try before one ships. Edits persist on this device.
+
+type Knob<Kind extends string, Value> = {
+  kind: Kind
+  id: string
+  label: string
+  /** The area of the app it tunes: a heading in the panel's list of features. */
+  group: string
+  /** The feature it tunes within the area, such as one experiment among several; the area's own knobs have none. */
+  subsection?: string
+  /** A short hint at what the feature changes, shown under its name; the first of a feature's knobs to give one wins. */
+  description?: string
+  /** A CSS selector for the part of the app the feature changes, outlined by the panel's Focus. */
+  target?: string
+  /** The design experiment this knob switches on or between, marked as one in the panel. */
+  experiment?: boolean
+  /** Shown only while this holds, e.g. the controls of the option a choice selects. */
+  when?: () => boolean
+  initial: Value
+  value: Value
+}
+
+/** The presets every spring offers, all without bounce. A spring ships Snappy unless it names another. */
+export const motionPresets = { snappy: "Snappy", smooth: "Smooth", calm: "Calm" } as const
+
+export type MotionPreset = keyof typeof motionPresets
+
+/** A CSS `cubic-bezier(x1, y1, x2, y2)`. */
+export type Bezier = [number, number, number, number]
+
+export type MotionKnob =
+  | (Knob<"spring", DurationOptions> & { presets: Record<MotionPreset, DurationOptions> })
+  | Knob<"easing", Bezier>
+  | Knob<"mode", boolean>
+  | Knob<"toggle", boolean>
+  | (Knob<"number", number> & { min: number; max: number; step: number; unit?: string })
+  | (Knob<"choice", string> & { options: readonly [string, ...string[]]; labels: Record<string, string> })
+
+export type MotionAction = { id: string; label: string; group: string; subsection?: string; run: () => void }
+
+type Meta = {
+  label: string
+  group: string
+  subsection?: string
+  description?: string
+  target?: string
+  experiment?: boolean
+  when?: () => boolean
+}
+
+// Bumped when knobs are merged or renamed, so values saved for the old ones are dropped.
+const key = "opencode.motion.v2"
+
+const knobs = new Map<string, MotionKnob>()
+
+const actions = new Map<string, MotionAction>()
+
+const listeners = new Set<() => void>()
+
+// Saved as numbers only: `<id>.duration` and `<id>.bounce` for springs, `<id>.0`…`<id>.3` for easings, 0 or 1 for toggles, the option's index for choices.
+const saved = load()
+
+export const motionTuning = {
+  /** The spring to run now: its tuned duration scaled by the global speed and slow motion. */
+  spring(id: string, meta: Meta & { presets: Record<MotionPreset, DurationOptions>; shipped?: MotionPreset }) {
+    const initial = meta.presets[meta.shipped ?? "snappy"]
+
+    const knob = register({
+      kind: "spring",
+      id,
+      label: meta.label,
+      group: meta.group,
+      subsection: meta.subsection,
+      description: meta.description,
+      target: meta.target,
+      experiment: meta.experiment,
+      when: meta.when,
+      initial,
+      value: { duration: number(`${id}.duration`, initial.duration), bounce: number(`${id}.bounce`, initial.bounce) },
+      presets: meta.presets,
+    })
+
+    return (): DurationOptions => ({
+      duration: Math.max(0.03, knob.value.duration * motionTimeScale()),
+      bounce: Math.min(0.95, Math.max(0, knob.value.bounce)),
+    })
+  },
+  /** A cubic-bezier curve, edited with its handles. */
+  easing(id: string, meta: Meta & { value: Bezier }) {
+    const knob = register({
+      kind: "easing",
+      id,
+      label: meta.label,
+      group: meta.group,
+      subsection: meta.subsection,
+      description: meta.description,
+      target: meta.target,
+      experiment: meta.experiment,
+      when: meta.when,
+      initial: meta.value,
+      // SAFETY: mapping the four indices of a Bezier yields four numbers.
+      value: [0, 1, 2, 3].map((index) => number(`${id}.${index}`, meta.value[index])) as Bezier,
+    })
+
+    return () => knob.value
+  },
+  /**
+   * An alternative to a section's springs, offered beside the Snappy, Smooth and Calm presets rather than as a row.
+   * Choosing it turns it on; choosing any other preset turns it off. Knobs can show only in one or the other with `when`.
+   */
+  mode(id: string, meta: Meta & { value?: boolean }) {
+    const initial = meta.value ?? false
+
+    const knob = register({
+      kind: "mode",
+      id,
+      label: meta.label,
+      group: meta.group,
+      subsection: meta.subsection,
+      description: meta.description,
+      target: meta.target,
+      experiment: meta.experiment,
+      when: meta.when,
+      initial,
+      value: number(id, initial ? 1 : 0) === 1,
+    })
+
+    return () => knob.value
+  },
+  toggle(id: string, meta: Meta & { value: boolean }) {
+    const knob = register({
+      kind: "toggle",
+      id,
+      label: meta.label,
+      group: meta.group,
+      subsection: meta.subsection,
+      description: meta.description,
+      target: meta.target,
+      experiment: meta.experiment,
+      when: meta.when,
+      initial: meta.value,
+      value: number(id, meta.value ? 1 : 0) === 1,
+    })
+
+    return () => knob.value
+  },
+  /** One of several named variants, such as a design experiment. `labels` maps each option to what the panel shows. */
+  choice<const T extends string>(id: string, meta: Meta & { value: NoInfer<T>; labels: Record<T, string> }) {
+    // SAFETY: a labels record always has at least the initial value's key.
+    const options = Object.keys(meta.labels) as [T, ...T[]]
+
+    const knob = register({
+      kind: "choice",
+      id,
+      label: meta.label,
+      group: meta.group,
+      subsection: meta.subsection,
+      description: meta.description,
+      target: meta.target,
+      experiment: meta.experiment,
+      when: meta.when,
+      initial: meta.value,
+      value: options[number(id, options.indexOf(meta.value))] ?? meta.value,
+      options,
+      labels: meta.labels,
+    })
+
+    // SAFETY: the panel only sets one of the knob's options.
+    return () => knob.value as T
+  },
+  /**
+   * A tuned number. A `time` of "duration" is seconds, stretched by the global speed and slow motion; "rate" is per
+   * second, so it shrinks by the same factor.
+   */
+  number(
+    id: string,
+    meta: Meta & { value: number; min: number; max: number; step: number; unit?: string; time?: "duration" | "rate" },
+  ) {
+    const knob = register({
+      kind: "number",
+      id,
+      label: meta.label,
+      group: meta.group,
+      subsection: meta.subsection,
+      description: meta.description,
+      target: meta.target,
+      experiment: meta.experiment,
+      when: meta.when,
+      initial: meta.value,
+      value: number(id, meta.value),
+      min: meta.min,
+      max: meta.max,
+      step: meta.step,
+      unit: meta.unit,
+    })
+
+    return () => {
+      if (meta.time === "duration") return knob.value * motionTimeScale()
+
+      if (meta.time === "rate") return knob.value / motionTimeScale()
+
+      return knob.value
+    }
+  },
+  /** A button that replays the motion it names. Returns its removal, for actions bound to a mounted surface. */
+  action(action: MotionAction) {
+    actions.set(action.id, action)
+    notify()
+
+    return () => {
+      if (actions.get(action.id) !== action) return
+      actions.delete(action.id)
+      notify()
+    }
+  },
+  list: () => [...knobs.values()],
+  actions: () => [...actions.values()],
+  /** Applies an edit and saves every knob that differs from its default. */
+  set<K extends MotionKnob>(knob: K, value: K["value"]) {
+    knob.value = value
+    save()
+    notify()
+  },
+  subscribe(listener: () => void) {
+    listeners.add(listener)
+
+    return () => {
+      listeners.delete(listener)
+    }
+  },
+}
+
+const speed = register({
+  kind: "number",
+  id: "speed",
+  label: "Speed",
+  group: "Global",
+  initial: 1,
+  value: number("speed", 1),
+  min: 0.25,
+  max: 4,
+  step: 0.05,
+  unit: "×",
+})
+
+const slow = register({
+  kind: "toggle",
+  id: "slow",
+  label: "Slow motion (0.25×)",
+  group: "Global",
+  initial: false,
+  value: number("slow", 0) === 1,
+})
+
+export const motionGlobals = { speed, slow }
+
+/** How many times longer motion takes than tuned, from the global speed and slow motion. */
+export function motionTimeScale() {
+  return (slow.value ? 4 : 1) / speed.value
+}
+
+function register<K extends MotionKnob>(knob: K) {
+  knobs.set(knob.id, knob)
+  notify()
+
+  return knob
+}
+
+function notify() {
+  listeners.forEach((listener) => listener())
+}
+
+function number(id: string, fallback: number) {
+  const value = Number(saved[id])
+
+  return id in saved && Number.isFinite(value) ? value : fallback
+}
+
+function load(): Record<string, number> {
+  try {
+    localStorage.removeItem("opencode.motion.v1")
+
+    return JSON.parse(localStorage.getItem(key) ?? "{}")
+  } catch {
+    return {}
+  }
+}
+
+function save() {
+  const entries = [...knobs.values()]
+    .flatMap((knob): [string, number, number][] => {
+      if (knob.kind === "spring")
+        return [
+          [`${knob.id}.duration`, knob.value.duration, knob.initial.duration],
+          [`${knob.id}.bounce`, knob.value.bounce, knob.initial.bounce],
+        ]
+
+      if (knob.kind === "easing")
+        return knob.value.map((value, index): [string, number, number] => [
+          `${knob.id}.${index}`,
+          value,
+          knob.initial[index],
+        ])
+
+      if (knob.kind === "toggle" || knob.kind === "mode") return [[knob.id, Number(knob.value), Number(knob.initial)]]
+
+      if (knob.kind === "choice")
+        return [[knob.id, knob.options.indexOf(knob.value), knob.options.indexOf(knob.initial)]]
+
+      return [[knob.id, knob.value, knob.initial]]
+    })
+    .flatMap(([id, value, initial]) => (value === initial ? [] : [[id, value]]))
+
+  try {
+    if (entries.length === 0) return localStorage.removeItem(key)
+    localStorage.setItem(key, JSON.stringify(Object.fromEntries(entries)))
+  } catch {}
+}
+
+// mobile(M-036): the Sources experiment's gate lives outside the knobs registry (issue #66); these two first-party
+// helpers read and write the same `opencode.motion.v2` record directly, and the settings Experimental tab's Sources
+// row is their only writer. The record's non-defaults-only invariant is kept: a value flipped back to its initial
+// drops the entry again. (A DEV knobs-console save() rewrites the record from the registry alone; the in-memory
+// `saved` read here keeps the gate correct for the session — DEV-only caveat, prod DCEs the console.)
+/** The stored value of a toggle, for readers outside the experiment module (the settings row). */
+export function storedToggle(id: string, initial: boolean) {
+  return number(id, initial ? 1 : 0) === 1
+}
+
+/** Flips a toggle and persists it in the upstream record; the entry is dropped again at the default. */
+export function setStoredToggle(id: string, value: boolean, initial: boolean) {
+  if (value === initial) delete saved[id]
+  else saved[id] = value ? 1 : 0
+
+  persist()
+  notify()
+}
+
+function persist() {
+  try {
+    if (Object.keys(saved).length === 0) return localStorage.removeItem(key)
+    localStorage.setItem(key, JSON.stringify(saved))
+  } catch {}
+}
