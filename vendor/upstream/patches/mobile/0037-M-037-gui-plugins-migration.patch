+ */
+export interface BaseContext {
+  /**
+   * The plugin's options from `opencode.json`, as `ctx.options` in its server and TUI halves. Empty for a built-in.
+   *
+   * @example
+   * ```ts
+   * // "plugins": [{ "package": "opencode-acme", "options": { "team": "core" } }]
