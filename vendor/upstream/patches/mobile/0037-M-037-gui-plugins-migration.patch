+import { For, Show, createMemo, createUniqueId, type JSX } from "solid-js"
+import { createStore } from "solid-js/store"
+import { FileIcon } from "@opencode/ui/file-icon"
+import { Icon } from "@opencode/ui/icon"
+import { IconButton } from "@opencode/ui/icon-button"
+import { Keybind } from "@opencode/ui/keybind"
+import { Menu } from "@opencode/ui/menu"
+import { Tooltip } from "@opencode/ui/tooltip"
+import { getDirectory, getFilename } from "@opencode/util/path"
+import { isIconName } from "@opencode/ui/icons/catalog"
+import { useCommand } from "@/shell/commands/command"
+import { useLanguage } from "@/runtime/i18n/language"
+import {
+  closedTabsSwap,
+  createModifierHeld,
+  hasModifier,
+  type ClosedSideTab,
+  type ClosedTabsModifier,
+} from "./closed-tabs"
+
+const MENU_LIMIT = 10
+
+const SECTION_LIMIT = 5
+
+/** A closed tab's icon, title and, for a file, its folder. */
+function ClosedTabVisual(props: { entry: ClosedSideTab }): JSX.Element {
+  const detail = () => (props.entry.file ? getDirectory(props.entry.file).replace(/\/$/, "") : props.entry.detail)
+  const icon = () => (props.entry.icon && isIconName(props.entry.icon) ? props.entry.icon : "file-document")
+
+  return (
+    <span class="flex min-w-0 items-center gap-1.5">
+      <Show
+        when={props.entry.file}
+        fallback={<Icon name={icon()} size="small" class="shrink-0 text-v2-icon-icon-muted" />}
+      >
+        {(file) => (
+          <FileIcon
+            node={{ path: file(), type: "file" }}
+            mono
+            class="size-4 shrink-0 text-v2-icon-icon-faint group-hover/closed-tab:text-v2-icon-icon-muted"
+          />
+        )}
+      </Show>
+      <span class="min-w-0 shrink truncate text-v2-text-text-base">
+        {props.entry.file ? getFilename(props.entry.file) : props.entry.title}
+      </span>
+      <Show when={detail()}>{(value) => <span class="min-w-0 truncate text-v2-text-text-muted">{value()}</span>}</Show>
+    </span>
+  )
+}
+
+function useReopenKeybind() {
+  const command = useCommand()
+
+  return createMemo(() => command.keybindParts("file.tab.reopen"))
+}
+
+/**
+ * The new tab view's "Recently closed": the latest `SECTION_LIMIT` closed tabs, and every kept one once expanded. The
+ * newest shows the ⌘⇧T that reopens it.
+ */
+export function ClosedTabsSection(props: { entries: readonly ClosedSideTab[]; onReopen: (key: string) => void }) {
+  const language = useLanguage()
+  const keybind = useReopenKeybind()
+  const [state, setState] = createStore({ expanded: false })
+  const heading = createUniqueId()
+  const shown = () => (state.expanded ? props.entries : props.entries.slice(0, SECTION_LIMIT))
+
+  return (
+    <Show when={props.entries.length > 0}>
+      <section data-slot="side-recently-closed" class="flex flex-col gap-1 pt-6" aria-labelledby={heading}>
+        <h2 id={heading} class="px-2 pb-1 text-[13px] font-[440] text-v2-text-text-muted">
+          {language.t("home.recentlyClosed")}
+        </h2>
+        <For each={shown()}>
+          {(entry, index) => (
+            <button
+              type="button"
+              data-slot="side-recently-closed-row"
+              class="group/closed-tab flex h-8 w-full shrink-0 items-center justify-between gap-4 rounded-[6px] px-2 text-start text-[13px] font-[440] hover:bg-v2-background-bg-layer-02"
+              onClick={() => props.onReopen(entry.key)}
+            >
+              <ClosedTabVisual entry={entry} />
+              <Show when={index() === 0 && keybind().length > 0}>
+                <Keybind keys={keybind()} variant="neutral" />
+              </Show>
+            </button>
+          )}
+        </For>
+        <Show when={!state.expanded && props.entries.length > SECTION_LIMIT}>
+          <button
+            type="button"
+            data-slot="side-recently-closed-more"
+            class="flex h-8 w-fit items-center gap-1 rounded-[6px] px-2 text-[13px] font-[440] text-v2-text-text-muted hover:bg-v2-background-bg-layer-02 hover:text-v2-text-text-base"
+            onClick={(event) => {
+              const section = event.currentTarget.parentElement
+              setState("expanded", true)
+              // Wait for the newly revealed rows to mount before moving focus off the removed button.
+              queueMicrotask(() => {
+                section
+                  ?.querySelectorAll<HTMLButtonElement>('[data-slot="side-recently-closed-row"]')
+                  [SECTION_LIMIT]?.focus()
+              })
+            }}
+          >
+            {language.t("session.tab.showMore")}
+            <Icon name="chevron-down" size="small" />
+          </button>
+        </Show>
+      </section>
+    </Show>
+  )
+}
+
+function ClosedTabsItems(props: { entries: readonly ClosedSideTab[]; onReopen: (key: string) => void }) {
+  const language = useLanguage()
+  const keybind = useReopenKeybind()
+
+  return (
+    <Menu.Group>
+      <Menu.GroupLabel>{language.t("home.recentlyClosed")}</Menu.GroupLabel>
+      <Show
+        when={props.entries.length > 0}
+        fallback={<div class="px-2 py-1.5 text-[13px] text-v2-text-text-muted">{language.t("palette.empty")}</div>}
+      >
+        <For each={props.entries.slice(0, MENU_LIMIT)}>
+          {(entry, index) => (
+            <Menu.Item
+              class="group/closed-tab !gap-6 max-w-80"
+              onSelect={() => props.onReopen(entry.key)}
+              shortcut={
+                <Show when={index() === 0 && keybind().length > 0}>
+                  <Keybind keys={keybind()} variant="neutral" />
+                </Show>
+              }
+            >
+              <ClosedTabVisual entry={entry} />
+            </Menu.Item>
+          )}
+        </For>
+      </Show>
+    </Menu.Group>
+  )
+}
+
+const MODIFIER_LABEL = {
+  mac: { alt: "⌥", shift: "⇧", ctrl: "⌃", meta: "⌘" },
+  other: { alt: "Alt", shift: "Shift", ctrl: "Ctrl", meta: "Win" },
+} as const
+
+/**
+ * Dev builds only, behind `opencode.dev.closedTabsModifier`: the tab strip's "+". Holding the modifier while pointing at it turns it into a chevron whose click lists the
+ * recently closed tabs; a plain click still opens a new tab. Right-click and ↓ on the focused button open the list too.
+ */
+export function NewTabButton(props: {
+  modifier: ClosedTabsModifier
+  entries: readonly ClosedSideTab[]
+  onReopen: (key: string) => void
+  onNewTab: () => void
+}) {
+  const language = useLanguage()
+  const modifier = props.modifier
+  const global = closedTabsSwap() === "global"
+  const held = createModifierHeld(modifier)
+  const label = MODIFIER_LABEL[/(Mac|iPhone|iPad)/.test(navigator.platform) ? "mac" : "other"][modifier]
+  const [state, setState] = createStore({ hover: false, open: false })
+  const available = () => props.entries.length > 0
+  const swapped = () => state.open || (available() && held() && (global || state.hover))
+  // What the press that is opening the menu asked for, read when Kobalte reports the open.
+  let intent: "menu" | "new" = "new"
+  // A chosen entry reopens once the closing menu has returned focus, as the "+" menu does.
+  let chosen: string | undefined
+
+  return (
+    <Tooltip
+      value={
+        swapped() ? (
+          language.t("home.recentlyClosed")
+        ) : (
+          <span class="flex items-center gap-2">
+            {language.t("session.tab.add")}
+            <Show when={available()}>
+              <span class="opacity-60">{language.t("session.tab.recentHint", { key: label })}</span>
+            </Show>
+          </span>
+        )
+      }
+      placement="bottom"
+      class="flex items-center"
+    >
+      <Menu
+        appearance="standard"
+        modal={false}
+        placement="bottom-start"
+        gutter={4}
+        open={state.open}
+        onOpenChange={(open) => {
+          if (!open) return setState("open", false)
+
+          if (intent === "menu" && available()) return setState("open", true)
+          props.onNewTab()
+        }}
+      >
+        <Menu.Trigger
+          as={IconButton}
+          data-slot="side-new-tab"
+          data-swapped={swapped() ? "" : undefined}
+          icon={<Icon name={swapped() ? "chevron-down" : "plus"} />}
+          variant="ghost-muted"
+          size="large"
+          aria-label={swapped() ? language.t("home.recentlyClosed") : language.t("session.tab.add")}
+          aria-haspopup="menu"
+          onPointerEnter={() => setState("hover", true)}
+          onPointerLeave={() => setState("hover", false)}
+          onPointerDown={(event: PointerEvent) => {
+            // The tablist redirects focus entering it to the selected tab, which counts as focus-outside and closes
+            // the menu.
+            event.preventDefault()
+            intent = swapped() || hasModifier(event, modifier) ? "menu" : "new"
+          }}
+          onKeyDown={(event: KeyboardEvent) => {
+            intent = event.key === "ArrowDown" || event.key === "ArrowUp" || swapped() ? "menu" : "new"
+          }}
+          onContextMenu={(event: MouseEvent) => {
+            if (!available()) return
+            event.preventDefault()
+            setState("open", true)
+          }}
+        />
+        <Menu.Portal>
+          <Menu.Content
+            class="min-w-64"
+            onCloseAutoFocus={() => {
+              const key = chosen
+
+              if (!key) return
+              chosen = undefined
+              setTimeout(() => {
+                if (document.activeElement instanceof HTMLElement) document.activeElement.blur()
+                props.onReopen(key)
+              })
+            }}
+          >
+            <ClosedTabsItems entries={props.entries} onReopen={(key) => (chosen = key)} />
+          </Menu.Content>
+        </Menu.Portal>
+      </Menu>
+    </Tooltip>
+  )
+}
diff --git a/packages/app/src/runtime/plugin/closed-tabs.ts b/packages/app/src/runtime/plugin/closed-tabs.ts
new file mode 100644
index 0000000..d9b1d61
--- /dev/null
+++ b/packages/app/src/runtime/plugin/closed-tabs.ts
@@ -0,0 +1,189 @@
+import { createSignal } from "solid-js"
+import { createStore } from "solid-js/store"
+import { createEventListener } from "@solid-primitives/event-listener"
+import type { Panel, PanelProps, SessionRef } from "@opencode/plugin/gui"
+import { adjacentTabKey } from "@/shell/titlebar/tab-order"
+
+/** The most closed tabs a session keeps. */
+export const CLOSED_TABS_LIMIT = 30
+
+/** A side tab the user closed, as the new tab view lists it and ⌘⇧T brings it back. */
+export type ClosedSideTab = {
+  /** `${plugin}:${tab id}`. */
+  readonly key: string
+  readonly title: string
+  /** An icon name; stored, so check it before drawing. */
+  readonly icon?: string
+  /** The workspace file the tab showed, if any. */
+  readonly file?: string
+  /** A muted detail after the title. */
+  readonly detail?: string
+  /** What the panel's `restore` needs. */
+  readonly data?: string
+  /** When it closed, in milliseconds since the epoch. */
+  readonly closed: number
+}
+
+/** Where a session's closed tabs live, newest first. */
+export type ClosedTabsStore = {
+  list(session: SessionRef): readonly ClosedSideTab[]
+  write(session: SessionRef, entries: readonly ClosedSideTab[]): void
+}
+
+/** Each session's closed side tabs, newest first, up to `CLOSED_TABS_LIMIT`. In memory unless given a store. */
+export function createClosedTabs(store: ClosedTabsStore = memoryStore()) {
+  return {
+    /** Reactive. */
+    list: store.list,
+    push(session: SessionRef, entry: Omit<ClosedSideTab, "closed">) {
+      store.write(
+        session,
+        [{ ...entry, closed: Date.now() }, ...store.list(session).filter((item) => item.key !== entry.key)].slice(
+          0,
+          CLOSED_TABS_LIMIT,
+        ),
+      )
+    },
+    /** Removes and returns the entry under `key`, or the newest one. */
+    take(session: SessionRef, key?: string) {
+      const entries = store.list(session)
+      const entry = key === undefined ? entries[0] : entries.find((item) => item.key === key)
+
+      if (entry)
+        store.write(
+          session,
+          entries.filter((item) => item !== entry),
+        )
+
+      return entry
+    },
+  }
+}
+
+export type ClosedTabs = ReturnType<typeof createClosedTabs>
+
+/** How a closing tab lists, or nothing when its panel says it cannot come back. Transient tabs list only when asked. */
+export function closedEntry(key: string, panel: Panel, input: PanelProps): Omit<ClosedSideTab, "closed"> | undefined {
+  const info = panel.closed?.(input)
+
+  if (info === false) return
+
+  if (!info && (panel.transient || input.tab.transient)) return
+
+  return {
+    key,
+    title: info?.title ?? input.tab.title,
+    icon: info?.icon ?? panel.mobile?.icon,
+    file: input.tab.file,
+    detail: info?.detail,
+    data: info?.data,
+  }
+}
+
+function memoryStore(): ClosedTabsStore {
+  const [entries, setEntries] = createStore<Record<string, readonly ClosedSideTab[]>>({})
+
+  return {
+    list: (session) => entries[session.key] ?? [],
+    write: (session, next) => setEntries(session.key, next),
+  }
+}
+
+export type ClosedTabsModifier = "alt" | "shift" | "ctrl" | "meta"
+
+/**
+ * Dev builds only, while the design is evaluated: the held key that turns the side panel's "+" into a "Recently closed"
+ * menu, from `localStorage["opencode.dev.closedTabsModifier"]`. Off unless set.
+ */
+export function closedTabsModifier(): ClosedTabsModifier | undefined {
+  if (!import.meta.env.DEV) return
+  const value = localStorage.getItem("opencode.dev.closedTabsModifier")
+
+  return value === "alt" || value === "shift" || value === "ctrl" || value === "meta" ? value : undefined
+}
+
+/** Whether the swap waits for the pointer to rest on "+", or shows whenever the key is down. Hover unless the dev flag says "global". */
+export function closedTabsSwap(): "hover" | "global" {
+  return import.meta.env.DEV && localStorage.getItem("opencode.dev.closedTabsSwap") === "global" ? "global" : "hover"
+}
+
+/** Whether an input event carries the modifier. */
+export function hasModifier(event: KeyboardEvent | MouseEvent, modifier: ClosedTabsModifier) {
+  if (modifier === "shift") return event.shiftKey
+
+  if (modifier === "ctrl") return event.ctrlKey
+
+  if (modifier === "meta") return event.metaKey
+
+  return event.altKey
+}
+
+/**
+ * Whether the modifier is held, from every key and pointer event's modifier state rather than counting presses, so key
+ * repeat, a press made while another window had focus, and a release made elsewhere all settle. Leaving the window
+ * releases it, since its keyup goes to another window.
+ */
+export function createModifierHeld(modifier: ClosedTabsModifier) {
+  const [held, setHeld] = createSignal(false)
+  const update = (event: KeyboardEvent | MouseEvent) => setHeld(hasModifier(event, modifier))
+
+  createEventListener(window, ["keydown", "keyup"], update, { capture: true })
+  createEventListener(window, ["pointermove", "pointerdown"], update, { capture: true, passive: true })
+  createEventListener(window, "blur", () => setHeld(false))
+  createEventListener(document, "visibilitychange", () => document.hidden && setHeld(false))
+
+  return held
+}
+
+/**
+ * Whether a key event belongs to the side panel: its target is in it, or, when the target is the body because closing
+ * the focused tab dropped focus, the user's last focus, click or key was. `focused` reads that last answer.
+ */
+export function createSideFocus() {
+  const [last, setLast] = createSignal(false)
+  createEventListener(document, ["focusin", "pointerdown", "keydown"], (event) => setLast(inSide(event, last())), {
+    capture: true,
+  })
+
+  return Object.assign((event: Event) => inSide(event, last()), { focused: last })
+}
+
+/** As in a browser: inside the side panel, ⌘1–8 select that side tab, ⌘9 the last one, and ⇧⌘[ and ⇧⌘] the previous and next. */
+export function sideTabShortcuts(input: {
+  keys: () => readonly string[]
+  active: () => string | undefined
+  select: (key: string) => void
+  when: (event: KeyboardEvent) => boolean
+}) {
+  const shortcut = (id: string, keybind: string, target: () => string | undefined) => ({
+    id,
+    title: "",
+    keybind,
+    hidden: true,
+    when: input.when,
+    onSelect: () => {
+      const key = target()
+
+      if (key) input.select(key)
+    },
+  })
+
+  return [
+    ...Array.from({ length: 9 }, (_, index) =>
+      shortcut(`file.tab.${index + 1}`, `mod+${index + 1}`, () =>
+        index === 8 ? input.keys().at(-1) : input.keys()[index],
+      ),
+    ),
+    shortcut("file.tab.left", "mod+shift+[", () => adjacentTabKey([...input.keys()], input.active(), -1)),
+    shortcut("file.tab.right", "mod+shift+]", () => adjacentTabKey([...input.keys()], input.active(), 1)),
+  ]
+}
+
+function inSide(event: Event, fallback: boolean) {
+  const target = event.target
+
+  const placed =
+    target instanceof Element && target !== document.body && target !== document.documentElement && target.isConnected
+
+  return placed ? !!target.closest("#review-panel") : fallback
+}
diff --git a/packages/app/src/runtime/plugin/commands.tsx b/packages/app/src/runtime/plugin/commands.tsx
new file mode 100644
index 0000000..9d6ed9b
--- /dev/null
+++ b/packages/app/src/runtime/plugin/commands.tsx
@@ -0,0 +1,86 @@
+import { createMemo } from "solid-js"
+import { BuiltinCommand } from "@opencode/plugin/gui/builtin"
+import { useCommand, type CommandSource } from "@/shell/commands/command"
+import { useSettings } from "@/settings/model"
+import { migrateKeybinds } from "@/settings/keybinds/migration"
+import { usePluginHost, type Item } from "./host"
+
+/** Publishes plugin commands as `${plugin}.${id}` in the host command registry. */
+export function PluginCommands() {
+  const host = usePluginHost()
+  const command = useCommand()
+  migrateKeybinds(useSettings())
+  // Plugins activate in whatever order their entries load; list them in definition order, then registration order.
+  const rank = createMemo(() => new Map(host.definitions().map((definition, index) => [definition.id, index])))
+  const order = (plugin: string) => rank().get(plugin) ?? rank().size
+  command.register("plugins", () =>
+    pluginCommandItems(host.items(BuiltinCommand))
+      .toSorted((a, b) => order(a.plugin) - order(b.plugin))
+      .map((item) => ({
+        id: `${item.plugin}.${item.value.id}`,
+        plugin: item.plugin,
+        title: item.value.title,
+        description: item.value.description,
+        keywords: item.value.keywords,
+        category: item.value.group,
+        section: item.value.section,
+        keybind: item.value.bind,
+        follows: item.value.follows,
+        slash: item.value.slash?.name,
+        slashArguments: item.value.slash?.arguments,
+        slashAfter: item.value.slash?.after,
+        suggested: item.value.suggested,
+        featured: item.value.featured,
+        disabled: item.value.enabled === false,
+        hidden: item.value.hidden,
+        editable: item.value.editable,
+        when: item.value.scope ? scopedTo(item.value.scope) : undefined,
+        onSelect: (_source?: CommandSource, input?: string) => item.value.run(input),
+      })),
+  )
+
+  return null
+}
+
+/**
+ * One item per published command id. A plugin may contribute the same command from several mounted owners, such as one
+ * per cached timeline; the newest wins, as the newest keyed registration does in the command registry.
+ */
+export function pluginCommandItems(items: readonly Item<BuiltinCommand>[]) {
+  return [...new Map(items.map((item) => [`${item.plugin}.${item.value.id}`, item])).values()]
+}
+
+// A command scoped to a selector runs only while the event's target is inside it.
+const scopedTo = (scope: string) => (event: KeyboardEvent) =>
+  event.target instanceof Element && !!event.target.closest(scope)
+
+/** Whether an enabled plugin command scoped around the key's target is bound to that key, so it answers instead. */
+export function usePluginClaims() {
+  const host = usePluginHost()
+  const command = useCommand()
+
+  return (event: KeyboardEvent) => pluginClaims(host.items(BuiltinCommand), command.matches, event)
+}
+
+export function pluginClaims(
+  commands: readonly Item<BuiltinCommand>[],
+  matches: (id: string, event: KeyboardEvent) => boolean,
+  event: KeyboardEvent,
+) {
+  return commands.some(
+    (item) =>
+      !!item.value.scope &&
+      item.value.enabled !== false &&
+      scopedTo(item.value.scope)(event) &&
+      matches(`${item.plugin}.${item.value.id}`, event),
+  )
+}
+
+/** Focus inside a plugin command's scope belongs to that plugin, which binds its own shortcuts there. */
+export function usePluginScoped() {
+  const host = usePluginHost()
+
+  return (target: EventTarget | null) =>
+    target instanceof Element &&
+    host.items(BuiltinCommand).some((item) => !!item.value.scope && !!target.closest(item.value.scope))
+}
diff --git a/packages/app/src/runtime/plugin/dialogs.tsx b/packages/app/src/runtime/plugin/dialogs.tsx
new file mode 100644
index 0000000..ac74d71
--- /dev/null
+++ b/packages/app/src/runtime/plugin/dialogs.tsx
@@ -0,0 +1,177 @@
+import { createMemo, Show } from "solid-js"
+import { createStore } from "solid-js/store"
+import fuzzysort from "fuzzysort"
+import type { AlertOptions, ConfirmOptions, PromptOptions, SelectOptions } from "@opencode/plugin/gui"
+import { Button } from "@opencode/ui/button"
+import { Dialog, DialogBody, DialogFooter, DialogHeader, DialogTitle, DialogTitleGroup } from "@opencode/ui/dialog"
+import { SearchHighlight, SearchList } from "@opencode/ui/search-list"
+import { TextInput } from "@opencode/ui/text-input"
+import { useLanguage } from "@/runtime/i18n/language"
+import "@/shell/commands/dialog.css"
+import "@/shell/palette-menu.css"
+
+// The dialogs behind `Dialogs.confirm`, `alert`, `prompt` and `select`. Each answers through `done`; the host closes
+// the dialog and settles the plugin's promise.
+
+/** `Dialogs.confirm`: the app's confirm dialog. A destructive action focuses Cancel, as the app's own do. */
+export function PluginConfirmDialog(props: { options: ConfirmOptions; done: (confirmed: boolean) => void }) {
+  const language = useLanguage()
+
+  return (
+    <Dialog fit>
+      <DialogHeader hideClose>
+        <DialogTitleGroup title={props.options.title} description={props.options.description} />
+      </DialogHeader>
+      <DialogFooter>
+        <Button variant="ghost" autofocus={!!props.options.danger} onClick={() => props.done(false)}>
+          {props.options.cancel ?? language.t("common.cancel")}
+        </Button>
+        <Button
+          variant={props.options.danger ? "danger" : "contrast"}
+          autofocus={!props.options.danger}
+          onClick={() => props.done(true)}
+        >
+          {props.options.confirm ?? language.t("ui.common.confirm")}
+        </Button>
+      </DialogFooter>
+    </Dialog>
+  )
+}
+
+export function PluginAlertDialog(props: { options: AlertOptions; done: () => void }) {
+  const language = useLanguage()
+
+  return (
+    <Dialog fit>
+      <DialogHeader hideClose>
+        <DialogTitleGroup title={props.options.title} description={props.options.description} />
+      </DialogHeader>
+      <DialogFooter>
+        <Button variant="contrast" autofocus onClick={() => props.done()}>
+          {props.options.ok ?? language.t("common.ok")}
+        </Button>
+      </DialogFooter>
+    </Dialog>
+  )
+}
+
+/** `Dialogs.prompt`: one text field. Submitting needs a value, so the dialog never answers with "". */
+export function PluginPromptDialog(props: { options: PromptOptions; done: (value: string | undefined) => void }) {
+  const language = useLanguage()
+  const [store, setStore] = createStore({ value: props.options.value ?? "", selected: false })
+
+  return (
+    <Dialog fit>
+      <DialogHeader hideClose>
+        <DialogTitleGroup title={props.options.title} description={props.options.description} />
+      </DialogHeader>
+      <form
+        class="contents"
+        onSubmit={(event) => {
+          event.preventDefault()
+
+          if (store.value) props.done(store.value)
+        }}
+      >
+        <DialogBody class="px-4">
+          <TextInput
+            type={props.options.secret ? "password" : "text"}
+            appearance="large"
+            class="!w-full self-stretch"
+            value={store.value}
+            placeholder={props.options.placeholder}
+            aria-label={props.options.title}
+            autofocus
+            autocomplete="off"
+            spellcheck={false}
+            // The initial text is selected once, so typing replaces it.
+            onFocus={(event) => {
+              if (store.selected) return
+              setStore("selected", true)
+              event.currentTarget.select()
+            }}
+            onInput={(event) => setStore("value", event.currentTarget.value)}
+          />
+        </DialogBody>
+        <DialogFooter>
+          <Button type="button" variant="ghost" onClick={() => props.done(undefined)}>
+            {language.t("common.cancel")}
+          </Button>
+          <Button type="submit" variant="contrast" disabled={!store.value}>
+            {props.options.submit ?? language.t("common.submit")}
+          </Button>
+        </DialogFooter>
+      </form>
+    </Dialog>
+  )
+}
+
+/** `Dialogs.select`: a searchable list in the command palette's dialog. Rows are keyed by their index. */
+export function PluginSelectDialog<T>(props: { options: SelectOptions<T>; done: (value: T | undefined) => void }) {
+  const language = useLanguage()
+  const [store, setStore] = createStore({ query: "" })
+
+  const rows = createMemo(() =>
+    props.options.options.map((option, index) => ({
+      key: String(index),
+      option,
+      title: option.title,
+      description: option.description ?? "",
+    })),
+  )
+
+  const results = createMemo(() => {
+    const query = store.query.trim()
+
+    if (!query) return rows()
+
+    return fuzzysort.go(query, rows(), { keys: ["title", "description"] }).map((result) => result.obj)
+  })
+
+  return (
+    <Dialog class="command-palette" size="large">
+      <div class="sr-only">
+        <DialogTitle>{props.options.title}</DialogTitle>
+      </div>
+      <DialogBody class="command-palette-body">
+        <SearchList
+          query={store.query}
+          onQuery={(query) => setStore("query", query)}
+          placeholder={props.options.placeholder ?? language.t("common.search.placeholder")}
+          label={props.options.title}
+          items={results()}
+          key={(row) => row.key}
+          section={(row) => row.option.group ?? ""}
+          header={(row) => row.option.group || undefined}
+          empty={language.t("palette.empty")}
+          ref={(handle) => {
+            const current = rows().find((row) => row.option.value === props.options.current)
+
+            if (current) handle.setActive(current.key)
+          }}
+          onSelect={(row) => props.done(row.option.value)}
+          onClose={() => props.done(undefined)}
+        >
+          {(row, attrs) => (
+            <button type="button" class="command-palette-row group" {...attrs}>
+              <div class="command-palette-row-main">
+                <div class="command-palette-row-text">
+                  <span class="command-palette-title palette-menu-title">
+                    <SearchHighlight text={row().title} />
+                  </span>
+                  <Show when={row().description}>
+                    {(description) => (
+                      <span class="command-palette-description">
+                        <SearchHighlight text={description()} />
+                      </span>
+                    )}
+                  </Show>
+                </div>
+              </div>
+            </button>
+          )}
+        </SearchList>
+      </DialogBody>
+    </Dialog>
+  )
+}
diff --git a/packages/app/src/runtime/plugin/embeds.tsx b/packages/app/src/runtime/plugin/embeds.tsx
new file mode 100644
index 0000000..69a48e5
--- /dev/null
+++ b/packages/app/src/runtime/plugin/embeds.tsx
@@ -0,0 +1,482 @@
+import { createEffect, on, onCleanup, Show } from "solid-js"
+import { createStore } from "solid-js/store"
+import { createEventListener } from "@solid-primitives/event-listener"
+import { createResizeObserver } from "@solid-primitives/resize-observer"
+import { prefersReducedMotion } from "@opencode/ui/motion"
+import type { EmbedProps, Embeds } from "@opencode/plugin/gui"
+import type { Bridge } from "@opencode/plugin/gui/host"
+
+const geometry =
+  /^(inset|left|right|top|bottom|translate|transform|scale|rotate|margin|padding|flex|grid|gap|row-gap|column-gap)|(^|-)(width|height)$/
+
+type Input = {
+  readonly bridge: Bridge | undefined
+  readonly zoom: () => number
+  readonly dialog: () => boolean
+  /** A panel is moving; native views would float unclipped over the app until it lands. */
+  readonly moving: () => boolean
+}
+
+// A decoded still of the page the embed showed, and where it sits in the box, in CSS pixels.
+type Still = {
+  id: string
+  page: string | undefined
+  x: number
+  y: number
+  width: number
+  height: number
+  url: string
+  image: HTMLImageElement
+}
+
+/** Main-process embeds laid out over the DOM box a plugin renders for them. */
+export function createEmbeds(input: Input): Embeds {
+  return {
+    View: (props) => {
+      const bridge = input.bridge
+
+      // Without the desktop bridge there is no embed; the box still renders its children.
+      if (!bridge) return <div class={props.class}>{props.children}</div>
+
+      return <EmbedView {...props} input={input} bridge={bridge} />
+    },
+    capture: (id) => input.bridge?.capture(id) ?? Promise.resolve(undefined),
+  }
+}
+
+function EmbedView(props: EmbedProps & { input: Input; bridge: Bridge }) {
+  const [store, setStore] = createStore<{
+    visible: boolean
+    snapshot: { id: string; url: string; presented: boolean } | undefined
+    still: Still | undefined
+    flying: boolean
+  }>({
+    visible: typeof document === "undefined" || document.visibilityState === "visible",
+    // A still of the embed shown in the DOM while floating content covers the hidden native view.
+    snapshot: undefined,
+    // The latest still of the shown page, which stands in for it while a panel flight hides the native view.
+    still: undefined,
+    flying: false,
+  })
+
+  let element: HTMLDivElement | undefined
+  let frame: number | undefined
+  let layout: string | undefined
+  let until = 0
+  let capturing: string | undefined
+  let release: ReturnType<typeof setTimeout> | undefined
+  // The embed the last layout went to; it hides when another one takes the box.
+  let placed: string | undefined
+  // Where the shown native view sits in the box, in CSS pixels; undefined while it is off screen.
+  let onscreen: Omit<Still, "page" | "url" | "image"> | undefined
+  let warming: ReturnType<typeof setTimeout> | undefined
+  let landing: ReturnType<typeof setTimeout> | undefined
+  let stilling: string | undefined
+  // The kept still's JPEG length, and how long to wait before the next still.
+  let bytes = 0
+  let pause = 3000
+  // Whether the window has focus, as main reports it: focus inside an embed blurs this document but not the window.
+  let focused = document.hasFocus()
+  const canvas = document.createElement("canvas")
+  canvas.width = canvas.height = 1
+  const paint = canvas.getContext("2d", { willReadFrequently: true })
+
+  // Let the browser resolve colors, including custom themes using color formats
+  // that Electron's color parser cannot read.
+  const resolve = (color: string) => {
+    if (!paint) return undefined
+    paint.clearRect(0, 0, 1, 1)
+    paint.fillStyle = color
+    paint.fillRect(0, 0, 1, 1)
+    const data = paint.getImageData(0, 0, 1, 1).data
+
+    return [data[0], data[1], data[2], data[3]] as const
+  }
+
+  const hide = () => {
+    if (placed) props.bridge.embed(placed)
+    placed = undefined
+    onscreen = undefined
+    clearTimeout(warming)
+  }
+
+  // A panel flight hides the native view, which no DOM box clips. Keep a recent still for it: one once the shown
+  // view's layout settles, then more while it stays on screen and the window has focus, never one per frame. A page
+  // that stops changing is captured less and less often.
+  const warm = (delay: number) => {
+    clearTimeout(warming)
+    // Reduced motion lands panels at once, so no flight needs a still.
+    warming = setTimeout(() => {
+      if (onscreen && !props.input.moving() && !prefersReducedMotion() && focused) take()
+    }, delay)
+  }
+
+  const take = () => {
+    const placement = onscreen && { ...onscreen, page: props.page }
+
+    if (!placement || stilling === placement.id) return
+    stilling = placement.id
+    void props.bridge
+      .capture(placement.id)
+      .catch(() => undefined)
+      .then(async (data) => {
+        // The same JPEG length as the still already kept: the page has most likely not changed.
+        const unchanged = !!data && store.still?.id === placement.id && data.length === bytes
+        bytes = data?.length ?? 0
+        pause = unchanged ? Math.min(pause * 2, 60_000) : 3000
+
+        if (unchanged) {
+          if (stilling === placement.id) stilling = undefined
+
+          if (onscreen?.id === placement.id) warm(pause)
+
+          return
+        }
+
+        const url = data ? URL.createObjectURL(new Blob([new Uint8Array(data)], { type: "image/jpeg" })) : undefined
+        const image = new Image()
+
+        if (url) image.src = url
+
+        const ready =
+          !!url &&
+          (await image
+            .decode()
+            .then(() => true)
+            .catch(() => false))
+
+        // Another embed took the box, or the view was disposed, while this one captured.
+        const current = stilling === placement.id
+
+        if (current) stilling = undefined
+
+        if (!url || !ready || !current || props.id !== placement.id || props.page !== placement.page) {
+          if (url) URL.revokeObjectURL(url)
+
+          if (current && onscreen?.id === placement.id) warm(pause)
+
+          return
+        }
+
+        const previous = store.still?.url
+        image.alt = ""
+        image.draggable = false
+        image.className = "absolute max-w-none pointer-events-none select-none"
+        Object.assign(image.style, {
+          left: `${placement.x}px`,
+          top: `${placement.y}px`,
+          width: `${placement.width}px`,
+          height: `${placement.height}px`,
+        })
+        setStore("still", { ...placement, url, image })
+
+        if (previous) URL.revokeObjectURL(previous)
+
+        if (onscreen?.id === placement.id) warm(pause)
+      })
+  }
+
+  const fly = (moving: boolean) => {
+    clearTimeout(landing)
+
+    if (moving) return setStore("flying", true)
+
+    // A panel that landed closed is gone; one that landed open keeps the still under its view until the view paints.
+    if (!props.visible) return setStore("flying", false)
+    landing = setTimeout(() => setStore("flying", false), 150)
+  }
+
+  // The native embed always paints above the DOM, so hide it while a floating
+  // menu, select, or popover overlaps it. Tooltips are excluded.
+  const covered = (rect: DOMRect) =>
+    Array.from(document.querySelectorAll('[data-popper-positioner]:not(:has([role="tooltip"]))')).some((el) => {
+      const r = el.getBoundingClientRect()
+
+      return r.width > 0 && r.left < rect.right && r.right > rect.left && r.top < rect.bottom && r.bottom > rect.top
+    })
+
+  const replaceSnapshot = (next?: { id: string; url: string; presented: boolean }) => {
+    if (store.snapshot?.url) URL.revokeObjectURL(store.snapshot.url)
+    setStore("snapshot", next)
+  }
+
+  // Keep the embed on screen as a still under the floating content. The native view
+  // stays visible until the still is on screen, so the box never flashes blank.
+  const freeze = (id: string) => {
+    clearTimeout(release)
+    release = undefined
+
+    if (store.snapshot?.id === id || capturing === id) return
+    capturing = id
+    void props.bridge
+      .capture(id)
+      .catch(() => undefined)
+      .then(async (data) => {
+        const url = data ? URL.createObjectURL(new Blob([new Uint8Array(data)], { type: "image/jpeg" })) : ""
+        const image = new Image()
+
+        if (url) image.src = url
+
+        const decoded =
+          !!url &&
+          (await image
+            .decode()
+            .then(() => true)
+            .catch(() => false))
+
+        if (capturing !== id) {
+          if (url) URL.revokeObjectURL(url)
+
+          return
+        }
+
+        capturing = undefined
+        // A failed capture still hides the embed; the box shows its background as before. A still that
+        // cannot decode never paints, so Element Timing would never report it.
+        replaceSnapshot({ id, url, presented: !decoded })
+        schedule()
+      })
+  }
+
+  // Main hides the native view at once, but a still reaches the screen only a few frames after it
+  // enters the DOM, so wait for Element Timing to report the frame that presents it.
+  const presentation = new PerformanceObserver((list) => {
+    const snapshot = store.snapshot
+
+    if (!snapshot || snapshot.presented) return
+
+    if (!list.getEntries().some((entry) => "url" in entry && entry.url === snapshot.url)) return
+    setStore("snapshot", "presented", true)
+    schedule()
+  })
+
+  presentation.observe({ type: "element" })
+  onCleanup(() => presentation.disconnect())
+
+  const thaw = () => {
+    capturing = undefined
+
+    if (!store.snapshot || release !== undefined) return
+    // Keep the still under the native view until the view has painted again.
+    release = setTimeout(() => {
+      release = undefined
+      replaceSnapshot()
+    }, 150)
+  }
+
+  const measure = () => {
+    if (!element) return
+    const id = props.id
+
+    if (!id) return hide()
+    const rect = element.getBoundingClientRect()
+    const zoom = props.input.zoom()
+    const left = Math.round(rect.left * zoom)
+    const top = Math.round(rect.top * zoom)
+    const right = Math.round(rect.right * zoom)
+    const bottom = Math.round(rect.bottom * zoom)
+    const shown = props.visible && store.visible && !props.input.moving()
+    // A dialog's scrim covers the box like floating content does, so it dims a still of the page
+    // instead of a blank box, and the page does not blink out and back as the dialog opens and closes.
+    const cover = !!props.frozen || props.input.dialog() || covered(rect)
+
+    if (shown && cover) freeze(id)
+
+    if (!cover) thaw()
+    const visible = shown && !(cover && store.snapshot?.id === id && store.snapshot.presented)
+
+    // The cutout exposes the app backdrop outside the rounded card, not the embed inside it.
+    const color =
+      props.background ??
+      getComputedStyle(element.closest(".bg-v2-background-bg-deep") ?? document.documentElement).backgroundColor
+
+    const ring = props.radius ? cardRing(element) : undefined
+    const viewport = { width: Math.round(window.innerWidth * zoom), height: Math.round(window.innerHeight * zoom) }
+
+    const next = `${id}:${visible}:${left}:${top}:${right}:${bottom}:${viewport.width}:${viewport.height}:${color}:${ring?.color}:${ring?.width}:${window.devicePixelRatio}`
+
+    if (next === layout) return
+    layout = next
+
+    const background = resolve(color)
+    const border = ring && resolve(ring.color)
+
+    if (placed !== id) hide()
+    placed = id
+    // The still lines up with the view's device-pixel-rounded bounds, so swapping one for the other moves nothing.
+    onscreen = visible
+      ? {
+          id,
+          x: left / zoom - rect.left,
+          y: top / zoom - rect.top,
+          width: Math.max(0, right - left) / zoom,
+          height: Math.max(0, bottom - top) / zoom,
+        }
+      : undefined
+
+    if (onscreen) warm(600)
+    else clearTimeout(warming)
+
+    const box = {
+      visible,
+      bounds: { x: left, y: top, width: Math.max(0, right - left), height: Math.max(0, bottom - top) },
+      viewport,
+      radius: Math.round((props.radius ?? 0) * zoom),
+    }
+
+    const backed = background ? { ...box, background } : box
+
+    props.bridge.embed(
+      id,
+      ring && border && border[3] > 0 ? { ...backed, border: { color: border, width: ring.width * zoom } } : backed,
+    )
+  }
+
+  const tick = () => {
+    frame = undefined
+    measure()
+
+    if (performance.now() < until) frame = requestAnimationFrame(tick)
+  }
+
+  const schedule = (duration = 0) => {
+    until = Math.max(until, performance.now() + duration)
+
+    if (frame === undefined) frame = requestAnimationFrame(tick)
+  }
+
+  // A flight paints the still in the view's place. One that starts with the view on screen, like a close, first asks
+  // for a fresh still, before the effect below hides the view; one that opens the pane shows the last still.
+  createEffect(
+    on([props.input.moving, () => props.visible], ([moving]) => {
+      if (!moving) return fly(false)
+
+      if (store.flying || (!onscreen && !props.visible)) return
+      take()
+      fly(true)
+    }),
+  )
+  // A navigation or reload makes the kept still another page's.
+  createEffect(
+    on(
+      () => props.page,
+      () => {
+        if (store.still) URL.revokeObjectURL(store.still.url)
+        setStore("still", undefined)
+        bytes = 0
+        pause = 3000
+
+        if (onscreen) warm(600)
+      },
+      { defer: true },
+    ),
+  )
+  createEffect(
+    on(
+      [
+        props.input.zoom,
+        props.input.dialog,
+        props.input.moving,
+        () => store.visible,
+        () => props.visible,
+        () => props.id,
+        () => props.frozen,
+      ],
+      () => {
+        layout = undefined
+
+        // The native views are not clipped by the retained panel's DOM. Hide before the next
+        // animation frame so closing the panel cannot leave the embed above the app.
+        if (!props.visible || !store.visible || props.input.moving() || !props.id) return hide()
+        schedule(300)
+      },
+    ),
+  )
+  // ResizeObserver runs after layout in the same frame; measuring here instead of on the next
+  // animation frame keeps the native view in step with a region drag.
+  createResizeObserver(() => element, measure)
+  createEventListener(window, "resize", () => schedule(300))
+  // A layout transition elsewhere, such as the chat column's width while the side pane opens, can
+  // move the box without resizing it. Track it from when it actually runs, and settle on its end.
+  createEventListener(document, "transitionrun", (event) => {
+    if (geometry.test(event.propertyName)) schedule(300)
+  })
+  createEventListener(document, ["transitionend", "transitioncancel"], (event) => {
+    if (geometry.test(event.propertyName)) schedule()
+  })
+  // Floating content portals directly into <body>; keep measuring briefly so
+  // the positioner has settled before the overlap check runs.
+  const portals = new MutationObserver(() => schedule(300))
+  portals.observe(document.body, { childList: true })
+  onCleanup(() => portals.disconnect())
+  const appearance = new MutationObserver(() => schedule(300))
+  appearance.observe(document.documentElement, { attributes: true, attributeFilter: ["style", "data-theme"] })
+  onCleanup(() => appearance.disconnect())
+  createEventListener(window.matchMedia("(prefers-color-scheme: dark)"), "change", () => schedule(300))
+  createEventListener(document, "visibilitychange", () => setStore("visible", document.visibilityState === "visible"))
+
+  // Stills pause while the window is in the background; the page may have moved on since the last one.
+  const refocus = (next: boolean) => {
+    focused = next
+
+    if (focused) warm(0)
+  }
+
+  createEventListener(window, "focus", () => refocus(true))
+  onCleanup(
+    props.bridge.on((message) => {
+      if (message.type === "focus") refocus(message.focused)
+    }),
+  )
+  onCleanup(() => {
+    if (frame !== undefined) cancelAnimationFrame(frame)
+    clearTimeout(release)
+    clearTimeout(landing)
+    capturing = undefined
+    stilling = undefined
+    replaceSnapshot()
+
+    if (store.still) URL.revokeObjectURL(store.still.url)
+    hide()
+  })
+
+  return (
+    <div ref={element} class={props.class}>
+      <Show when={store.flying && store.still?.id === props.id && store.still?.page === props.page && store.still}>
+        {(still) => <div class="absolute inset-0 overflow-hidden pointer-events-none">{still().image}</div>}
+      </Show>
+      <Show when={store.snapshot?.id === props.id && props.visible && store.snapshot?.url}>
+        {(url) => (
+          <img
+            src={url()}
+            alt=""
+            elementtiming="embed-snapshot"
+            draggable={false}
+            class="absolute inset-0 size-full pointer-events-none select-none"
+          />
+        )}
+      </Show>
+      {props.children}
+    </div>
+  )
+}
+
+// The hairline ring (a zero-offset, zero-blur, spread-only shadow) of the nearest card around the box.
+// The corner masks sit where it curves, so they redraw it.
+function cardRing(element: HTMLElement) {
+  for (let node = element.parentElement; node; node = node.parentElement) {
+    const shadow = getComputedStyle(node).boxShadow
+
+    if (shadow === "none") continue
+
+    return shadow
+      .split(/,(?![^(]*\))/)
+      .map((layer) => layer.trim().match(/^(.+?)\s+(-?[\d.]+)px\s+(-?[\d.]+)px\s+([\d.]+)px\s+([\d.]+)px$/))
+      .flatMap((match) =>
+        match && +match[2] === 0 && +match[3] === 0 && +match[4] === 0 && +match[5] > 0
+          ? [{ color: match[1], width: +match[5] }]
+          : [],
+      )
+      .at(0)
+  }
+}
