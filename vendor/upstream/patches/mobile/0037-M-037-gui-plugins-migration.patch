+   * The release channel.
+   * - `local`: a build from source, with no channel set.
+   * - `dev`: the development channel.
+   * - `beta`: the beta channel.
+   * - `prod`: the stable release.
+   */
+  readonly channel: "local" | "dev" | "beta" | "prod"
