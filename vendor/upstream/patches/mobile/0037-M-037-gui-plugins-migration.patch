+[data-component="search-list"] {
+  /* Sticky headers and the top fade paint this, so rows scroll under an opaque band. */
+  --search-list-surface: var(--v2-background-bg-base);
+
+  display: flex;
+  min-height: 0;
+  flex: 1;
+  flex-direction: column;
+
+  [data-slot="search-list-search"] {
+    flex-shrink: 0;
+    padding: 6px;
+
+    [data-component="text-input-v2"] {
+      width: 100%;
+      height: 36px;
+      padding-inline-end: 12px;
+      border-radius: 6px;
+      outline: 0;
+      background: color-mix(in srgb, var(--v2-background-bg-layer-02) 60%, transparent);
+      box-shadow: none;
+      transition:
+        background-color 120ms ease-in-out,
+        box-shadow 120ms ease-in-out;
+    }
+
+    [data-component="text-input-v2"]:where(:hover, :focus-within):not([data-disabled], [data-invalid]) {
+      background: var(--v2-background-bg-layer-02);
+      box-shadow: none;
+    }
+
+    [data-slot="text-input-v2-value"] {
+      gap: 8px;
+      border-radius: 6px;
+      background: transparent;
+    }
+
+    [data-slot="text-input-v2-leading-icon"] {
+      padding-inline-start: 12px;
+    }
+
+    [data-slot="text-input-v2-input"] {
+      border-radius: 6px;
+      background: transparent;
+    }
+  }
+
+  [data-slot="search-list-body"] {
+    display: flex;
+    min-height: 0;
+    flex: 1;
+    flex-direction: column;
+
+    &[hidden] {
+      display: none;
+    }
+  }
+
+  /* Arrow keys scroll the active row clear of the sticky header. Rows fade out past the bottom edge while more follow. */
+  [data-slot="search-list-scroll"] {
+    min-height: 0;
+    flex: 1;
+    overflow-y: auto;
+    --search-list-edge: linear-gradient(
+      to bottom,
+      #000 calc(100% - 24px),
+      rgb(0 0 0 / calc(1 - var(--search-list-fade-bottom, 0)))
+    );
+    scroll-padding-top: 28px;
+    -webkit-mask-image: var(--search-list-edge);
+    mask-image: var(--search-list-edge);
+  }
+
+  /* Rows fade out under the top section's header, or under the field when it has none. Headers stay above the fade. */
+  [data-slot="search-list-fade"] {
+    position: sticky;
+    top: 0;
+    z-index: 1;
+    height: 0;
+    pointer-events: none;
+
+    &::before {
+      position: absolute;
+      inset: var(--search-list-fade-offset, 0px) 0 auto;
+      height: 24px;
+      background: linear-gradient(var(--search-list-surface), transparent);
+      content: "";
+      opacity: var(--search-list-fade-top, 0);
+    }
+  }
+
+  [data-slot="search-list-results"] {
+    display: flex;
+    flex-direction: column;
+    padding: 6px 6px 8px;
+
+    /* Its padding would sit above the empty state and push it below the centre. */
+    &[hidden] {
+      display: none;
+    }
+  }
+
+  [data-slot="search-list-section"] {
+    display: flex;
+    flex-direction: column;
+    gap: 1px;
+
+    /* Space inside the section, not between sections, so the next header meets this one and pushes it up. */
+    &:not(:last-child) {
+      padding-bottom: 16px;
+    }
+  }
+
+  /* The header bleeds to the list's edges so rows scroll under an opaque band, and its text stays on the rows' spine. */
+  [data-slot="search-list-header"] {
+    position: sticky;
+    top: 0;
+    z-index: 2;
+    display: flex;
+    flex-shrink: 0;
+    align-items: center;
+    gap: 6px;
+    height: 28px;
+    margin-inline: -6px;
+    padding-inline: 18px;
+    background: var(--search-list-surface);
+    color: var(--v2-text-text-muted);
+    font-size: 13px;
+    font-weight: 440;
+    line-height: var(--line-height-compact);
+    letter-spacing: -0.04px;
+    user-select: none;
+  }
+
+  [data-slot="search-list-row"] {
+    display: flex;
+    width: 100%;
+    height: 36px;
+    flex-shrink: 0;
+    align-items: center;
+    justify-content: space-between;
+    gap: 8px;
+    padding: 0 12px;
+    border: 0;
+    border-radius: 6px;
+    background: transparent;
+    color: var(--v2-text-text-base);
+    text-align: start;
+    cursor: default;
+    scroll-margin-block: 0 24px;
+
+    &[data-active] {
+      background: var(--v2-overlay-simple-overlay-hover);
+      outline: none;
+    }
+
+    &[data-size="compact"] {
+      height: 28px;
+    }
+  }
+
+  /* A row under the one above it keeps clear of the fade beneath the header; a section's first row sits right under it. */
+  [data-slot="search-list-row"] + [data-slot="search-list-row"] {
+    scroll-margin-top: 24px;
+  }
+
+  [data-slot="search-list-match"] {
+    background: transparent;
+    color: var(--v2-text-text-accent);
+  }
+
+  [data-slot="search-list-empty"] {
+    display: grid;
+    min-height: 120px;
+    place-items: center;
+    color: var(--v2-text-text-muted);
+    font-size: 13px;
+    font-weight: 440;
+    line-height: var(--line-height-compact);
+    letter-spacing: -0.04px;
+  }
+
+  /* On the rows' text spine, under the bottom fade rather than inside it. */
+  [data-slot="search-list-footer"] {
+    flex-shrink: 0;
+    padding: 4px 18px 12px;
+    color: var(--v2-text-text-muted);
+    font-size: 13px;
+    font-weight: 440;
+    line-height: var(--line-height-compact);
+    letter-spacing: -0.04px;
+  }
+
+  &[data-popover] {
+    --search-list-surface: var(--v2-background-bg-layer-01);
+
+    position: relative;
+    flex: none;
+
+    [data-slot="search-list-body"] {
+      position: absolute;
+      inset-block-start: calc(100% + 4px);
+      inset-inline: 0;
+      z-index: 12;
+      max-height: min(45vh, 480px);
+      overflow: hidden;
+      border-radius: 8px;
+      background: var(--search-list-surface);
+      box-shadow: var(--v2-elevation-floating);
+    }
+
+    [data-slot="search-list-scroll"] {
+      flex: 0 1 auto;
+    }
+  }
+}
+
+[data-color-scheme="dark"] [data-component="search-list"] [data-slot="search-list-row"][data-active] {
+  background: var(--v2-alpha-light-10);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  [data-component="search-list"] {
+    [data-slot="search-list-search"] [data-component="text-input-v2"] {
+      transition: none;
+    }
+  }
+}
diff --git a/packages/ui/src/forms/search-list/search-list.tsx b/packages/ui/src/forms/search-list/search-list.tsx
new file mode 100644
index 0000000..6d5a206
--- /dev/null
+++ b/packages/ui/src/forms/search-list/search-list.tsx
@@ -0,0 +1,409 @@
+import {
+  createContext,
+  createEffect,
+  createMemo,
+  For,
+  type JSX,
+  on,
+  onCleanup,
+  onMount,
+  Show,
+  useContext,
+} from "solid-js"
+import { createResizeObserver } from "@solid-primitives/resize-observer"
+import { Icon } from "@opencode/ui/icon"
+import { TextInput } from "../text-input/text-input"
+import { createTypeahead } from "../typeahead/controller"
+import { searchListMove, searchListTarget } from "./navigation"
+import "./search-list.css"
+
+/** Attributes for a row's element: spread them, then override a handler to change what the pointer does. */
+export type SearchListRow = {
+  id: string
+  role: "option"
+  "aria-selected": boolean
+  "data-slot": "search-list-row"
+  "data-active": "" | undefined
+  onMouseMove: (event: MouseEvent) => void
+  onMouseDown: (event: MouseEvent) => void
+  onClick: () => void
+}
+
+/** Attributes for the input of a field passed as `field`: spread them onto it. */
+export type SearchListField = {
+  role: "combobox"
+  "aria-expanded": boolean
+  "aria-autocomplete": "list"
+  "aria-controls": string | undefined
+  "aria-activedescendant": string | undefined
+  onInput: (event: InputEvent & { currentTarget: HTMLInputElement }) => void
+  onKeyDown: (event: KeyboardEvent) => void
+}
+
+export type SearchListHandle<T> = {
+  active: () => T | undefined
+  setActive: (key: string | undefined) => void
+}
+
+const QueryContext = createContext<() => string>(() => "")
+
+/**
+ * A search field over sectioned results. Rows that share a `section` key list together under one header, which sticks
+ * while its rows scroll beneath it until the next header pushes it away. The first row is active until the user picks
+ * another: ↑/↓ wrap, ⌘ or ⌥ with ↑/↓ jump between sections, Home/End go to the ends, Enter selects and Escape closes.
+ * A page can keep its own field through `field` and float the results beneath it with `popover`.
+ */
+export function SearchList<T>(props: {
+  query: string
+  onQuery: (query: string) => void
+  placeholder: string
+  /** The results' accessible name; the placeholder by default. */
+  label?: string
+  /** Controls after the field, such as icon buttons. */
+  trailing?: JSX.Element
+  /** A search field of the page's own in place of the built-in one. */
+  field?: (field: SearchListField) => JSX.Element
+  /** Whether the results show. Closed, only the field remains and the list leaves keys to the page. On by default. */
+  open?: boolean
+  /** Float the results beneath the field on a raised surface, over what follows it. */
+  popover?: boolean
+  items: T[]
+  key: (item: T) => string
+  section?: (item: T) => string
+  /** Rows that show the same thing in two sections. ↑/↓ step past a copy, so the highlight always lands somewhere new. */
+  same?: (a: T, b: T) => boolean
+  /** A section's header, from its first row. */
+  header?: (item: T) => JSX.Element
+  /** Shown in place of the rows when there are none. */
+  empty: JSX.Element
+  /** A note beneath the rows, such as a hint that more results are hidden. */
+  footer?: JSX.Element
+  /** Where the results start scrolled each time they mount, such as a position kept from an earlier visit. */
+  scrollTop?: number
+  onScroll?: (scrollTop: number) => void
+  onSelect: (item: T) => void
+  onActive?: (item: T | undefined) => void
+  /** Runs before the list's own keys; call `preventDefault` to claim one. */
+  onKeyDown?: (event: KeyboardEvent, active: T | undefined) => void
+  onClose?: () => void
+  ref?: (handle: SearchListHandle<T>) => void
+  class?: string
+  /** A row. `item` stays current while results with the same key replace it, so the row keeps its element. */
+  children: (item: () => T, row: SearchListRow) => JSX.Element
+}) {
+  let viewport: HTMLDivElement | undefined
+  let results: HTMLDivElement | undefined
+
+  const sectionOf = (item: T) => props.section?.(item) ?? ""
+  const open = () => props.open ?? true
+
+  // Sections in the order their first row arrives; rows then list section by section, which is also the arrow order.
+  const groups = createMemo(() => {
+    const all = new Map<string, T[]>()
+
+    props.items.forEach((item) => {
+      const list = all.get(sectionOf(item))
+
+      if (list) list.push(item)
+      else all.set(sectionOf(item), [item])
+    })
+
+    return all
+  })
+
+  const rows = createMemo(() => [...groups().values()].flat())
+  const byKey = createMemo(() => new Map(rows().map((item) => [props.key(item), item] as const)))
+  const sectionKeys = createMemo<string[]>((previous) => stable(previous, [...groups().keys()]))
+
+  const typeahead = createTypeahead<T>({
+    items: rows,
+    key: (item) => props.key(item),
+    onSelect: (item) => props.onSelect(item),
+    onClose: props.onClose && (() => props.onClose?.()),
+  })
+
+  const activeKey = createMemo(() => {
+    const item = typeahead.activeItem()
+
+    return item === undefined ? undefined : props.key(item)
+  })
+
+  // The first row shows from the top, so its header is never hidden; any other row scrolls in only as far as needed.
+  const reveal = () => {
+    const item = typeahead.activeItem()
+
+    if (!viewport) return
+
+    if (item === undefined || item === rows()[0]) return viewport.scrollTo({ top: 0 })
+    document.getElementById(typeahead.optionID(item))?.scrollIntoView({ block: "nearest" })
+  }
+
+  // Rows fade out where they run under the top header or past the bottom edge. Each fade reaches full strength once
+  // 15 px is hidden, so it eases in with the scroll. The top fade follows the header over the topmost section and
+  // measures what that section has hidden, so a header that pushes the last one away starts clear again. Sections are
+  // measured when the list lays out, so scrolling only does arithmetic.
+  let sections: { top: number; bottom: number; header: number }[] = []
+
+  const edges = () => {
+    if (!viewport) return
+    const scroll = viewport.scrollTop
+    const strength = (hidden: number) => String(Math.min(1, Math.max(0, hidden / 15)))
+    const current = sections.findLast((section) => section.top - scroll < section.header)
+
+    // A stuck header sits at the top until its section's end pushes it up.
+    const offset = current?.header
+      ? Math.min(Math.max(current.top - scroll, 0) + current.header, current.bottom - scroll)
+      : 0
+
+    viewport.style.setProperty("--search-list-fade-offset", `${Math.max(0, offset)}px`)
+    viewport.style.setProperty("--search-list-fade-top", strength(current ? scroll - current.top : 0))
+    viewport.style.setProperty(
+      "--search-list-fade-bottom",
+      strength(viewport.scrollHeight - viewport.clientHeight - scroll),
+    )
+  }
+
+  const measure = () => {
+    if (!viewport) return
+    const origin = viewport.getBoundingClientRect().top - viewport.scrollTop
+
+    sections = [...viewport.querySelectorAll<HTMLElement>('[data-slot="search-list-section"]')].map((section) => {
+      const rect = section.getBoundingClientRect()
+
+      // A sticky header stays inside its section's content box, so the section's bottom padding is out of its reach.
+      return {
+        top: rect.top - origin,
+        bottom: rect.bottom - origin - parseFloat(getComputedStyle(section).paddingBottom),
+        header: section.querySelector<HTMLElement>('[data-slot="search-list-header"]')?.offsetHeight ?? 0,
+      }
+    })
+    edges()
+  }
+
+  createResizeObserver(() => [viewport, results], measure)
+  createEffect(on(rows, measure, { defer: true }))
+
+  createEffect(() => props.onActive?.(typeahead.activeItem()))
+
+  // A new query starts from the top. Results that arrive later for the same query bring a chosen row back into view,
+  // but leave the list where the wheel put it while the first row is still the default.
+  let revealed = props.query
+
+  createEffect(
+    on(
+      rows,
+      (all) => {
+        const fresh = props.query !== revealed
+        revealed = props.query
+
+        if (!fresh && typeahead.activeItem() === all[0]) return
+        const frame = requestAnimationFrame(reveal)
+        onCleanup(() => cancelAnimationFrame(frame))
+      },
+      { defer: true },
+    ),
+  )
+
+  props.ref?.({ active: typeahead.activeItem, setActive: typeahead.setActive })
+
+  const onKeyDown = (event: KeyboardEvent) => {
+    if (event.isComposing) return
+    props.onKeyDown?.(event, typeahead.activeItem())
+
+    if (event.defaultPrevented || !open()) return
+    const move = searchListMove(event)
+
+    if (!move) return typeahead.onKeyDown(event)
+    event.preventDefault()
+    event.stopPropagation()
+    const all = rows()
+    const sections = all.map(sectionOf)
+    const active = typeahead.activeItem()
+    const from = active === undefined ? -1 : all.indexOf(active)
+
+    const step = (index: number): number => {
+      const next = searchListTarget(sections, index, move)
+      const copy = (move === "next" || move === "previous") && active !== undefined && next !== from
+
+      return copy && props.same?.(all[next]!, active) ? step(next) : next
+    }
+
+    const target = all[step(from)]
+
+    if (target === undefined) return
+    typeahead.setActive(props.key(target))
+    reveal()
+  }
+
+  onMount(() => {
+    if (viewport && props.scrollTop) viewport.scrollTop = props.scrollTop
+  })
+
+  const field: SearchListField = {
+    role: "combobox",
+    get "aria-expanded"() {
+      return open()
+    },
+    "aria-autocomplete": "list",
+    get "aria-controls"() {
+      return open() ? typeahead.listID : undefined
+    },
+    get "aria-activedescendant"() {
+      return open() ? typeahead.activeID() : undefined
+    },
+    onInput: (event) => {
+      // A new query starts again from its first row.
+      typeahead.setActive(undefined)
+      props.onQuery(event.currentTarget.value)
+    },
+    onKeyDown,
+  }
+
+  const row = (key: string, item: () => T): SearchListRow => ({
+    get id() {
+      return typeahead.optionID(item())
+    },
+    role: "option",
+    get "aria-selected"() {
+      return activeKey() === key
+    },
+    "data-slot": "search-list-row",
+    get "data-active"() {
+      return activeKey() === key ? ("" as const) : undefined
+    },
+    onMouseMove: (event) => {
+      // A static cursor must not take the active row while the keyboard scrolls rows beneath it.
+      if (event.movementX !== 0 || event.movementY !== 0) typeahead.setActive(key)
+    },
+    // Focus stays in the field.
+    onMouseDown: (event) => event.preventDefault(),
+    onClick: () => props.onSelect(item()),
+  })
+
+  return (
+    <QueryContext.Provider value={() => props.query}>
+      <div data-component="search-list" data-popover={props.popover ? "" : undefined} class={props.class}>
+        <Show
+          when={props.field}
+          fallback={
+            <div data-slot="search-list-search">
+              <TextInput
+                {...field}
+                value={props.query}
+                autofocus
+                autocomplete="off"
+                autocorrect="off"
+                autocapitalize="off"
+                spellcheck={false}
+                appearance="large"
+                placeholder={props.placeholder}
+                aria-label={props.placeholder}
+                leadingIcon={<Icon name="magnifying-glass" />}
+                trailing={props.trailing}
+              />
+            </div>
+          }
+        >
+          {(custom) => custom()(field)}
+        </Show>
+        <div data-slot="search-list-body" hidden={!open()}>
+          <div
+            data-slot="search-list-scroll"
+            data-scrollable
+            ref={(element) => (viewport = element)}
+            onScroll={(event) => {
+              edges()
+              props.onScroll?.(event.currentTarget.scrollTop)
+            }}
+          >
+            <div data-slot="search-list-fade" aria-hidden="true" />
+            <div
+              ref={results}
+              id={typeahead.listID}
+              data-slot="search-list-results"
+              role="listbox"
+              hidden={rows().length === 0}
+              aria-label={props.label ?? props.placeholder}
+            >
+              <For each={sectionKeys()}>
+                {(section) => {
+                  const keys = createMemo<string[]>((previous) =>
+                    stable(previous, (groups().get(section) ?? []).map(props.key)),
+                  )
+
+                  const first = () => byKey().get(keys()[0] ?? "")
+
+                  const header = createMemo(() =>
+                    props.header && first() !== undefined ? props.header(first()!) : undefined,
+                  )
+
+                  const id = `${typeahead.listID}-section-${encodeURIComponent(section)}`
+
+                  return (
+                    <div data-slot="search-list-section" role="group" aria-labelledby={header() ? id : undefined}>
+                      <Show when={header()}>
+                        {(content) => (
+                          <div id={id} data-slot="search-list-header">
+                            {content()}
+                          </div>
+                        )}
+                      </Show>
+                      <For each={keys()}>
+                        {(key) => {
+                          // A row that is leaving keeps its last item until it is removed.
+                          const item = createMemo<T>((previous) => byKey().get(key) ?? previous, byKey().get(key)!)
+
+                          return props.children(item, row(key, item))
+                        }}
+                      </For>
+                    </div>
+                  )
+                }}
+              </For>
+            </div>
+            <Show when={rows().length === 0}>
+              <div data-slot="search-list-empty">{props.empty}</div>
+            </Show>
+          </div>
+          <Show when={props.footer}>
+            <div data-slot="search-list-footer">{props.footer}</div>
+          </Show>
+        </div>
+      </div>
+    </QueryContext.Provider>
+  )
+}
+
+/** Text with its first match for the list's query marked. One mark per row keeps short queries from speckling the list. */
+export function SearchHighlight(props: { text: string }) {
+  const query = useContext(QueryContext)
+
+  const match = createMemo(() => {
+    const needle = query().trim().toLowerCase()
+    const haystack = props.text.toLowerCase()
+    const at = needle ? haystack.indexOf(needle) : -1
+
+    // Lower-casing a few scripts changes the length, and then offsets no longer line up with the text.
+    if (at === -1 || haystack.length !== props.text.length) return
+
+    return { at, end: at + needle.length }
+  })
+
+  return (
+    <Show when={match()} fallback={props.text}>
+      {(range) => (
+        <>
+          {props.text.slice(0, range().at)}
+          <mark data-slot="search-list-match">{props.text.slice(range().at, range().end)}</mark>
+          {props.text.slice(range().end)}
+        </>
+      )}
+    </Show>
+  )
+}
+
+function stable(previous: string[] | undefined, next: string[]) {
+  return previous && previous.length === next.length && previous.every((value, index) => value === next[index])
+    ? previous
+    : next
+}
diff --git a/packages/ui/src/forms/typeahead/controller.ts b/packages/ui/src/forms/typeahead/controller.ts
new file mode 100644
index 0000000..85d5746
--- /dev/null
+++ b/packages/ui/src/forms/typeahead/controller.ts
@@ -0,0 +1,59 @@
+import { createEffect, createMemo, createUniqueId } from "solid-js"
+import { createStore } from "solid-js/store"
+
+/** The active row, keys and combobox ids for a search input above a list of options. */
+export function createTypeahead<T>(props: {
+  items: () => T[]
+  key: (item: T) => string
+  /** Rows on screen that the current query has not confirmed. The user's choice never rests on one. */
+  stale?: (item: T) => boolean
+  onSelect: (item: T) => void
+  onClose?: () => void
+}) {
+  const id = createUniqueId()
+  const [store, setStore] = createStore<{ active?: string }>({})
+  const chosen = () => props.items().find((item) => props.key(item) === store.active && !props.stale?.(item))
+
+  // The user's choice holds while it is among the confirmed rows; once it leaves, the first row is active again.
+  createEffect(() => {
+    if (store.active !== undefined && chosen() === undefined) setStore("active", undefined)
+  })
+
+  const activeItem = createMemo(() => chosen() ?? props.items()[0])
+  const optionID = (item: T) => `${id}-${encodeURIComponent(props.key(item))}`
+
+  return {
+    activeItem,
+    setActive: (key: string | undefined) => setStore("active", key),
+    listID: `${id}-list`,
+    optionID,
+    activeID: () => {
+      const item = activeItem()
+
+      return item === undefined ? undefined : optionID(item)
+    },
+    onKeyDown: (event: KeyboardEvent) => {
+      if (event.isComposing) return
+      const items = props.items()
+      // Modified arrows belong to the input: Shift selects text, Ctrl and the rest are the platform's.
+      const plain = !event.shiftKey && !event.ctrlKey && !event.altKey && !event.metaKey
+      const delta = !plain ? 0 : event.key === "ArrowDown" ? 1 : event.key === "ArrowUp" ? -1 : 0
+
+      if (delta !== 0 || event.key === "Enter" || (event.key === "Escape" && props.onClose)) {
+        event.preventDefault()
+        event.stopPropagation()
+      }
+
+      if (delta !== 0 && items.length > 0) {
+        const index = items.findIndex((item) => item === activeItem())
+        setStore("active", props.key(items[(index + delta + items.length) % items.length]))
+      }
+
+      const item = activeItem()
+
+      if (event.key === "Enter" && item !== undefined) props.onSelect(item)
+
+      if (event.key === "Escape") props.onClose?.()
+    },
+  }
+}
diff --git a/packages/ui/src/forms/typeahead/typeahead.tsx b/packages/ui/src/forms/typeahead/typeahead.tsx
new file mode 100644
index 0000000..c435108
--- /dev/null
+++ b/packages/ui/src/forms/typeahead/typeahead.tsx
@@ -0,0 +1,214 @@
+import { createResizeObserver } from "@solid-primitives/resize-observer"
+import { createEffect, createMemo, For, type JSX, on, onCleanup, Show } from "solid-js"
+import { createStore } from "solid-js/store"
+import { Icon } from "@opencode/ui/icon"
+import { abort } from "@opencode/util/abort"
+import { useI18n } from "../../context/i18n"
+import { Loader } from "../../feedback/loader/loader"
+import { createTypeahead } from "./controller"
+
+export { createTypeahead } from "./controller"
+
+/** A search field over results from `source` that keeps rows on screen while a query is pending. */
+export function Typeahead<T>(props: {
+  source: (query: string, signal: AbortSignal) => Promise<T[]>
+  /** Preloaded opening results, including a failed request that the user can retry. */
+  initial?: { items: T[]; failed?: boolean }
+  /** Narrows earlier results while the request for the current query is pending. */
+  match: (item: T, query: string) => boolean
+  key: (item: T) => string
+  /** Milliseconds a typed query waits before it reaches the source. */
+  delay: number
+  placeholder: string
+  emptyLabel: string
+  retryLabel: string
+  /** Key of the current value. */
+  selected?: string
+  onSelect: (item: T) => void
+  children: (item: T) => JSX.Element
+}) {
+  const i18n = useI18n()
+
+  const [store, setStore] = createStore<{
+    query: string
+    searched: boolean
+    answered?: string
+    failed?: boolean
+    loading?: boolean
+  }>({ query: "", searched: false, answered: props.initial ? "" : undefined })
+
+  const cache = new Map<string, T[]>()
+  let request: AbortController | undefined
+  let input: HTMLInputElement | undefined
+  onCleanup(() => abort(request))
+
+  const query = () => store.query.trim()
+  // The parent owns the opening list, so a refresh reaches an open panel without remounting the input.
+  const opening = () => (query() ? undefined : props.initial)
+  const failed = () => (opening() ? opening()?.failed : store.failed)
+  const pending = () => store.loading || store.answered !== query()
+
+  const search = (query: string) => {
+    abort(request)
+
+    if (cache.has(query)) return setStore({ answered: query, failed: false, loading: false })
+    const current = (request = new AbortController())
+    setStore("loading", true)
+    props.source(query, current.signal).then(
+      (items) => {
+        if (current.signal.aborted) return
+        cache.set(query, items)
+        setStore({ answered: query, failed: false, loading: false })
+      },
+      () => !current.signal.aborted && setStore({ answered: query, failed: true, loading: false }),
+    )
+  }
+
+  // A cached or empty query answers at once; a typed one waits, and the request it supersedes is aborted.
+  createEffect(
+    on(
+      query,
+      (next) => {
+        if (!next || cache.has(next)) return search(next)
+        abort(request)
+        const timer = setTimeout(() => search(next), props.delay)
+        onCleanup(() => clearTimeout(timer))
+      },
+      { defer: !!props.initial },
+    ),
+  )
+
+  // Narrow visible rows while pending; broadening waits for a cached or server answer, avoiding speculative rows flashing.
+  const results = createMemo<{ items: T[]; stale: boolean }>((previous) => {
+    const next = query()
+    const preloaded = opening()
+
+    if (preloaded) return { items: preloaded.failed ? [] : preloaded.items, stale: false }
+
+    if (store.answered === next && store.failed) return { items: [], stale: false }
+    const cached = cache.get(next) ?? previous?.items.filter((item) => props.match(item, next)) ?? []
+
+    if (cache.has(next) || cached.length > 0) return { items: cached, stale: false }
+
+    return { items: previous?.items ?? [], stale: !!previous?.items.length }
+  })
+
+  const animateHeight = () => store.searched && results().items.length > 0
+
+  const typeahead = createTypeahead<T>({
+    items: () => results().items,
+    key: (item) => props.key(item),
+    stale: () => results().stale,
+    onSelect: (item) => props.onSelect(item),
+  })
+
+  createEffect(() => {
+    const id = typeahead.activeID()
+
+    if (id) document.getElementById(id)?.scrollIntoView({ block: "nearest" })
+  })
+
+  return (
+    <div class="flex min-w-0 flex-col text-[13px] font-[440] leading-text-compact tracking-[-0.04px] text-v2-text-text-base">
+      <div class="flex h-8 shrink-0 items-center gap-2 ps-3 pe-2">
+        {/* The loader shares the glyph's slot and fades in only for requests slower than 150 ms. */}
+        <span
+          data-pending={pending() ? "" : undefined}
+          aria-hidden="true"
+          class="group grid size-3.5 shrink-0 place-items-center text-v2-icon-icon-muted *:[grid-area:1/1] *:transition-opacity *:duration-150 data-[pending]:*:delay-150"
+        >
+          <Icon name="magnifying-glass" size="small" class="group-data-[pending]:opacity-0" />
+          <Loader class="size-3 opacity-0 group-data-[pending]:opacity-100" />
+        </span>
+        <input
+          ref={input}
+          role="combobox"
+          aria-expanded="true"
+          aria-controls={typeahead.listID}
+          aria-autocomplete="list"
+          aria-busy={pending()}
+          aria-activedescendant={typeahead.activeID()}
+          aria-label={props.placeholder}
+          placeholder={props.placeholder}
+          value={store.query}
+          autocomplete="off"
+          spellcheck={false}
+          class="h-8 min-w-0 flex-1 outline-none placeholder:text-v2-text-text-faint"
+          onInput={(event) => setStore({ query: event.currentTarget.value, searched: true })}
+          onKeyDown={typeahead.onKeyDown}
+        />
+        <Show when={store.query}>
+          <button
+            type="button"
+            aria-label={i18n.t("ui.list.clearFilter")}
+            class="flex size-5 shrink-0 items-center justify-center rounded-sm text-v2-icon-icon-faint outline-none hover:text-v2-icon-icon-base focus-visible:text-v2-icon-icon-base"
+            onPointerDown={(event) => event.preventDefault()}
+            onClick={() => {
+              setStore("query", "")
+              input?.focus()
+            }}
+          >
+            <Icon name="circle-xmark" size="small" />
+          </button>
+        </Show>
+      </div>
+      {/* Initial results and the empty state snap into place; other search resizing animates. */}
+      <div
+        class="overflow-hidden duration-[200ms] ease-[cubic-bezier(0.645,0.045,0.355,1)] motion-reduce:transition-none"
+        classList={{ "transition-[height]": animateHeight(), "transition-none": !animateHeight() }}
+      >
+        <div
+          ref={(element) =>
+            createResizeObserver(element, (rect) =>
+              element.parentElement?.style.setProperty("height", `${rect.height}px`),
+            )
+          }
+        >
+          <div id={typeahead.listID} role="listbox" class="max-h-56 overflow-y-auto px-1 pb-1 empty:hidden">
+            <For each={results().items}>
+              {(item) => (
+                <div
+                  id={typeahead.optionID(item)}
+                  role="option"
+                  aria-selected={typeahead.activeItem() === item}
+                  aria-current={props.selected === props.key(item) ? "true" : undefined}
+                  class="flex h-7 min-w-0 cursor-default select-none items-center gap-2 rounded-sm px-2 transition-opacity duration-150 aria-selected:bg-v2-overlay-simple-overlay-hover"
+                  classList={{ "opacity-50": results().stale }}
+                  onMouseMove={(event) => {
+                    // A static cursor must not steal the active row while the keyboard scrolls the list.
+                    if (event.movementX !== 0 || event.movementY !== 0) typeahead.setActive(props.key(item))
+                  }}
+                  onMouseDown={(event) => event.preventDefault()}
+                  onClick={() => props.onSelect(item)}
+                >
+                  {props.children(item)}
+                  <Show when={props.selected === props.key(item)}>
+                    <Icon name="check" size="small" class="ms-auto shrink-0 text-v2-icon-icon-muted" />
+                  </Show>
+                </div>
+              )}
+            </For>
+          </div>
+          {/* Stays mounted while a retry or a newer query is pending, so the list never collapses to nothing. */}
+          <Show when={results().items.length === 0}>
+            <div
+              class="mx-1 flex h-8 items-center px-2 pb-1 text-v2-text-text-faint"
+              classList={{ invisible: store.answered === undefined }}
+            >
+              <Show when={failed()} fallback={props.emptyLabel}>
+                <button
+                  type="button"
+                  class="-mx-2 flex h-7 flex-1 items-center rounded-sm px-2 text-start text-v2-text-text-base outline-none hover:bg-v2-overlay-simple-overlay-hover focus-visible:bg-v2-overlay-simple-overlay-hover"
+                  onMouseDown={(event) => event.preventDefault()}
+                  onClick={() => search(query())}
+                >
+                  {props.retryLabel}
+                </button>
+              </Show>
+            </div>
+          </Show>
+        </div>
+      </div>
+    </div>
+  )
+}
