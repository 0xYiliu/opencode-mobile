+    readonly session: MountedSession
+    /** The session screen that owns the panel. */
+    readonly screen: SessionScreen
+    /** The closed tab's id. */
+    readonly id: string
+    /** What `closed` returned as `data`. */
+    readonly data?: string
+  }): void
+  /**
