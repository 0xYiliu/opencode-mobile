+          container = this.tip
+          matched = true
+          break
+        } else if (res === 2) {
+          container = this.tip
+          matchedLeaf = true
+          matched = true
+          break
+        }
+        i++
+      }
+      if (!matched) {
+        this.advanceNextNonspace()
+        break
+      }
+    }
