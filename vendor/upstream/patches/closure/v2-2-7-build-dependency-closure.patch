+          const s = this.currentLine.slice(this.nextNonspace)
+          for (let blockType = 1; blockType <= 7; blockType++) {
+            if (
+              reHtmlBlockOpen[blockType]!.test(s) &&
+              (blockType < 7 ||
+                (container.type !== "paragraph" && !(!this.allClosed && !this.blank && this.tip.type === "paragraph")))
+            ) {
