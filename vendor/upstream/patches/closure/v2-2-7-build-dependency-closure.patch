+      cclose === 0x21 /* ! */ ||
+      cclose === 0x2e /* . */ ||
+      cclose === 0x2c /* , */ ||
+      cclose === 0x3a /* : */ ||
+      cclose === C_ASTERISK ||
+      cclose === C_UNDERSCORE ||
+      cclose === C_TILDE ||
+      cclose === 0x27 /* ' */ ||
+      cclose === 0x22 /* " */
