+    const c = s.charCodeAt(j)
+    if (c === 0x5c /* \ */ && j + 1 < s.length) {
+      // a backslash is never part of a domain
+      break
+    }
+    if (c === C_UNDERSCORE) {
+      uscore2++
+    } else if (c === 0x2e /* . */) {
+      uscore1 = uscore2
+      uscore2 = 0
+      np++
+    } else if (!isAlnum(c) && c !== 0x2d /* - */ && c < 0x80) {
+      break
+    }
+  }
