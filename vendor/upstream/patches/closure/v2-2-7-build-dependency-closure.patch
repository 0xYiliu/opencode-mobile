+  if (entity.charCodeAt(1) === 0x23 /* # */) {
+    const second = entity.charCodeAt(2);
+    if (second === 0x78 || second === 0x58) {
+      const hex = entity.slice(3, -1);
+      if (hex.length >= 1 && hex.length <= 6 && /^[0-9a-fA-F]+$/.test(hex)) {
+        return decodeCodePoint(Number.parseInt(hex, 16));
+      }
+      return entity;
+    }
+    const dec = entity.slice(2, -1);
+    if (dec.length >= 1 && dec.length <= 7 && /^[0-9]+$/.test(dec)) {
+      return decodeCodePoint(Number.parseInt(dec, 10));
+    }
+    return entity;
+  }
+  const name = entity.slice(1, -1);
+  return Object.prototype.hasOwnProperty.call(HTML_ENTITIES, name) ? HTML_ENTITIES[name]! : entity;
+}
+
+export const ESCAPABLE = "[!\"#$%&'()*+,./:;<=>?@[\\\\\\]^_`{|}~-]";
+export const ENTITY_PATTERN = "&(?:#x[a-f0-9]{1,6}|#[0-9]{1,7}|[a-z][a-z0-9]{1,31});";
+const RE_BACKSLASH_OR_AMP = /[\\&]/;
+const RE_ENTITY_OR_ESCAPED = new RegExp("\\\\" + ESCAPABLE + "|" + ENTITY_PATTERN, "gi");
+
+export function unescapeString(s: string): string {
+  if (!RE_BACKSLASH_OR_AMP.test(s)) return s;
+  return s.replace(RE_ENTITY_OR_ESCAPED, (m) => {
+    if (m.charCodeAt(0) === 0x5c) return m.charAt(1);
+    return decodeEntity(m);
+  });
+}
+
+const DEFAULT_URI_CHARS = ";/?:@&=+$,-_.!~*'()#";
+const URI_ENCODE_CACHE: string[] = (() => {
+  const cache: string[] = [];
+  for (let i = 0; i < 128; i++) {
+    const ch = String.fromCharCode(i);
+    if (/^[0-9a-z]$/i.test(ch)) {
+      cache.push(ch);
+    } else {
+      cache.push("%" + ("0" + i.toString(16).toUpperCase()).slice(-2));
+    }
+  }
+  for (let i = 0; i < DEFAULT_URI_CHARS.length; i++) {
+    cache[DEFAULT_URI_CHARS.charCodeAt(i)] = DEFAULT_URI_CHARS[i]!;
+  }
+  return cache;
+})();
+
+const RE_URI_SAFE = /^[A-Za-z0-9;/?:@&=+$,\-_.!~*'()#]*$/
+
+export function normalizeURI(uri: string): string {
+  if (RE_URI_SAFE.test(uri)) return uri
+  let result = "";
+  const l = uri.length;
+  for (let i = 0; i < l; i++) {
+    const code = uri.charCodeAt(i);
+    if (code === 0x25 /* % */ && i + 2 < l && /^[0-9a-f]{2}$/i.test(uri.slice(i + 1, i + 3))) {
+      result += uri.slice(i, i + 3);
+      i += 2;
+      continue;
+    }
+    if (code < 128) {
+      result += URI_ENCODE_CACHE[code];
+      continue;
+    }
+    if (code >= 0xd800 && code <= 0xdfff) {
+      if (code <= 0xdbff && i + 1 < l) {
+        const nextCode = uri.charCodeAt(i + 1);
+        if (nextCode >= 0xdc00 && nextCode <= 0xdfff) {
+          result += encodeURIComponent(uri[i]! + uri[i + 1]!);
+          i++;
+          continue;
+        }
+      }
+      result += "%EF%BF%BD";
+      continue;
+    }
+    result += encodeURIComponent(uri[i]!);
+  }
+  return result;
+}
diff --git a/packages/patchmark/src/heal.ts b/packages/patchmark/src/heal.ts
new file mode 100644
index 0000000..bc161ed
--- /dev/null
+++ b/packages/patchmark/src/heal.ts
@@ -0,0 +1,251 @@
+// Streaming tail healing: close inline markers that are still open at the end of the block being written,
+// and hide markers that have nothing after them yet, so a half-written `**` never renders as `****` (a rule).
+
+export interface TailHeal {
+  /** Characters to remove from the end of the (right-trimmed) text */
+  strip: number
+  /** Text to append after stripping */
+  append: string
+}
+
+const reInlineDollarMath =
+  /\$\$(?!\$)((?:\\.|[^\\\n])*?(?:\\.|[^\\\n$]))\$\$|\$(?=[^\s$])((?:\\.|[^\\\n$])*?(?:\\\S|[^\s\\$]))\$(?!\w)/y
+const reInlineParenMath = /\\\(((?:\\.|[^\\\n])*?)\\\)/y
+const reLinkTail = /(!?)\[([^\]\n]*)\]\(([^)\n]*)$/
+
+function isSpace(c: number): boolean {
+  return c === 0x20 || c === 0x09 || c === 0x0a || c === 0x0d || Number.isNaN(c)
+}
+
+function isAlnum(c: number): boolean {
+  return (c >= 0x30 && c <= 0x39) || (c >= 0x41 && c <= 0x5a) || (c >= 0x61 && c <= 0x7a)
+}
+
+function rtrimLength(text: string): number {
+  let end = text.length
+  while (end > 0 && isSpace(text.charCodeAt(end - 1))) end--
+  return end
+}
+
+function compose(a: TailHeal, b: TailHeal): TailHeal {
+  if (b.strip <= a.append.length) {
+    return { strip: a.strip, append: a.append.slice(0, a.append.length - b.strip) + b.append }
+  }
+  return { strip: a.strip + (b.strip - a.append.length), append: b.append }
+}
+
+interface Open {
+  ch: number
+  len: number
+  /** index just after the opening run */
+  after: number
+  start: number
+}
+
+/**
+ * Compute the edit that heals the end of `text` (an inline run: a paragraph, heading, or table row).
+ * Offsets are relative to `text` with trailing whitespace removed.
+ */
+export function computeTailHeal(input: string): TailHeal {
+  const end = rtrimLength(input)
+  let text = input.slice(0, end)
+  if (!text) return { strip: 0, append: "" }
+
+  let heal: TailHeal = { strip: 0, append: "" }
+
+  // 1. An unfinished inline link or image at the very end: `[label](https://…` shows just the label.
+  const lastOpen = text.lastIndexOf("[")
+  if (lastOpen >= 0 && (lastOpen === 0 || text[lastOpen - 1] !== "\\")) {
+    const m = reLinkTail.exec(text.slice(lastOpen > 0 && text[lastOpen - 1] === "!" ? lastOpen - 1 : lastOpen))
+    if (m) {
+      const matchLen = m[0].length
+      const replacement = m[1] ? "" : m[2]!
+      heal = { strip: matchLen, append: replacement }
+      text = text.slice(0, text.length - matchLen) + replacement
+    }
+  }
+
+  // 2. Scan code spans, math, and emphasis delimiters.
+  const n = text.length
+  let codeOpen: { len: number; start: number } | null = null
+  let wordHadEm = false
+  const stack: Open[] = []
+  let stars = 0
+  let underscores = 0
+  let tildes = 0
+  const push = (open: Open) => {
+    if (open.ch === 0x2a) stars++
+    else if (open.ch === 0x5f) underscores++
+    else tildes++
+    stack.push(open)
+  }
+  const pop = () => {
+    const open = stack.pop()!
+    if (open.ch === 0x2a) stars--
+    else if (open.ch === 0x5f) underscores--
+    else tildes--
+  }
+  const hasOpen = (ch: number) => (ch === 0x2a ? stars : ch === 0x5f ? underscores : tildes) > 0
+  let i = 0
+  while (i < n) {
+    const c = text.charCodeAt(i)
+    if (codeOpen) {
+      if (c === 0x60) {
+        let run = 1
+        while (i + run < n && text.charCodeAt(i + run) === 0x60) run++
+        if (run === codeOpen.len) codeOpen = null
+        i += run
+      } else {
+        i++
+      }
+      continue
+    }
+    if (isSpace(c)) {
+      wordHadEm = false
+      i++
+      continue
+    }
+    if (c === 0x5c /* \ */) {
+      reInlineParenMath.lastIndex = i
+      const pm = reInlineParenMath.exec(text)
+      if (pm) {
+        i += pm[0].length
+        continue
+      }
+      i += 2
+      continue
+    }
+    if (c === 0x60 /* ` */) {
+      let run = 1
+      while (i + run < n && text.charCodeAt(i + run) === 0x60) run++
+      codeOpen = { len: run, start: i }
+      i += run
+      continue
+    }
+    if (c === 0x24 /* $ */) {
+      reInlineDollarMath.lastIndex = i
+      const mm = reInlineDollarMath.exec(text)
+      if (mm) {
+        i += mm[0].length
+        continue
+      }
+      i++
+      continue
+    }
+    if (c === 0x2a /* * */ || c === 0x5f /* _ */ || c === 0x7e /* ~ */) {
+      let run = 1
+      while (i + run < n && text.charCodeAt(i + run) === c) run++
+      const prev = i > 0 ? text.charCodeAt(i - 1) : NaN
+      const next = i + run < n ? text.charCodeAt(i + run) : NaN
+      const isUnderscore = c === 0x5f
+      const isSingleStar = c === 0x2a && run === 1
+      const canOpen =
+        !isSpace(next) &&
+        !(isUnderscore && isAlnum(prev)) &&
+        !(isSingleStar && isAlnum(prev) && !wordHadEm)
+      const canClose = !isSpace(prev) && !(isUnderscore && isAlnum(next))
+      if (c === 0x2a && (run >= 2 || canOpen)) wordHadEm = true
+      if (c === 0x7e && run > 2) {
+        i += run
+        continue
+      }
+      let remaining = run
+      if (canClose) {
+        while (remaining > 0 && stack.length > 0) {
+          if (stack[stack.length - 1]!.ch !== c) {
+            if (!hasOpen(c)) break
+            while (stack[stack.length - 1]!.ch !== c) pop()
+          }
+          const top = stack[stack.length - 1]!
+          if (top.len <= remaining) {
+            remaining -= top.len
+            pop()
+          } else {
+            top.len -= remaining
+            remaining = 0
+          }
+        }
+      }
+      if (remaining > 0 && canOpen) {
+        if (c === 0x7e) {
+          push({ ch: c, len: remaining, after: i + run, start: i + (run - remaining) })
+        } else if (remaining >= 3) {
+          push({ ch: c, len: 2, after: i + run, start: i + (run - remaining) })
+          push({ ch: c, len: 1, after: i + run, start: i + (run - remaining) + 2 })
+        } else {
+          push({ ch: c, len: remaining, after: i + run, start: i + (run - remaining) })
+        }
+      }
+      i += run
+      continue
+    }
+    i++
+  }
+
+  let strip = 0
+  let append = ""
+  let codeClosed = false
+  let nonSpaceEnd = rtrimLength(text)
+
+  if (codeOpen) {
+    if (codeOpen.start + codeOpen.len >= nonSpaceEnd) {
+      strip = n - codeOpen.start
+    } else {
+      append += "`".repeat(codeOpen.len)
+      codeClosed = true
+    }
+  }
+
+  // Close (innermost first) markers that have content after them; drop trailing markers that have none.
+  let limit = n - strip
+  if (nonSpaceEnd > limit) {
+    nonSpaceEnd = limit
+    while (nonSpaceEnd > 0 && isSpace(text.charCodeAt(nonSpaceEnd - 1))) nonSpaceEnd--
+  }
+  for (let s = stack.length - 1; s >= 0; s--) {
+    const open = stack[s]!
+    if (open.start >= limit) continue
+    if (open.after >= nonSpaceEnd) {
+      if (append === "") {
+        // dangling opener at the end: hide it (and the whitespace before it)
+        let cut = open.start
+        while (cut > 0 && (text.charCodeAt(cut - 1) === 0x20 || text.charCodeAt(cut - 1) === 0x09)) cut--
+        strip = n - cut
+        limit = cut
+        if (nonSpaceEnd > limit) {
+          nonSpaceEnd = limit
+          while (nonSpaceEnd > 0 && isSpace(text.charCodeAt(nonSpaceEnd - 1))) nonSpaceEnd--
+        }
+      }
+      continue
+    }
+    append += String.fromCharCode(open.ch).repeat(open.len)
+  }
+
+  // Closers must hug the text: drop trailing spaces before appending
+  if (append && !codeClosed) {
+    let cut = n - strip
+    while (cut > 0 && isSpace(text.charCodeAt(cut - 1))) cut--
+    strip = n - cut
+  }
+
+  return compose(heal, { strip, append })
+}
+
+export function applyTailHeal(text: string, heal: TailHeal): string {
+  if (heal.strip === 0 && heal.append === "") return text
+  const end = rtrimLength(text)
+  return text.slice(0, Math.max(0, end - heal.strip)) + heal.append
+}
+
+/**
+ * Repairs incomplete inline markers at the tail of an actively streaming block without touching closed spans.
+ * `**bold` → `**bold**`, `` `code `` → `` `code` ``, `[label](https://…` → `label`, and a trailing `**` with
+ * nothing after it yet is hidden rather than doubled.
+ */
+export function healStreamingInline(raw: string): string {
+  if (!raw) return raw
+  const heal = computeTailHeal(raw)
+  if (heal.strip === 0 && heal.append === "") return raw
+  return applyTailHeal(raw, heal)
+}
diff --git a/packages/patchmark/src/html.ts b/packages/patchmark/src/html.ts
new file mode 100644
index 0000000..8a4fec6
--- /dev/null
+++ b/packages/patchmark/src/html.ts
@@ -0,0 +1,302 @@
+import type { BlockKind, InlineNode, ListItemNode, MarkdownBlock } from "./types"
+
+export interface HtmlRenderOptions {
+  gfm?: boolean
+  math?: boolean
+}
+
+const DISALLOWED_RAW_HTML_RE =
+  /<(\/?)(iframe|noembed|noframes|plaintext|script|style|title|textarea|xmp)(?=[\t\n\f\r />])/gi
+
+export function filterDisallowedRawHtml(raw: string): string {
+  return raw.replace(DISALLOWED_RAW_HTML_RE, "&lt;$1$2")
+}
+
+export function escapeHtml(text: string): string {
+  if (!/[&<>"]/.test(text)) return text
+  return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;")
+}
+
+/** Image alt text the way commonmark.js renders it: tags suppressed, text escaped, raw HTML kept */
+function renderAlt(nodes: ReadonlyArray<InlineNode>): string {
+  let out = ""
+  for (const node of nodes) {
+    switch (node.type) {
+      case "text":
+      case "code":
+        out += escapeHtml(node.text)
+        break
+      case "strong":
+      case "em":
+      case "del":
+      case "link":
+        out += renderAlt(node.children)
+        break
+      case "image":
+        out += node.children ? renderAlt(node.children) : escapeHtml(node.alt)
+        break
+      case "math":
+        out += escapeHtml(node.source)
+        break
+      case "br":
+        out += "\n"
+        break
+      case "html_inline":
+        out += node.raw
+        break
+    }
+  }
+  return out
+}
+
+export function renderInlinesToHtml(nodes: ReadonlyArray<InlineNode>, options?: HtmlRenderOptions): string {
+  let out = ""
+  const gfm = options?.gfm ?? false
+  for (const node of nodes) {
+    switch (node.type) {
+      case "text":
+        out += escapeHtml(node.text)
+        break
+      case "strong":
+        out += `<strong>${renderInlinesToHtml(node.children, options)}</strong>`
+        break
+      case "em":
+        out += `<em>${renderInlinesToHtml(node.children, options)}</em>`
+        break
+      case "del":
+        out += `<del>${renderInlinesToHtml(node.children, options)}</del>`
+        break
+      case "code":
+        out += `<code>${escapeHtml(node.text)}</code>`
+        break
+      case "math":
+        out += `<span class="math-${node.display ? "display" : "inline"}" data-math-delimiter="${node.delimiter}">${escapeHtml(node.source)}</span>`
+        break
+      case "link": {
+        const titleAttr = node.title ? ` title="${escapeHtml(node.title)}"` : ""
+        out += `<a href="${escapeHtml(node.href)}"${titleAttr}>${renderInlinesToHtml(node.children, options)}</a>`
+        break
+      }
+      case "image": {
+        const titleAttr = node.title ? ` title="${escapeHtml(node.title)}"` : ""
+        const alt = node.children ? renderAlt(node.children) : escapeHtml(node.alt)
+        out += `<img src="${escapeHtml(node.src)}" alt="${alt}"${titleAttr} />`
+        break
+      }
+      case "html_inline":
+        out += gfm ? filterDisallowedRawHtml(node.raw) : node.raw
+        break
+      case "br":
+        out += "<br />\n"
+        break
+    }
+  }
+  return out
+}
+
+const blockHtmlCache = new WeakMap<BlockKind, { gfm: boolean; html: string }>()
+const paragraphHtmlCache = new WeakMap<BlockKind, { gfm: boolean; tight?: string; loose?: string }>()
+const rowHtmlCache = new WeakMap<InlineNode[][], { gfm: boolean; align: string; html: string }>()
+
+const CHECKED = `<input checked="" disabled="" type="checkbox"> `
+const UNCHECKED = `<input disabled="" type="checkbox"> `
+
+class HtmlWriter {
+  private parts: string[] = []
+  private lastOut = "\n"
+  constructor(readonly options: HtmlRenderOptions | undefined) {}
+
+  get buffer(): string {
+    return this.parts.join("")
+  }
+
+  out(s: string) {
+    this.parts.push(s)
+    this.lastOut = s
+  }
+
+  cr() {
+    if (this.lastOut !== "\n") this.out("\n")
+  }
+
+  block(kind: BlockKind, tight: boolean, prefix = "") {
+    const gfm = this.options?.gfm ?? false
+    if (kind.type === "paragraph") {
+      if (prefix) return this.blockUncached(kind, tight, prefix)
+      const hit = paragraphHtmlCache.get(kind)
+      const key = tight ? "tight" : "loose"
+      let html = hit?.gfm === gfm ? hit[key] : undefined
+      if (html === undefined) {
+        html = renderInlinesToHtml(kind.inlines, this.options)
+        const entry = hit?.gfm === gfm ? hit : { gfm }
+        entry[key] = html
+        paragraphHtmlCache.set(kind, entry)
+      }
+      if (tight) {
+        this.out(html)
+      } else {
+        this.cr()
+        this.out(`<p>${html}</p>`)
+        this.cr()
+      }
+      return
+    }
+    if (!tight && !prefix) {
+      // kinds of closed blocks are shared across stream frames, so their HTML is too
+      const hit = blockHtmlCache.get(kind)
+      if (hit && hit.gfm === gfm) {
+        this.cr()
+        this.out(hit.html)
+        this.lastOut = "\n"
+        return
+      }
+      const sub = new HtmlWriter(this.options)
+      sub.blockUncached(kind, false, "")
+      const html = sub.buffer
+      blockHtmlCache.set(kind, { gfm, html })
+      this.cr()
+      this.out(html)
+      this.lastOut = "\n"
+      return
+    }
+    this.blockUncached(kind, tight, prefix)
+  }
+
+  blockUncached(kind: BlockKind, tight: boolean, prefix: string) {
+    const gfm = this.options?.gfm ?? false
+    switch (kind.type) {
+      case "paragraph":
+        if (tight) {
+          this.out(prefix + renderInlinesToHtml(kind.inlines, this.options))
+        } else {
+          this.cr()
+          this.out(`<p>${prefix}${renderInlinesToHtml(kind.inlines, this.options)}</p>`)
+          this.cr()
+        }
+        return
+      case "heading":
+        this.cr()
+        this.out(`<h${kind.level}>${renderInlinesToHtml(kind.inlines, this.options)}</h${kind.level}>`)
+        this.cr()
+        return
+      case "code": {
+        let cls = ""
+        if (kind.language) {
+          const escaped = escapeHtml(kind.language)
+          cls = ` class="${escaped.startsWith("language-") ? escaped : `language-${escaped}`}"`
+        }
+        const defaultBody = kind.source ? (kind.source.endsWith("\n") && !kind.complete ? kind.source : `${kind.source}\n`) : ""
+        const body = kind.htmlLiteral !== undefined ? kind.htmlLiteral : defaultBody
+        this.cr()
+        this.out(`<pre><code${cls}>${escapeHtml(body)}</code></pre>`)
+        this.cr()
+        return
+      }
+      case "mermaid": {
+        const defaultBody = kind.source ? (kind.source.endsWith("\n") && !kind.complete ? kind.source : `${kind.source}\n`) : ""
+        const body = kind.htmlLiteral !== undefined ? kind.htmlLiteral : defaultBody
+        this.cr()
+        this.out(`<pre><code class="language-mermaid">${escapeHtml(body)}</code></pre>`)
+        this.cr()
+        return
+      }
+      case "math":
+        this.cr()
+        this.out(`<div class="math-block" data-math-delimiter="${kind.delimiter}">${escapeHtml(kind.source)}</div>`)
+        this.cr()
+        return
+      case "blockquote":
+        this.cr()
+        this.out("<blockquote>")
+        this.cr()
+        for (const child of kind.blocks) this.block(child, false)
+        this.cr()
+        this.out("</blockquote>")
+        this.cr()
+        return
+      case "list": {
+        const tag = kind.ordered ? "ol" : "ul"
+        const startAttr = kind.ordered && kind.start !== undefined && kind.start !== 1 ? ` start="${kind.start}"` : ""
+        this.cr()
+        this.out(`<${tag}${startAttr}>`)
+        this.cr()
+        for (const item of kind.items) this.item(item, kind.tight)
+        this.cr()
+        this.out(`</${tag}>`)
+        this.cr()
+        return
+      }
+      case "table": {
+        this.cr()
+        let out = "<table>\n<thead>\n<tr>\n"
+        for (let c = 0; c < kind.headers.length; c++) {
+          const align = kind.align[c]
+          out += `<th${align ? ` align="${align}"` : ""}>${renderInlinesToHtml(kind.headers[c]!, this.options)}</th>\n`
+        }
+        out += "</tr>\n</thead>\n"
+        if (kind.rows.length > 0) {
+          out += "<tbody>\n"
+          const alignKey = kind.align.join(",") + ":" + kind.headers.length
+          for (const row of kind.rows) {
+            const hit = rowHtmlCache.get(row)
+            if (hit && hit.gfm === gfm && hit.align === alignKey) {
+              out += hit.html
+              continue
+            }
+            let rowHtml = "<tr>\n"
+            for (let c = 0; c < kind.headers.length; c++) {
+              const align = kind.align[c]
+              rowHtml += `<td${align ? ` align="${align}"` : ""}>${renderInlinesToHtml(row[c] ?? [], this.options)}</td>\n`
+            }
+            rowHtml += "</tr>\n"
+            rowHtmlCache.set(row, { gfm, align: alignKey, html: rowHtml })
+            out += rowHtml
+          }
+          out += "</tbody>\n"
+        }
+        out += "</table>"
+        this.out(out)
+        this.cr()
+        return
+      }
+      case "html_block":
+        this.cr()
+        this.out(gfm ? filterDisallowedRawHtml(kind.raw) : kind.raw)
+        this.cr()
+        return
+      case "hr":
+        this.cr()
+        this.out("<hr />")
+        this.cr()
+        return
+      case "group":
+        for (const child of kind.blocks) this.block(child, false)
+        return
+    }
+  }
+
+  item(item: ListItemNode, tight: boolean) {
+    const checkbox = item.checked === true ? CHECKED : item.checked === false ? UNCHECKED : ""
+    this.out("<li>")
+    for (let i = 0; i < item.blocks.length; i++) {
+      this.block(item.blocks[i]!, tight, i === 0 ? checkbox : "")
+    }
+    if (item.blocks.length === 0 && checkbox) this.out(checkbox.trimEnd())
+    this.out("</li>")
+    this.cr()
+  }
+}
+
+export function renderBlockKindToHtml(kind: BlockKind, options?: HtmlRenderOptions): string {
+  const writer = new HtmlWriter(options)
+  writer.block(kind, false)
+  return writer.buffer
+}
+
+export function renderBlocksToHtml(blocks: ReadonlyArray<MarkdownBlock>, options?: HtmlRenderOptions): string {
+  let out = ""
+  for (const b of blocks) {
+    out += options ? renderBlockKindToHtml(b.kind, options) : (b.html ?? renderBlockKindToHtml(b.kind))
+  }
+  return out
+}
