+    if (!this.allClosed && !this.blank && this.tip.type === "paragraph") {
+      this.tip.lastLineCannotHeadTable = this.indented
+      this.addLine()
+    } else {
+      this.closeUnmatchedBlocks()
+      const t = container.type
