<?xml version="1.0" encoding="utf-8"?>
<network-security-config>

    <!-- HTTP endpoints are permitted, but send credentials and data without transport
         encryption. HTTPS continues to trust system CAs only. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>
