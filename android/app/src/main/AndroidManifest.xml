<?xml version="1.0" encoding="utf-8"?>
<!-- enableOnBackInvokedCallback="false": Android 16 turns predictive back ON by default for
     targetSdk >= 36 apps, which would stop onBackPressed from being called. Revisit only
     together with an OnBackInvokedCallback migration guarded by a minSdk check (API 33+). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Issue #23 notifications: runtime permission on API 33+ (requested in-app from the
         settings face, user-in-foreground only); API 29-32 needs no prompt, channels only. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Issue #71 pairing QR scan: WebView getUserMedia for the shared PairingScanner.
         Runtime-granted in-app ONLY via WebChromeClient.onPermissionRequest, for the exact
         loopback shell origin and the video-capture resource only (audio is never granted,
         RECORD_AUDIO stays undeclared); denial/no-camera paths surface through the page's
         own scanner error/hint faces. Camera frames never leave the page: no bridge, no
         capture, zero-value logging. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="false"
        android:fullBackupContent="@xml/full_backup_content"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.OpenCodeMobile"
        android:usesCleartextTraffic="true">

        <!-- Launcher activity only; deep links are not implemented (TODO in MainActivity). -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Issue #16 share face: minimal read-only provider for the cacheDir/share/
             staging tree. exported=false + grantUriPermissions=true: a staged URI is
             handed only through the ACTION_SEND chooser with FLAG_GRANT_READ_URI_PERMISSION
             (set on BOTH the send and the chooser intent); nothing else can reach it. Zero
             new permissions are introduced by this file. -->
        <provider
            android:name=".files.ShareFileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
